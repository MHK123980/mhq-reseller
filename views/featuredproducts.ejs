<section class="py-24 px-4 max-w-7xl mx-auto">
  <div class="mb-8">
    <div class="inline-block border border-amber-500/40 bg-amber-500/10 text-amber-400 text-xs font-semibold px-4 py-1.5 rounded-full mb-4 tracking-widest uppercase">⭐ Hand-Picked</div>
    <h1 class="text-3xl md:text-4xl font-bold text-white mb-2 font-serif">Featured <span class="text-amber-400">Products</span></h1>
    <p class="text-zinc-500">Our top-rated and most popular items — updated in real-time</p>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4" id="featured-grid">
    <% products.forEach(p => { %>
    <div class="product-card rounded-2xl overflow-hidden cursor-pointer group"
         onclick="window.location='/product/<%= p._id %>'"
         data-id="<%= p._id %>">
      <div class="relative aspect-square overflow-hidden bg-zinc-800">
        <% if (p.images && p.images.length > 0) { %>
        <img src="<%= p.images[0] %>" alt="<%= p.name %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy"/>
        <% } else { %>
        <div class="w-full h-full flex items-center justify-center text-zinc-600">
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
        <% } %>
        <div class="absolute top-2 left-2 flex flex-col gap-1 items-start z-10">
          <span class="bg-amber-500 text-black text-[10px] sm:text-xs px-2 py-0.5 rounded-full font-bold shadow-md">⭐ Featured</span>
          <% if (p.isOutOfStock) { %>
          <span class="bg-red-600/95 text-white text-[10px] sm:text-xs px-2 py-0.5 rounded-full font-bold shadow-md">Out of Stock</span>
          <% } %>
        </div>
        <% if (p.hasDiscount && p.discountPercent > 0) { %>
        <div class="absolute top-2 right-2 bg-red-500 text-white text-[10px] sm:text-xs px-2 py-0.5 rounded-full font-bold shadow-md z-10"><%= p.discountPercent %>% OFF</div>
        <% } %>
      </div>
      <div class="p-3">
        <p class="text-xs text-amber-500/70 font-medium mb-1 truncate"><%= p.category ? p.category.name : 'Uncategorized' %></p>
        <h3 class="text-sm font-semibold text-white line-clamp-2 mb-2 leading-tight"><%= p.name %></h3>
        <div class="flex items-center justify-between gap-2">
          <div class="min-w-0">
            <% if (p.hasDiscount && p.discountedPrice > 0) { %>
            <p class="text-amber-400 font-bold text-sm">Rs <%= p.discountedPrice %></p>
            <p class="text-zinc-600 text-xs line-through">Rs <%= p.price %></p>
            <% } else { %>
            <p class="text-amber-400 font-bold text-sm">Rs <%= p.price %></p>
            <% } %>
          </div>
          <button onclick="event.stopPropagation(); addToCartFromCard('<%= p._id %>', '<%= p.name.replace(/'/g, "\\'") %>', <%= p.hasDiscount && p.discountedPrice > 0 ? p.discountedPrice : p.price %>, '<%= p.images && p.images.length > 0 ? p.images[0] : "" %>', <%= p.deliveryCharges || 0 %>, <%= p.isFreeDelivery ? 'true' : 'false' %>)"
            class="bg-amber-600 hover:bg-amber-500 text-white text-xs px-3 py-1.5 rounded-full transition-all font-semibold flex-shrink-0 <%= p.isOutOfStock ? 'opacity-50 cursor-not-allowed' : '' %>"
            <%= p.isOutOfStock ? 'disabled' : '' %>>Add</button>
        </div>
        <% if (p.isFreeDelivery) { %><p class="text-emerald-400 text-xs mt-1.5 font-medium">✓ Free Delivery</p>
        <% } else if (p.deliveryCharges > 0) { %><p class="text-zinc-600 text-xs mt-1.5">Delivery: Rs <%= p.deliveryCharges %></p><% } %>
      </div>
    </div>
    <% }) %>
    <% if (products.length === 0) { %>
    <div class="col-span-4 text-center py-20 text-zinc-500">No featured products yet.</div>
    <% } %>
  </div>
</section>

<div id="cart-toast" class="fixed bottom-6 right-6 bg-amber-600 text-white px-5 py-3 rounded-xl shadow-2xl font-medium text-sm z-50 translate-y-20 opacity-0 transition-all duration-300">✓ Added to cart!</div>

<script>
function addToCartFromCard(id, name, price, image, deliveryCharges, isFreeDelivery) {
  const cart = JSON.parse(localStorage.getItem('mhq_cart') || '[]');
  const existing = cart.find(i => i.id === id);
  if (existing) existing.quantity += 1;
  else cart.push({ id, name, price: parseFloat(price), image, quantity: 1, deliveryCharges: deliveryCharges || 0, isFreeDelivery: isFreeDelivery || false });
  localStorage.setItem('mhq_cart', JSON.stringify(cart));
  updateCartCount();
  const toast = document.getElementById('cart-toast');
  toast.classList.remove('translate-y-20','opacity-0'); toast.classList.add('translate-y-0','opacity-100');
  setTimeout(() => { toast.classList.add('translate-y-20','opacity-0'); toast.classList.remove('translate-y-0','opacity-100'); }, 2000);
}
</script>

<script src="https://js.pusher.com/8.2.0/pusher.min.js"></script>
<script>
const pusher = new Pusher('<%= pusherKey %>', { cluster: '<%= pusherCluster %>' });
const channel = pusher.subscribe('mhq-reseller');

function buildFeaturedCard(p) {
  const price = p.hasDiscount && p.discountedPrice > 0 ? p.discountedPrice : p.price;
  const img = p.images && p.images.length ? p.images[0] : '';
  const catName = p.category ? (p.category.name || '') : '';
  const discBadge = p.hasDiscount && p.discountPercent > 0 ? `<div class="absolute top-2 right-2 bg-red-500 text-white text-xs px-2 py-0.5 rounded-full font-bold">${p.discountPercent}% OFF</div>` : '';
  const imgEl = img ? `<img src="${img}" alt="${p.name}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy"/>` : `<div class="w-full h-full flex items-center justify-center text-zinc-600"><svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div>`;
  const oosDiv = p.isOutOfStock ? `<div class="absolute bottom-2 left-2 bg-red-600/90 text-white text-xs px-2 py-0.5 rounded-full font-semibold">Out of Stock</div>` : '';
  const priceHtml = p.hasDiscount && p.discountedPrice > 0
    ? `<p class="text-amber-400 font-bold text-sm">Rs ${p.discountedPrice}</p><p class="text-zinc-600 text-xs line-through">Rs ${p.price}</p>`
    : `<p class="text-amber-400 font-bold text-sm">Rs ${p.price}</p>`;
  const freeDelivery = p.isFreeDelivery ? `<p class="text-emerald-400 text-xs mt-1.5 font-medium">✓ Free Delivery</p>` : (p.deliveryCharges > 0 ? `<p class="text-zinc-600 text-xs mt-1.5">Delivery: Rs ${p.deliveryCharges}</p>` : '');
  return `<div class="product-card rounded-2xl overflow-hidden cursor-pointer group" onclick="window.location='/product/${p._id}'" data-id="${p._id}">
    <div class="relative aspect-square overflow-hidden bg-zinc-800">
      ${imgEl}
      <div class="absolute top-2 left-2 bg-amber-500 text-black text-xs px-2 py-0.5 rounded-full font-bold shadow">⭐ Featured</div>
      ${oosDiv}${discBadge}
    </div>
    <div class="p-3">
      <p class="text-xs text-amber-500/70 font-medium mb-1 truncate">${catName}</p>
      <h3 class="text-sm font-semibold text-white line-clamp-2 mb-2 leading-tight">${p.name}</h3>
      <div class="flex items-center justify-between gap-2">
        <div class="min-w-0">${priceHtml}</div>
        <button onclick="event.stopPropagation(); addToCartFromCard('${p._id}', '${(p.name||'').replace(/'/g,"\\'")}', ${price}, '${img}', ${p.deliveryCharges||0}, ${p.isFreeDelivery?'true':'false'})"
          class="bg-amber-600 hover:bg-amber-500 text-white text-xs px-3 py-1.5 rounded-full transition-all font-semibold flex-shrink-0 ${p.isOutOfStock ? 'opacity-50 cursor-not-allowed' : ''}"
          ${p.isOutOfStock ? 'disabled' : ''}>Add</button>
      </div>
      ${freeDelivery}
    </div>
  </div>`;
}

channel.bind('product:new', (p) => {
  if (!p.isFeatured) return;
  const grid = document.getElementById('featured-grid');
  const empty = grid.querySelector('.col-span-4');
  if (empty) empty.remove();
  grid.insertAdjacentHTML('afterbegin', buildFeaturedCard(p));
});

channel.bind('product:updated', (p) => {
  const existing = document.querySelector(`[data-id="${p._id}"]`);
  if (p.isFeatured) {
    if (existing) {
      existing.outerHTML = buildFeaturedCard(p);
    } else {
      const grid = document.getElementById('featured-grid');
      grid.insertAdjacentHTML('afterbegin', buildFeaturedCard(p));
    }
  } else {
    if (existing) existing.remove();
  }
});

channel.bind('product:deleted', ({ id }) => {
  const card = document.querySelector(`[data-id="${id}"]`);
  if (card) card.remove();
});
</script>
