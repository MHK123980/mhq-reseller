  <!-- Scripts -->
  <script src="/js/cart.js"></script>
  <script src="/js/main.js"></script>
  <script>
    // --- Animated Delivery Loader Control ---
    let _loaderDismissed = false;
    const siteLoader = document.getElementById('site-loader');
    const loaderBar = document.getElementById('loader-bar');

    // Smoothly progress loader bar
    if (loaderBar) {
      setTimeout(() => { if (loaderBar) loaderBar.style.width = '60%'; }, 150);
      setTimeout(() => { if (loaderBar) loaderBar.style.width = '85%'; }, 900);
    }

    function dismissLoader(fast = false) {
      if (_loaderDismissed || !siteLoader) return;
      _loaderDismissed = true;
      if (loaderBar) loaderBar.style.width = '100%';
      
      if (fast) {
        siteLoader.classList.add('fast-mode');
      }

      setTimeout(() => {
        siteLoader.style.opacity = '0';
        siteLoader.style.pointerEvents = 'none';
        setTimeout(() => {
          if (siteLoader.parentNode) siteLoader.style.display = 'none';
        }, 320);
      }, fast ? 200 : 350);
    }

    // Hard ceiling: Guaranteed finish within 3.0 seconds max
    const hardTimeout = setTimeout(() => {
      dismissLoader(true);
    }, 3000);

    // Accelerate to 2x fast-mode and finish when page resources ready
    window.addEventListener('load', () => {
      dismissLoader(true);
    });

    // --- Mobile Sidebar Drawer Handlers ---
    function openMobileSidebar() {
      const sidebar = document.getElementById('mobile-sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      if (!sidebar || !backdrop) return;
      backdrop.classList.remove('hidden');
      requestAnimationFrame(() => {
        sidebar.classList.remove('translate-x-full');
      });
      document.body.style.overflow = 'hidden';
    }

    function closeMobileSidebar() {
      const sidebar = document.getElementById('mobile-sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      if (!sidebar || !backdrop) return;
      sidebar.classList.add('translate-x-full');
      setTimeout(() => {
        backdrop.classList.add('hidden');
      }, 300);
      document.body.style.overflow = '';
    }

    function toggleMobileCategories() {
      const drop = document.getElementById('mob-categories-dropdown');
      const arrow = document.getElementById('mob-cat-arrow');
      if (!drop) return;
      const isHidden = drop.classList.contains('hidden');
      if (isHidden) {
        drop.classList.remove('hidden');
        if (arrow) arrow.style.transform = 'rotate(180deg)';
      } else {
        drop.classList.add('hidden');
        if (arrow) arrow.style.transform = 'rotate(0deg)';
      }
    }

    function filterMobileCatList(val) {
      const query = (val || '').toLowerCase().trim();
      document.querySelectorAll('#mob-categories-list .mob-cat-item').forEach(el => {
        const name = el.getAttribute('data-name');
        if (!name) return;
        el.style.display = name.includes(query) ? 'block' : 'none';
      });
    }

    // --- Search Overlay Handlers ---
    let _searchProducts = null;
    let _searchTimer = null;

    function openSearch() {
      const overlay = document.getElementById('search-overlay');
      if (!overlay) return;
      overlay.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        const inp = document.getElementById('search-input');
        if (inp) {
          inp.focus();
          inp.select();
        }
      }, 50);
      loadSearchProducts();
    }

    function closeSearch() {
      const overlay = document.getElementById('search-overlay');
      if (!overlay) return;
      overlay.classList.add('hidden');
      document.body.style.overflow = '';
      const inp = document.getElementById('search-input');
      if (inp) inp.value = '';
      const results = document.getElementById('search-results');
      if (results) results.innerHTML = '';
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeSearch();
    });

    async function loadSearchProducts() {
      if (_searchProducts && _searchProducts.length) return _searchProducts;
      try {
        const res = await fetch('/api/products');
        _searchProducts = await res.json();
        return _searchProducts;
      } catch { return []; }
    }

    if (typeof window !== 'undefined') {
      window.addEventListener('load', () => {
        setTimeout(loadSearchProducts, 1000);
      });
    }

    function handleSearchKey(e) {
      if (e.key === 'Enter') {
        const q = document.getElementById('search-input').value.trim();
        if (q) {
          closeSearch();
          window.location = '/products?search=' + encodeURIComponent(q);
        }
      }
    }

    function handleSearch(q) {
      clearTimeout(_searchTimer);
      const results = document.getElementById('search-results');
      const query = (q || '').trim().toLowerCase();
      if (!query) {
        results.innerHTML = '';
        return;
      }
      
      _searchTimer = setTimeout(async () => {
        const products = await loadSearchProducts();
        const filtered = (products || []).filter(p =>
          (p.name && p.name.toLowerCase().includes(query)) ||
          (p.category && p.category.name && p.category.name.toLowerCase().includes(query))
        ).slice(0, 8);

        if (filtered.length === 0) {
          results.innerHTML = `<div class="text-center py-8 text-zinc-500 text-xs sm:text-sm">No products found for <span class="text-amber-400 font-semibold">"${q}"</span></div>`;
          return;
        }

        const cards = filtered.map(p => {
          const price = p.hasDiscount && p.discountedPrice > 0 ? p.discountedPrice : p.price;
          const img = p.images && p.images.length ? p.images[0] : '';
          const catName = p.category ? (p.category.name || '') : '';
          const discBadge = p.hasDiscount && p.discountPercent > 0
            ? `<span class="text-[9px] bg-amber-500 text-black font-black px-1.5 py-0.5 rounded-full ml-2 align-middle">${p.discountPercent}% OFF</span>` : '';
          const imgEl = img
            ? `<img src="${img}" alt="${p.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy"/>`
            : `<div class="w-full h-full flex items-center justify-center text-zinc-700"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div>`;
          return `<a href="/product/${p._id}" onclick="closeSearch()" class="flex items-center gap-3 sm:gap-4 p-2.5 sm:p-3 rounded-xl bg-zinc-900/90 border border-zinc-800 hover:border-amber-500/50 hover:bg-zinc-800 transition-all group cursor-pointer">
            <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl overflow-hidden bg-zinc-800 flex-shrink-0 border border-zinc-700/50">${imgEl}</div>
            <div class="flex-1 min-w-0">
              <p class="text-white font-medium text-xs sm:text-sm leading-tight truncate">${p.name}${discBadge}</p>
              <p class="text-zinc-500 text-[11px] mt-0.5 truncate">${catName}</p>
              ${p.isOutOfStock ? '<p class="text-red-400 text-[10px] mt-0.5 font-bold">Out of Stock</p>' : ''}
            </div>
            <div class="text-right flex-shrink-0">
              <p class="text-amber-400 font-bold text-xs sm:text-sm">Rs ${Number(price).toLocaleString()}</p>
              ${p.hasDiscount && p.discountedPrice > 0 ? `<p class="text-zinc-500 text-[10px] line-through">Rs ${Number(p.price).toLocaleString()}</p>` : ''}
            </div>
          </a>`;
        }).join('');

        const showMore = filtered.length >= 7
          ? `<div class="text-center pt-2 pb-1"><a href="/products?search=${encodeURIComponent(q)}" onclick="closeSearch()" class="inline-flex items-center gap-1.5 text-amber-400 hover:text-amber-300 text-xs sm:text-sm font-semibold transition-colors">View all results <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a></div>` : '';
        results.innerHTML = cards + showMore;
      }, 70);
    }

    // Attach explicit click listener for all search openers
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('[data-action="open-search"]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          openSearch();
        });
      });
      const mBtn = document.getElementById('menu-btn');
      if (mBtn) {
        mBtn.addEventListener('click', (e) => {
          e.preventDefault();
          openMobileSidebar();
        });
      }
    });
  </script>
  <%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>
