<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'MHQ Reseller' %></title>
  <meta name="description" content="MHQ Reseller - Quality products at the best prices. Shop now for amazing deals." />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            amber: { 400:'#fbbf24', 500:'#f59e0b', 600:'#d97706', 700:'#b45309' },
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="min-h-screen text-white font-sans">
  <!-- Background -->
  <div class="fixed inset-0 -z-10 bg-black">
    <div class="absolute inset-0 bg-gradient-to-br from-zinc-950 via-zinc-900 to-black opacity-95"></div>
  </div>

  <!-- Navbar -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-black/80 backdrop-blur-md border-b border-amber-600/30">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="text-xl md:text-2xl font-bold text-amber-500" style="font-family:'Times New Roman',serif;">
        MHQ Reseller
      </a>
      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-6">
        <a href="/" class="text-zinc-300 hover:text-amber-400 transition-colors text-sm">Home</a>
        <a href="/products" class="text-zinc-300 hover:text-amber-400 transition-colors text-sm">Products</a>
        <a href="/featuredproducts" class="text-zinc-300 hover:text-amber-400 transition-colors text-sm">Featured</a>
        <a href="/cart" class="relative flex items-center gap-1.5 bg-amber-600 hover:bg-amber-500 text-white px-4 py-2 rounded-full text-sm font-medium transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          Cart <span id="cart-count" class="bg-white text-amber-700 text-xs font-bold px-1.5 py-0.5 rounded-full">0</span>
        </a>
      </div>
      <!-- Mobile hamburger -->
      <div class="flex items-center gap-3 md:hidden">
        <a href="/cart" class="relative flex items-center gap-1 bg-amber-600 text-white px-3 py-2 rounded-full text-sm font-medium">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          <span id="cart-count-mobile" class="bg-white text-amber-700 text-xs font-bold px-1 rounded-full">0</span>
        </a>
        <button id="menu-btn" class="text-white p-2 rounded-lg hover:bg-zinc-800 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden bg-black/95 border-t border-zinc-800 px-4 py-4 flex flex-col gap-3">
      <a href="/" class="text-zinc-300 hover:text-amber-400 transition-colors py-2 border-b border-zinc-800">Home</a>
      <a href="/products" class="text-zinc-300 hover:text-amber-400 transition-colors py-2 border-b border-zinc-800">Products</a>
      <a href="/featuredproducts" class="text-zinc-300 hover:text-amber-400 transition-colors py-2">Featured Products</a>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="pt-16">
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="mt-20 border-t border-zinc-800 py-8 text-center text-zinc-500 text-sm">
    <p class="text-amber-500 font-semibold text-base mb-1" style="font-family:'Times New Roman',serif;">MHQ Reseller</p>
    <p>Quality Products • Best Prices • Fast Delivery</p>
    <p class="mt-2">© 2025 MHQ Reseller. All rights reserved.</p>
  </footer>

  <!-- Scripts -->
  <script src="/js/cart.js"></script>
  <script src="/js/main.js"></script>
  <%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>
