<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'MHQ Admin' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="bg-zinc-950 text-white min-h-screen font-sans">

  <% if (typeof user !== 'undefined' && user) { %>
  <!-- Admin Layout with Sidebar -->
  <div class="flex min-h-screen">

    <!-- Sidebar Desktop -->
    <aside id="sidebar" class="hidden md:flex flex-col w-64 bg-black border-r border-zinc-800 fixed h-full z-30">
      <div class="p-5 border-b border-zinc-800">
        <a href="/" class="text-xl font-bold text-amber-500" style="font-family:'Times New Roman',serif;">MHQ Reseller</a>
        <p class="text-xs text-zinc-500 mt-1">Admin Panel</p>
      </div>
      <nav class="flex-1 p-4 space-y-1">
        <a href="/admin/dashboard" class="admin-nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all hover:bg-amber-600/20 hover:text-amber-400 text-zinc-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          Dashboard
        </a>
        <a href="/admin/dashboard/products" class="admin-nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all hover:bg-amber-600/20 hover:text-amber-400 text-zinc-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          Products
        </a>
        <a href="/admin/dashboard/categories" class="admin-nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all hover:bg-amber-600/20 hover:text-amber-400 text-zinc-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-5 5a2 2 0 01-2.828 0l-7-7A2 2 0 013 9.586V5a2 2 0 012-2z"/></svg>
          Categories
        </a>
        <a href="/admin/dashboard/orders" class="admin-nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all hover:bg-amber-600/20 hover:text-amber-400 text-zinc-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          Orders
          <span id="pending-badge" class="ml-auto bg-amber-500 text-black text-xs font-bold px-2 py-0.5 rounded-full hidden">0</span>
        </a>
        <a href="/admin/dashboard/users" class="admin-nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all hover:bg-amber-600/20 hover:text-amber-400 text-zinc-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          Users
        </a>
        <a href="/admin/dashboard/settings" class="admin-nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all hover:bg-amber-600/20 hover:text-amber-400 text-zinc-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Settings
        </a>
      </nav>
      <div class="p-4 border-t border-zinc-800">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-9 h-9 bg-amber-600 rounded-full flex items-center justify-center text-sm font-bold">
            <%= user.name ? user.name.charAt(0).toUpperCase() : 'A' %>
          </div>
          <div>
            <p class="text-sm font-medium text-white"><%= user.name %></p>
            <p class="text-xs text-zinc-500"><%= user.role %></p>
          </div>
        </div>
        <a href="/api/auth/logout" class="w-full flex items-center gap-2 px-3 py-2 bg-zinc-800 hover:bg-red-900/40 text-zinc-400 hover:text-red-400 rounded-lg text-sm transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          Logout
        </a>
      </div>
    </aside>

    <!-- Mobile Header -->
    <div class="md:hidden fixed top-0 left-0 right-0 z-50 bg-black border-b border-zinc-800 flex items-center justify-between px-4 py-3">
      <a href="/" class="text-lg font-bold text-amber-500" style="font-family:'Times New Roman',serif;">MHQ Admin</a>
      <button id="mob-menu-btn" class="text-white p-2 rounded-lg hover:bg-zinc-800">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>

    <!-- Mobile Drawer -->
    <div id="mob-drawer" class="md:hidden fixed inset-0 z-40 hidden">
      <div class="absolute inset-0 bg-black/70" id="mob-overlay"></div>
      <aside class="absolute left-0 top-0 h-full w-72 bg-zinc-950 border-r border-zinc-800 flex flex-col">
        <div class="p-5 border-b border-zinc-800 flex items-center justify-between">
          <a href="/" class="text-xl font-bold text-amber-500" style="font-family:'Times New Roman',serif;">MHQ Reseller</a>
          <button id="close-drawer" class="text-zinc-400 hover:text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <nav class="flex-1 p-4 space-y-1">
          <a href="/admin/dashboard" class="admin-nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all hover:bg-amber-600/20 hover:text-amber-400 text-zinc-400">Dashboard</a>
          <a href="/admin/dashboard/products" class="admin-nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all hover:bg-amber-600/20 hover:text-amber-400 text-zinc-400">Products</a>
          <a href="/admin/dashboard/categories" class="admin-nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all hover:bg-amber-600/20 hover:text-amber-400 text-zinc-400">Categories</a>
          <a href="/admin/dashboard/orders" class="admin-nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all hover:bg-amber-600/20 hover:text-amber-400 text-zinc-400">Orders</a>
          <a href="/admin/dashboard/users" class="admin-nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all hover:bg-amber-600/20 hover:text-amber-400 text-zinc-400">Users</a>
        </nav>
        <div class="p-4 border-t border-zinc-800">
          <p class="text-sm font-medium text-white"><%= user.name %> (<%= user.role %>)</p>
          <a href="/api/auth/logout" class="mt-2 w-full flex items-center gap-2 px-3 py-2 bg-zinc-800 hover:bg-red-900/40 text-zinc-400 hover:text-red-400 rounded-lg text-sm transition-all">Logout</a>
        </div>
      </aside>
    </div>

    <!-- Main Content -->
    <div class="flex-1 md:ml-64 pt-16 md:pt-0">
      <%- body %>
    </div>
  </div>

  <% } else { %>
    <%- body %>
  <% } %>

  <script>
    // Active sidebar link highlight
    document.querySelectorAll('.admin-nav-link').forEach(link => {
      if (link.href === window.location.href) {
        link.classList.add('bg-amber-600/20','text-amber-400');
        link.classList.remove('text-zinc-400');
      }
    });
    // Mobile drawer
    const mobBtn = document.getElementById('mob-menu-btn');
    const mobDrawer = document.getElementById('mob-drawer');
    const mobOverlay = document.getElementById('mob-overlay');
    const closeDrawer = document.getElementById('close-drawer');
    if(mobBtn) mobBtn.addEventListener('click', () => mobDrawer.classList.remove('hidden'));
    if(mobOverlay) mobOverlay.addEventListener('click', () => mobDrawer.classList.add('hidden'));
    if(closeDrawer) closeDrawer.addEventListener('click', () => mobDrawer.classList.add('hidden'));
  </script>
  <%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>
