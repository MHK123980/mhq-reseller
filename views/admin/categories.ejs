<div class="p-6 max-w-5xl mx-auto">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
    <div>
      <h1 class="text-2xl font-bold text-white mb-1">Categories Management</h1>
      <p class="text-zinc-400 text-sm">Organize products into categories</p>
    </div>
    <button onclick="openModal('add')" class="bg-amber-600 hover:bg-amber-500 text-white font-medium px-5 py-2.5 rounded-xl transition-colors flex items-center gap-2 text-sm">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Add Category
    </button>
  </div>

  <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-zinc-800 bg-black/20 text-xs uppercase tracking-wider text-zinc-500">
            <th class="p-4 font-semibold">Category Name</th>
            <th class="p-4 font-semibold hidden md:table-cell">Description</th>
            <th class="p-4 font-semibold w-24">Actions</th>
          </tr>
        </thead>
        <tbody class="text-sm divide-y divide-zinc-800/50">
          <% categories.forEach(c => { %>
          <tr class="hover:bg-zinc-800/50 transition-colors group">
            <td class="p-4 font-medium text-white"><%= c.name %></td>
            <td class="p-4 text-zinc-400 hidden md:table-cell"><%= c.description || '-' %></td>
            <td class="p-4">
              <div class="flex items-center gap-2">
                <button onclick="openModal('edit', '<%= JSON.stringify(c).replace(/'/g, "&#39;").replace(/\\/g, "\\\\") %>')" class="p-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white rounded-lg transition-colors" title="Edit">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                </button>
                <button onclick="deleteCategory('<%= c._id %>')" class="p-2 bg-red-900/20 hover:bg-red-900/40 text-red-400 hover:text-red-300 rounded-lg transition-colors" title="Delete">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
              </div>
            </td>
          </tr>
          <% }) %>
          <% if(categories.length === 0) { %>
          <tr><td colspan="3" class="p-8 text-center text-zinc-500">No categories found.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal -->
<div id="category-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
  <div class="bg-zinc-950 border border-zinc-700 rounded-2xl w-full max-w-md p-6">
    <div class="flex items-center justify-between mb-6">
      <h2 id="modal-title" class="text-xl font-bold text-white">Add Category</h2>
      <button onclick="closeModal()" class="text-zinc-400 hover:text-white transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="category-form" onsubmit="saveCategory(event)" class="space-y-4">
      <input type="hidden" id="c-id" />
      <div>
        <label class="block text-sm text-zinc-400 mb-1">Name *</label>
        <input type="text" id="c-name" required class="w-full bg-zinc-900 border border-zinc-700 focus:border-amber-500 text-white rounded-xl px-4 py-3 text-sm outline-none transition-colors" placeholder="e.g. Electronics" />
      </div>
      <div>
        <label class="block text-sm text-zinc-400 mb-1">Description</label>
        <textarea id="c-desc" rows="3" class="w-full bg-zinc-900 border border-zinc-700 focus:border-amber-500 text-white rounded-xl px-4 py-3 text-sm outline-none transition-colors" placeholder="Optional description..."></textarea>
      </div>

      <div class="pt-4 flex justify-end gap-3">
        <button type="button" onclick="closeModal()" class="px-5 py-2.5 rounded-xl text-zinc-400 hover:text-white font-medium text-sm transition-colors">Cancel</button>
        <button type="submit" id="save-btn" class="bg-amber-600 hover:bg-amber-500 text-white px-6 py-2.5 rounded-xl font-medium text-sm transition-colors">Save Category</button>
      </div>
    </form>
  </div>
</div>

<script>
function openModal(mode, data = null) {
  const modal = document.getElementById('category-modal');
  const title = document.getElementById('modal-title');
  const form = document.getElementById('category-form');
  form.reset();

  if (mode === 'edit' && data) {
    title.textContent = 'Edit Category';
    const c = JSON.parse(data);
    document.getElementById('c-id').value = c._id;
    document.getElementById('c-name').value = c.name;
    document.getElementById('c-desc').value = c.description;
  } else {
    title.textContent = 'Add Category';
    document.getElementById('c-id').value = '';
  }
  modal.classList.remove('hidden');
}

function closeModal() {
  document.getElementById('category-modal').classList.add('hidden');
}

async function saveCategory(e) {
  e.preventDefault();
  const btn = document.getElementById('save-btn');
  btn.textContent = 'Saving...';
  btn.disabled = true;

  const id = document.getElementById('c-id').value;
  const isEdit = !!id;
  const url = isEdit ? `/api/categories/${id}` : '/api/categories';
  const method = isEdit ? 'PUT' : 'POST';

  const body = {
    name: document.getElementById('c-name').value,
    description: document.getElementById('c-desc').value
  };

  try {
    const res = await fetch(url, {
      method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
    });
    if (res.ok) {
      closeModal();
      // Auto refresh via Pusher
    } else {
      const d = await res.json();
      alert(d.message || 'Error saving category');
    }
  } catch {
    alert('Network error');
  } finally {
    btn.textContent = 'Save Category';
    btn.disabled = false;
  }
}

async function deleteCategory(id) {
  if (!confirm('Are you sure you want to delete this category? Products in this category will become Uncategorized.')) return;
  try { await fetch(`/api/categories/${id}`, { method: 'DELETE' }); } catch(e) {}
}
</script>

<script src="https://js.pusher.com/8.2.0/pusher.min.js"></script>
<script>
const pusher = new Pusher('<%= pusherKey %>', { cluster: '<%= pusherCluster %>' });
const channel = pusher.subscribe('mhq-reseller');
channel.bind('category:new', () => window.location.reload());
channel.bind('category:updated', () => window.location.reload());
channel.bind('category:deleted', () => window.location.reload());
</script>
