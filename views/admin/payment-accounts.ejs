<div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-white mb-1">Payment Accounts Management</h1>
      <p class="text-zinc-400 text-sm">Configure bank accounts, EasyPaisa, and JazzCash for customer advance payments</p>
    </div>
    <button onclick="openAddAccountModal()" class="px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-xl transition-colors flex items-center gap-2 text-sm shadow-lg shadow-amber-600/20">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Add Bank / Wallet
    </button>
  </div>

  <!-- Accounts Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="accounts-grid">
    <% accounts.forEach(acc => { 
      const b64 = Buffer.from(unescape(encodeURIComponent(JSON.stringify(acc)))).toString('base64');
    %>
    <div class="bg-zinc-900 border border-zinc-700/80 rounded-2xl p-5 flex flex-col justify-between relative shadow-xl hover:border-zinc-600 transition-all" id="account-card-<%= acc._id %>">
      <div>
        <div class="flex items-center justify-between mb-4 border-b border-zinc-800 pb-3">
          <div class="flex items-center gap-3">
            <% if (acc.logoUrl) { %>
              <img src="<%= acc.logoUrl %>" alt="<%= acc.bankName %>" class="w-10 h-10 object-contain rounded-xl bg-white p-1 border border-zinc-700" />
            <% } else { %>
              <div class="w-10 h-10 rounded-xl bg-zinc-800 flex items-center justify-center text-amber-400 font-bold">
                <%= acc.bankName.slice(0, 2).toUpperCase() %>
              </div>
            <% } %>
            <div>
              <h3 class="text-white font-bold text-base"><%= acc.bankName %></h3>
              <span class="text-[10px] text-zinc-500 uppercase tracking-widest font-mono"><%= acc.bankCode %></span>
            </div>
          </div>
          <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full border <%= acc.isActive ? 'bg-emerald-500/15 border-emerald-500/30 text-emerald-400' : 'bg-zinc-800 border-zinc-700 text-zinc-500' %>">
            <%= acc.isActive ? 'Active' : 'Disabled' %>
          </span>
        </div>

        <div class="space-y-2 mb-4 text-xs">
          <div>
            <p class="text-zinc-500 text-[11px]">Account Title:</p>
            <p class="text-white font-bold text-sm"><%= acc.accountTitle %></p>
          </div>
          <div>
            <p class="text-zinc-500 text-[11px]">Account Number / IBAN:</p>
            <p class="text-amber-400 font-mono font-bold text-sm tracking-wide"><%= acc.accountNumber %></p>
          </div>
          <% if (acc.instructions) { %>
          <div class="bg-zinc-950 p-2.5 rounded-xl border border-zinc-800 text-zinc-400 text-[11px]">
            <p class="text-zinc-500 text-[10px] uppercase font-semibold mb-0.5">Instructions to Customer:</p>
            <p class="line-clamp-2"><%= acc.instructions %></p>
          </div>
          <% } %>
        </div>
      </div>

      <div class="pt-3 border-t border-zinc-800 flex gap-2">
        <button onclick="openEditAccountModal('<%= b64 %>')" class="flex-1 py-2 bg-blue-600/15 hover:bg-blue-600/25 text-blue-400 border border-blue-500/30 font-bold rounded-xl text-xs transition-colors">
          Edit
        </button>
        <button onclick="deleteAccount('<%= acc._id %>', '<%= acc.bankName %>')" class="flex-1 py-2 bg-red-600/15 hover:bg-red-600/25 text-red-400 border border-red-500/30 font-bold rounded-xl text-xs transition-colors">
          Delete
        </button>
      </div>
    </div>
    <% }) %>

    <% if (accounts.length === 0) { %>
    <div class="col-span-full text-center py-20 bg-zinc-900/40 rounded-3xl border border-zinc-800">
      <div class="w-14 h-14 rounded-full bg-zinc-800 flex items-center justify-center mx-auto mb-3 text-zinc-600">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
      </div>
      <p class="text-white font-bold text-base mb-1">No Payment Accounts Configured</p>
      <p class="text-zinc-500 text-xs mb-4">Add your EasyPaisa, JazzCash, or bank account so customers can send advance payments.</p>
      <button onclick="openAddAccountModal()" class="px-5 py-2.5 bg-amber-600 hover:bg-amber-500 text-white font-bold rounded-xl text-xs transition-colors">
        + Add First Account
      </button>
    </div>
    <% } %>
  </div>
</div>

<!-- Add / Edit Modal -->
<div id="account-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-md">
  <div class="bg-zinc-950 border border-zinc-700 rounded-3xl p-6 sm:p-7 w-full max-w-lg max-h-[92vh] overflow-y-auto shadow-2xl">
    <div class="flex items-center justify-between mb-5 border-b border-zinc-800 pb-3">
      <div>
        <h2 id="modal-title" class="text-lg sm:text-xl font-bold text-white">Add Bank / Wallet Account</h2>
        <p class="text-xs text-zinc-400">Configure transfer details for checkout</p>
      </div>
      <button onclick="closeAccountModal()" class="w-8 h-8 rounded-full bg-zinc-900 hover:bg-zinc-800 flex items-center justify-center text-zinc-400 hover:text-white transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="account-form" onsubmit="saveAccount(event)" class="space-y-4">
      <input type="hidden" id="acc-id" />

      <!-- Preset Bank Selector -->
      <div>
        <label class="block text-xs font-semibold text-zinc-300 mb-1">Select Bank / Wallet *</label>
        <select id="acc-preset-select" onchange="onPresetBankSelected(this.value)" class="w-full bg-zinc-900 border border-zinc-700 focus:border-amber-500 text-white rounded-xl px-3.5 py-2.5 text-sm outline-none transition-colors">
          <option value="">-- Choose from Popular Banks & Wallets --</option>
          <% presetBanks.forEach(b => { %>
            <option value="<%= b.code %>" data-name="<%= b.name %>" data-logo="<%= b.logoUrl %>"><%= b.name %></option>
          <% }) %>
          <option value="custom">Other / Custom Bank</option>
        </select>
        <p class="text-[11px] text-zinc-500 mt-1">Note: Each bank can only be added once.</p>
      </div>

      <!-- Bank Name & Code -->
      <div class="grid grid-cols-2 gap-3" id="custom-bank-fields">
        <div>
          <label class="block text-xs text-zinc-400 mb-1">Bank Name *</label>
          <input type="text" id="acc-name" required class="w-full bg-zinc-900 border border-zinc-700 focus:border-amber-500 text-white rounded-xl px-3.5 py-2.5 text-sm outline-none transition-colors" placeholder="e.g. EasyPaisa" />
        </div>
        <div>
          <label class="block text-xs text-zinc-400 mb-1">Bank Code *</label>
          <input type="text" id="acc-code" required class="w-full bg-zinc-900 border border-zinc-700 focus:border-amber-500 text-white rounded-xl px-3.5 py-2.5 text-sm outline-none transition-colors font-mono uppercase" placeholder="e.g. EASYPAISA" />
        </div>
      </div>

      <!-- Account Title & Number -->
      <div>
        <label class="block text-xs text-zinc-300 mb-1">Account Title (Receiver Name) *</label>
        <input type="text" id="acc-title" required class="w-full bg-zinc-900 border border-zinc-700 focus:border-amber-500 text-white rounded-xl px-3.5 py-2.5 text-sm outline-none transition-colors" placeholder="e.g. Muhammad Hamza" />
      </div>

      <div>
        <label class="block text-xs text-zinc-300 mb-1">Account Number / IBAN *</label>
        <input type="text" id="acc-number" required class="w-full bg-zinc-900 border border-zinc-700 focus:border-amber-500 text-white rounded-xl px-3.5 py-2.5 text-sm outline-none transition-colors font-mono" placeholder="e.g. 03313884546 or PK00MEZN..." />
      </div>

      <div>
        <label class="block text-xs text-zinc-300 mb-1">Customer Instructions (Optional)</label>
        <textarea id="acc-instructions" rows="2" class="w-full bg-zinc-900 border border-zinc-700 focus:border-amber-500 text-white rounded-xl px-3.5 py-2.5 text-sm outline-none transition-colors resize-none" placeholder="e.g. Mention your Order ID in transfer remarks and take a clear screenshot."></textarea>
      </div>

      <div class="flex items-center gap-3 pt-1">
        <input type="checkbox" id="acc-active" class="w-4 h-4 rounded border-zinc-700 bg-zinc-800 accent-amber-500 cursor-pointer" checked />
        <label for="acc-active" class="text-xs text-zinc-300 cursor-pointer font-medium">Enable this account on checkout</label>
      </div>

      <div class="flex gap-3 pt-3 border-t border-zinc-800">
        <button type="button" onclick="closeAccountModal()" class="flex-1 py-3 rounded-xl border border-zinc-700 text-zinc-400 hover:text-white text-xs font-semibold transition-colors">Cancel</button>
        <button type="submit" id="acc-save-btn" class="flex-1 py-3 bg-amber-600 hover:bg-amber-500 text-white rounded-xl text-xs font-bold transition-all shadow-lg shadow-amber-600/30">Save Account</button>
      </div>
    </form>
  </div>
</div>

<script>
const PRESET_BANKS_DATA = <%- JSON.stringify(presetBanks) %>;
const EXISTING_ACCOUNTS = <%- JSON.stringify(accounts) %>;

function openAddAccountModal() {
  document.getElementById('modal-title').textContent = 'Add Bank / Wallet Account';
  document.getElementById('acc-save-btn').textContent = 'Add Account';
  document.getElementById('acc-id').value = '';
  document.getElementById('account-form').reset();
  document.getElementById('acc-active').checked = true;

  // Filter or mark already added bank codes in preset dropdown
  const select = document.getElementById('acc-preset-select');
  Array.from(select.options).forEach(opt => {
    if (opt.value && opt.value !== 'custom') {
      const alreadyAdded = EXISTING_ACCOUNTS.some(a => a.bankCode.toLowerCase() === opt.value.toLowerCase());
      opt.disabled = alreadyAdded;
      if (alreadyAdded) opt.text = opt.dataset.name + ' (Already Added)';
      else opt.text = opt.dataset.name;
    }
  });

  document.getElementById('account-modal').classList.remove('hidden');
}

function openEditAccountModal(b64Data) {
  const acc = JSON.parse(decodeURIComponent(escape(atob(b64Data))));
  document.getElementById('modal-title').textContent = 'Edit ' + acc.bankName;
  document.getElementById('acc-save-btn').textContent = 'Update Account';
  document.getElementById('acc-id').value = acc._id;
  document.getElementById('acc-name').value = acc.bankName;
  document.getElementById('acc-code').value = acc.bankCode;
  document.getElementById('acc-title').value = acc.accountTitle;
  document.getElementById('acc-number').value = acc.accountNumber;
  document.getElementById('acc-instructions').value = acc.instructions || '';
  document.getElementById('acc-active').checked = Boolean(acc.isActive);

  // Set preset select if matched
  const select = document.getElementById('acc-preset-select');
  const matched = Array.from(select.options).find(opt => opt.value.toLowerCase() === acc.bankCode.toLowerCase());
  if (matched) {
    matched.disabled = false;
    select.value = matched.value;
  } else {
    select.value = 'custom';
  }

  document.getElementById('account-modal').classList.remove('hidden');
}

function closeAccountModal() {
  document.getElementById('account-modal').classList.add('hidden');
}

function onPresetBankSelected(code) {
  if (!code) return;
  if (code === 'custom') {
    document.getElementById('acc-name').value = '';
    document.getElementById('acc-code').value = '';
    return;
  }
  const bank = PRESET_BANKS_DATA.find(b => b.code === code);
  if (bank) {
    document.getElementById('acc-name').value = bank.name;
    document.getElementById('acc-code').value = bank.code;
  }
}

async function saveAccount(e) {
  e.preventDefault();
  const id = document.getElementById('acc-id').value;
  const btn = document.getElementById('acc-save-btn');
  const origText = btn.textContent;
  btn.textContent = 'Saving...';
  btn.disabled = true;

  const payload = {
    bankName: document.getElementById('acc-name').value.trim(),
    bankCode: document.getElementById('acc-code').value.trim().toUpperCase(),
    accountTitle: document.getElementById('acc-title').value.trim(),
    accountNumber: document.getElementById('acc-number').value.trim(),
    instructions: document.getElementById('acc-instructions').value.trim(),
    isActive: document.getElementById('acc-active').checked
  };

  const url = id ? `/api/payment-accounts/${id}` : '/api/payment-accounts';
  const method = id ? 'PUT' : 'POST';

  try {
    const res = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (res.ok && data.success) {
      closeAccountModal();
      upsertAccountCard(data.account);
    } else {
      alert(data.message || 'Error saving payment account');
    }
  } catch (err) {
    alert('Network error');
  } finally {
    btn.textContent = origText;
    btn.disabled = false;
  }
}

async function deleteAccount(id, name) {
  if (!confirm(`Are you sure you want to delete payment account "${name}"?`)) return;
  try {
    const res = await fetch(`/api/payment-accounts/${id}`, { method: 'DELETE' });
    const data = await res.json();
    if (res.ok && data.success) {
      const card = document.getElementById('account-card-' + id);
      if (card) card.remove();
    } else {
      alert(data.message || 'Error deleting account');
    }
  } catch (err) {
    alert('Network error');
  }
}

function buildAccountCardHtml(acc) {
  const b64 = btoa(unescape(encodeURIComponent(JSON.stringify(acc))));
  return `
    <div class="bg-zinc-900 border border-zinc-700/80 rounded-2xl p-5 flex flex-col justify-between relative shadow-xl hover:border-zinc-600 transition-all" id="account-card-${acc._id}">
      <div>
        <div class="flex items-center justify-between mb-4 border-b border-zinc-800 pb-3">
          <div class="flex items-center gap-3">
            <img src="${acc.logoUrl}" alt="${acc.bankName}" class="w-10 h-10 object-contain rounded-xl bg-zinc-800 p-1 border border-zinc-700" />
            <div>
              <h3 class="text-white font-bold text-base">${acc.bankName}</h3>
              <span class="text-[10px] text-zinc-500 uppercase tracking-widest font-mono">${acc.bankCode}</span>
            </div>
          </div>
          <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full border ${acc.isActive ? 'bg-emerald-500/15 border-emerald-500/30 text-emerald-400' : 'bg-zinc-800 border-zinc-700 text-zinc-500'}">
            ${acc.isActive ? 'Active' : 'Disabled'}
          </span>
        </div>

        <div class="space-y-2 mb-4 text-xs">
          <div>
            <p class="text-zinc-500 text-[11px]">Account Title:</p>
            <p class="text-white font-bold text-sm">${acc.accountTitle}</p>
          </div>
          <div>
            <p class="text-zinc-500 text-[11px]">Account Number / IBAN:</p>
            <p class="text-amber-400 font-mono font-bold text-sm tracking-wide">${acc.accountNumber}</p>
          </div>
          ${acc.instructions ? `
          <div class="bg-zinc-950 p-2.5 rounded-xl border border-zinc-800 text-zinc-400 text-[11px]">
            <p class="text-zinc-500 text-[10px] uppercase font-semibold mb-0.5">Instructions to Customer:</p>
            <p class="line-clamp-2">${acc.instructions}</p>
          </div>
          ` : ''}
        </div>
      </div>

      <div class="pt-3 border-t border-zinc-800 flex gap-2">
        <button onclick="openEditAccountModal('${b64}')" class="flex-1 py-2 bg-blue-600/15 hover:bg-blue-600/25 text-blue-400 border border-blue-500/30 font-bold rounded-xl text-xs transition-colors">
          Edit
        </button>
        <button onclick="deleteAccount('${acc._id}', '${acc.bankName}')" class="flex-1 py-2 bg-red-600/15 hover:bg-red-600/25 text-red-400 border border-red-500/30 font-bold rounded-xl text-xs transition-colors">
          Delete
        </button>
      </div>
    </div>
  `;
}

function upsertAccountCard(acc) {
  const existing = document.getElementById('account-card-' + acc._id);
  const grid = document.getElementById('accounts-grid');
  if (existing) {
    existing.outerHTML = buildAccountCardHtml(acc);
  } else {
    // Remove empty notice if present
    const emptyNotice = grid.querySelector('.col-span-full');
    if (emptyNotice) emptyNotice.remove();
    grid.insertAdjacentHTML('afterbegin', buildAccountCardHtml(acc));
  }
}
</script>

<script src="https://js.pusher.com/8.2.0/pusher.min.js"></script>
<script>
try {
  const pusher = new Pusher('<%= pusherKey %>', { cluster: '<%= pusherCluster %>' });
  const channel = pusher.subscribe('mhq-reseller');

  channel.bind('payment-account:new', (acc) => {
    if (acc) upsertAccountCard(acc);
  });

  channel.bind('payment-account:updated', (acc) => {
    if (acc) upsertAccountCard(acc);
  });

  channel.bind('payment-account:deleted', (data) => {
    if (data && data.id) {
      const card = document.getElementById('account-card-' + data.id);
      if (card) card.remove();
    }
  });
} catch(e) {}
</script>
</script>