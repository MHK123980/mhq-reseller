<div class="p-6">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-white mb-1">Dashboard</h1>
    <p class="text-zinc-400 text-sm">Welcome back, <%= user.name %></p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-zinc-900 border border-zinc-800 p-6 rounded-2xl">
      <div class="w-10 h-10 bg-amber-500/20 text-amber-500 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      </div>
      <p class="text-zinc-400 text-sm font-medium mb-1">Total Orders</p>
      <h3 class="text-3xl font-bold text-white" id="stat-total-orders">-</h3>
    </div>
    
    <div class="bg-zinc-900 border border-zinc-800 p-6 rounded-2xl">
      <div class="w-10 h-10 bg-blue-500/20 text-blue-500 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <p class="text-zinc-400 text-sm font-medium mb-1">Pending Orders</p>
      <h3 class="text-3xl font-bold text-white" id="stat-pending-orders">-</h3>
    </div>
    
    <div class="bg-zinc-900 border border-zinc-800 p-6 rounded-2xl">
      <div class="w-10 h-10 bg-green-500/20 text-green-500 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      </div>
      <p class="text-zinc-400 text-sm font-medium mb-1">Delivered Orders</p>
      <h3 class="text-3xl font-bold text-white" id="stat-delivered-orders">-</h3>
    </div>
    
    <div class="bg-zinc-900 border border-zinc-800 p-6 rounded-2xl">
      <div class="w-10 h-10 bg-emerald-500/20 text-emerald-500 rounded-lg flex items-center justify-center mb-4">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <p class="text-zinc-400 text-sm font-medium mb-1">Total Revenue</p>
      <h3 class="text-3xl font-bold text-amber-400" id="stat-revenue">-</h3>
    </div>
  </div>
</div>

<script>
async function loadStats() {
  try {
    const res = await fetch('/api/orders/stats');
    const data = await res.json();
    document.getElementById('stat-total-orders').textContent = data.totalOrders;
    document.getElementById('stat-pending-orders').textContent = data.pendingOrders;
    document.getElementById('stat-delivered-orders').textContent = data.deliveredOrders;
    document.getElementById('stat-revenue').textContent = 'Rs ' + data.totalRevenue;
    
    if(data.pendingOrders > 0) {
      const badge = document.getElementById('pending-badge');
      if(badge) {
        badge.textContent = data.pendingOrders;
        badge.classList.remove('hidden');
      }
    }
  } catch (err) {
    console.error('Failed to load stats', err);
  }
}

loadStats();
</script>

<!-- Pusher Real-time -->
<script src="https://js.pusher.com/8.2.0/pusher.min.js"></script>
<script>
const pusher = new Pusher('<%= pusherKey %>', { cluster: '<%= pusherCluster %>' });
const channel = pusher.subscribe('mhq-reseller');

channel.bind('order:new', () => loadStats());
channel.bind('order:updated', () => loadStats());
channel.bind('order:deleted', () => loadStats());
</script>
