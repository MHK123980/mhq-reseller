<div class="max-w-7xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-white mb-1">Products</h1>
      <p class="text-zinc-400"><%= products.length %> products total</p>
    </div>
    <button onclick="openModal('add')" class="px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-xl transition-colors">
      + Add Product
    </button>
  </div>

  <% if(products.length === 0) { %>
    <div class="text-center py-20 text-zinc-400">No products yet. Add your first product!</div>
  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="admin-products-grid">
      <% products.forEach(p => { %>
      <div class="bg-zinc-800/60 border border-zinc-700 rounded-2xl overflow-hidden product-card" id="product-card-<%= p._id %>">
        <div class="h-44 bg-zinc-900 relative">
          <% if (p.images && p.images.length > 0) { %>
          <img src="<%= p.images[0] %>" class="w-full h-full object-cover" loading="lazy" />
          <% } else { %>
          <div class="w-full h-full flex items-center justify-center text-zinc-600">No Image</div>
          <% } %>
          <div class="absolute top-2 left-2 flex flex-col gap-1 z-10">
            <% if (p.isFeatured) { %>
              <span class="bg-amber-500 text-black text-[10px] font-extrabold px-2 py-0.5 rounded shadow">★ FEATURED</span>
            <% } %>
            <% if (p.isLowInStock) { %>
              <span class="bg-yellow-500 text-black text-[10px] font-extrabold px-2 py-0.5 rounded shadow">⚠ LOW IN STOCK</span>
            <% } %>
            <% if (p.isOutOfStock) { %>
              <span class="bg-red-600 text-white text-[10px] font-extrabold px-2 py-0.5 rounded shadow">✖ OUT OF STOCK</span>
            <% } %>
          </div>
        </div>
        <div class="p-4">
          <h3 class="text-white font-bold text-lg mb-1 truncate"><%= p.name %></h3>
          <p class="text-zinc-400 text-sm mb-1"><%= p.category ? p.category.name : 'Uncategorized' %></p>
          <p class="text-amber-400 font-bold">Rs <%= p.price.toLocaleString() %></p>
          
          <div class="flex flex-col gap-2 mt-4">
            <div class="flex gap-2">
              <button onclick="toggleFeatured('<%= p._id %>')" class="flex-1 py-2 rounded-lg text-xs font-bold transition-colors <%= p.isFeatured ? 'bg-amber-500/20 text-amber-400 hover:bg-amber-500/30 border border-amber-500/40' : 'bg-zinc-700 text-zinc-300 hover:bg-zinc-600' %>">
                <%= p.isFeatured ? '★ Featured' : '☆ Set Featured' %>
              </button>
              <button onclick="toggleStock('<%= p._id %>')" class="flex-1 py-2 rounded-lg text-xs font-bold transition-colors <%= p.isOutOfStock ? 'bg-red-500/20 text-red-400 hover:bg-red-500/30 border border-red-500/40' : 'bg-zinc-700 text-zinc-300 hover:bg-zinc-600' %>">
                <%= p.isOutOfStock ? 'In Stock' : 'Out of Stock' %>
              </button>
            </div>
            <div class="flex gap-2">
              <button onclick="openModal('edit', '<%= Buffer.from(JSON.stringify(p)).toString('base64') %>')" class="flex-1 py-2 bg-blue-600/20 text-blue-400 hover:bg-blue-600/30 rounded-lg text-xs font-bold transition-colors">Edit</button>
              <button onclick="deleteProduct('<%= p._id %>')" class="flex-1 py-2 bg-red-600/20 text-red-400 hover:bg-red-600/30 rounded-lg text-xs font-bold transition-colors">Delete</button>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- Modal -->
<div id="product-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/70" onclick="closeModal()"></div>
  <div class="relative bg-zinc-900 border border-zinc-700 rounded-2xl p-6 w-full max-w-2xl max-h-[90vh] overflow-y-auto">
    <h2 id="modal-title" class="text-xl font-bold text-white mb-6">Add New Product</h2>

    <form id="product-form" onsubmit="saveProduct(event)" class="space-y-4">
      <input type="hidden" id="p-id" />
      
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="text-sm text-zinc-400 mb-1 block">Product Name *</label>
          <input type="text" id="p-name" required class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-amber-500" placeholder="Product name" />
        </div>
        <div>
          <label class="text-sm text-zinc-400 mb-1 block">Price (Rs) *</label>
          <input type="number" id="p-price" required class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-amber-500" placeholder="0" />
        </div>
      </div>

      <div>
        <label class="text-sm text-zinc-400 mb-1 block">Category *</label>
        <select id="p-cat" required class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-amber-500">
          <option value="">Select category</option>
          <% categories.forEach(c => { %>
          <option value="<%= c._id %>"><%= c.name %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="text-sm text-zinc-400 mb-1 block">Description *</label>
        <textarea id="p-desc" required rows="3" class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-amber-500 resize-none" placeholder="Product description"></textarea>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="text-sm text-zinc-400 mb-1 block">Delivery Charges (Rs)</label>
          <input type="number" id="p-delivery" class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-amber-500" value="0" />
        </div>
        <div>
          <label class="text-sm text-zinc-400 mb-1 block">Discount %</label>
          <input type="number" id="p-discount-percent" min="0" max="100" class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-amber-500" value="0" />
        </div>
      </div>

      <!-- Toggles -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        <label class="flex items-center gap-2 cursor-pointer">
          <div class="relative w-12 h-6 rounded-full transition-colors bg-zinc-700" id="tgl-bg-discount" onclick="toggleSwitch('p-has-discount', 'tgl-bg-discount', 'tgl-dot-discount')">
            <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-all" id="tgl-dot-discount"></div>
            <input type="checkbox" id="p-has-discount" class="hidden" />
          </div>
          <span class="text-sm text-zinc-300">Has Discount</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <div class="relative w-12 h-6 rounded-full transition-colors bg-zinc-700" id="tgl-bg-free-delivery" onclick="toggleSwitch('p-free-delivery', 'tgl-bg-free-delivery', 'tgl-dot-free-delivery')">
            <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-all" id="tgl-dot-free-delivery"></div>
            <input type="checkbox" id="p-free-delivery" class="hidden" />
          </div>
          <span class="text-sm text-zinc-300">Free Delivery</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <div class="relative w-12 h-6 rounded-full transition-colors bg-zinc-700" id="tgl-bg-featured" onclick="toggleSwitch('p-featured', 'tgl-bg-featured', 'tgl-dot-featured')">
            <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-all" id="tgl-dot-featured"></div>
            <input type="checkbox" id="p-featured" class="hidden" />
          </div>
          <span class="text-sm text-zinc-300">Featured</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <div class="relative w-12 h-6 rounded-full transition-colors bg-zinc-700" id="tgl-bg-low-stock" onclick="toggleSwitch('p-low-stock', 'tgl-bg-low-stock', 'tgl-dot-low-stock')">
            <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-all" id="tgl-dot-low-stock"></div>
            <input type="checkbox" id="p-low-stock" class="hidden" />
          </div>
          <span class="text-sm text-zinc-300">Low In Stock</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <div class="relative w-12 h-6 rounded-full transition-colors bg-zinc-700" id="tgl-bg-out-stock" onclick="toggleSwitch('p-out-stock', 'tgl-bg-out-stock', 'tgl-dot-out-stock')">
            <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-all" id="tgl-dot-out-stock"></div>
            <input type="checkbox" id="p-out-stock" class="hidden" />
          </div>
          <span class="text-sm text-zinc-300">Out of Stock</span>
        </label>
      </div>

      <!-- Image Upload (Supports PDF & ZIP) -->
      <div>
        <label class="text-sm text-zinc-400 mb-2 block">Product Images (Supports Images, .zip, .pdf) *</label>
        <input type="file" id="p-image-input" accept="image/*,.zip,.pdf" multiple onchange="handleFileUpload(event)" class="hidden" />
        <button type="button" onclick="document.getElementById('p-image-input').click()" id="upload-btn" class="w-full border-2 border-dashed border-zinc-600 rounded-xl py-4 text-zinc-400 hover:border-amber-500 hover:text-amber-400 transition-colors text-sm">
          Click to upload files
        </button>
        <div id="image-preview-container" class="flex flex-wrap gap-2 mt-3 empty:hidden"></div>
      </div>

      <div class="flex gap-3 mt-6">
        <button type="button" onclick="closeModal()" class="flex-1 py-3 border border-zinc-700 text-zinc-400 hover:text-white rounded-xl transition-colors">
          Cancel
        </button>
        <button type="submit" id="save-btn" class="flex-1 py-3 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-xl transition-colors disabled:opacity-50">
          Save Product
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Libraries for ZIP and PDF processing -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
</script>

<script>
const IMGBB_KEY = "d26bb3aafef1e75c324e7ce3072e3b47";
let uploadedImages = [];
let isUploading = false;

function toggleSwitch(inputId, bgId, dotId) {
  const input = document.getElementById(inputId);
  input.checked = !input.checked;
  updateSwitchUI(inputId, bgId, dotId);
}
function updateSwitchUI(inputId, bgId, dotId) {
  const input = document.getElementById(inputId);
  const bg = document.getElementById(bgId);
  const dot = document.getElementById(dotId);
  if (input.checked) {
    bg.classList.remove('bg-zinc-700'); bg.classList.add('bg-amber-500');
    dot.classList.remove('left-0.5'); dot.classList.add('left-6');
  } else {
    bg.classList.add('bg-zinc-700'); bg.classList.remove('bg-amber-500');
    dot.classList.add('left-0.5'); dot.classList.remove('left-6');
  }
}
function setSwitch(inputId, bgId, dotId, value) {
  document.getElementById(inputId).checked = value;
  updateSwitchUI(inputId, bgId, dotId);
}

function openModal(mode, b64Data = null) {
  const modal = document.getElementById('product-modal');
  const title = document.getElementById('modal-title');
  const form = document.getElementById('product-form');
  const btn = document.getElementById('save-btn');
  
  form.reset();
  uploadedImages = [];
  renderPreviews();

  // Reset toggles
  setSwitch('p-has-discount', 'tgl-bg-discount', 'tgl-dot-discount', false);
  setSwitch('p-free-delivery', 'tgl-bg-free-delivery', 'tgl-dot-free-delivery', false);
  setSwitch('p-featured', 'tgl-bg-featured', 'tgl-dot-featured', false);
  setSwitch('p-low-stock', 'tgl-bg-low-stock', 'tgl-dot-low-stock', false);
  setSwitch('p-out-stock', 'tgl-bg-out-stock', 'tgl-dot-out-stock', false);

  if (mode === 'edit' && b64Data) {
    title.textContent = 'Edit Product';
    btn.textContent = 'Update Product';
    const p = JSON.parse(atob(b64Data));
    document.getElementById('p-id').value = p._id;
    document.getElementById('p-name').value = p.name;
    document.getElementById('p-desc').value = p.description;
    document.getElementById('p-price').value = p.price;
    document.getElementById('p-delivery').value = p.deliveryCharges || 0;
    document.getElementById('p-discount-percent').value = p.discountPercent || 0;
    if (p.category) document.getElementById('p-cat').value = p.category._id || p.category;
    
    setSwitch('p-has-discount', 'tgl-bg-discount', 'tgl-dot-discount', p.hasDiscount);
    setSwitch('p-free-delivery', 'tgl-bg-free-delivery', 'tgl-dot-free-delivery', p.isFreeDelivery);
    setSwitch('p-featured', 'tgl-bg-featured', 'tgl-dot-featured', p.isFeatured);
    setSwitch('p-low-stock', 'tgl-bg-low-stock', 'tgl-dot-low-stock', p.isLowInStock);
    setSwitch('p-out-stock', 'tgl-bg-out-stock', 'tgl-dot-out-stock', p.isOutOfStock);

    if (p.images) {
      uploadedImages = [...p.images];
      renderPreviews();
    }
  } else {
    title.textContent = 'Add New Product';
    btn.textContent = 'Add Product';
    document.getElementById('p-id').value = '';
  }
  modal.classList.remove('hidden');
}

function closeModal() {
  document.getElementById('product-modal').classList.add('hidden');
}

// ----------------- FILE EXTRACTION AND UPLOAD LOGIC ----------------- //

async function uploadToImgBB(fileBlob, fileName) {
  const formData = new FormData();
  formData.append("image", fileBlob, fileName);
  try {
    const res = await fetch(`https://api.imgbb.com/1/upload?key=${IMGBB_KEY}`, {
      method: "POST", body: formData
    });
    const data = await res.json();
    if(data.data && data.data.url) return data.data.url;
    throw new Error("ImgBB error");
  } catch(e) {
    console.error("Upload failed", e);
    return null;
  }
}

async function handleFileUpload(e) {
  const files = Array.from(e.target.files || []);
  if (files.length === 0) return;
  
  const uploadBtn = document.getElementById('upload-btn');
  const originalText = uploadBtn.textContent;
  isUploading = true;
  uploadBtn.textContent = "Processing files...";
  uploadBtn.disabled = true;

  try {
    for (const file of files) {
      if (file.type.includes("zip") || file.name.endsWith(".zip")) {
        uploadBtn.textContent = "Extracting ZIP...";
        await processZip(file);
      } else if (file.type === "application/pdf" || file.name.endsWith(".pdf")) {
        uploadBtn.textContent = "Extracting PDF...";
        await processPdf(file);
      } else if (file.type.startsWith("image/")) {
        uploadBtn.textContent = "Uploading image...";
        const url = await uploadToImgBB(file, file.name);
        if(url) uploadedImages.push(url);
      }
    }
    renderPreviews();
  } catch (err) {
    alert("Error processing files: " + err.message);
  } finally {
    isUploading = false;
    uploadBtn.textContent = "Click to upload files";
    uploadBtn.disabled = false;
    e.target.value = ''; // reset input
  }
}

async function processZip(file) {
  const zip = await JSZip.loadAsync(file);
  const imageFiles = [];
  
  zip.forEach((relativePath, zipEntry) => {
    if (!zipEntry.dir && relativePath.match(/\.(jpg|jpeg|png|webp|gif)$/i)) {
      imageFiles.push(zipEntry);
    }
  });

  const uploadBtn = document.getElementById('upload-btn');
  for (let i = 0; i < imageFiles.length; i++) {
    uploadBtn.textContent = `Uploading extracted image ${i+1}/${imageFiles.length}...`;
    const blob = await imageFiles[i].async("blob");
    const url = await uploadToImgBB(blob, imageFiles[i].name);
    if(url) uploadedImages.push(url);
  }
}

async function processPdf(file) {
  const arrayBuffer = await file.arrayBuffer();
  const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
  const numPages = pdf.numPages;
  const uploadBtn = document.getElementById('upload-btn');

  for (let i = 1; i <= numPages; i++) {
    uploadBtn.textContent = `Rendering and uploading PDF page ${i}/${numPages}...`;
    const page = await pdf.getPage(i);
    const viewport = page.getViewport({ scale: 1.5 });
    const canvas = document.createElement("canvas");
    const context = canvas.getContext("2d");
    canvas.height = viewport.height;
    canvas.width = viewport.width;

    await page.render({ canvasContext: context, viewport: viewport }).promise;

    const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.9));
    const url = await uploadToImgBB(blob, `pdf_page_${i}.jpg`);
    if(url) uploadedImages.push(url);
  }
}

function removeImage(index) {
  uploadedImages.splice(index, 1);
  renderPreviews();
}

function renderPreviews() {
  const container = document.getElementById('image-preview-container');
  container.innerHTML = '';
  uploadedImages.forEach((url, i) => {
    container.insertAdjacentHTML('beforeend', `
      <div class="relative">
        <img src="${url}" class="w-16 h-16 object-cover rounded-lg border border-zinc-700" />
        <button type="button" onclick="removeImage(${i})" class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white rounded-full text-xs flex items-center justify-center font-bold">×</button>
      </div>
    `);
  });
}

// ----------------- CRUD LOGIC ----------------- //

async function saveProduct(e) {
  e.preventDefault();
  if(uploadedImages.length === 0) {
    alert("Please upload at least one image");
    return;
  }
  
  const btn = document.getElementById('save-btn');
  const originalText = btn.textContent;
  btn.textContent = 'Saving...';
  btn.disabled = true;

  const id = document.getElementById('p-id').value;
  const isEdit = !!id;
  const url = isEdit ? `/api/products/${id}` : '/api/products';
  const method = isEdit ? 'PUT' : 'POST';

  const body = {
    name: document.getElementById('p-name').value,
    description: document.getElementById('p-desc').value,
    price: parseFloat(document.getElementById('p-price').value),
    category: document.getElementById('p-cat').value,
    deliveryCharges: parseFloat(document.getElementById('p-delivery').value || 0),
    discountPercent: parseFloat(document.getElementById('p-discount-percent').value || 0),
    images: uploadedImages,
    hasDiscount: document.getElementById('p-has-discount').checked,
    isFreeDelivery: document.getElementById('p-free-delivery').checked,
    isFeatured: document.getElementById('p-featured').checked,
    isLowInStock: document.getElementById('p-low-stock').checked,
    isOutOfStock: document.getElementById('p-out-stock').checked,
  };

  try {
    const res = await fetch(url, {
      method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
    });
    if (res.ok) {
      closeModal();
    } else {
      const data = await res.json();
      alert(data.message || 'Error saving product');
    }
  } catch {
    alert('Network error');
  } finally {
    btn.textContent = originalText;
    btn.disabled = false;
  }
}

async function deleteProduct(id) {
  if (!confirm('Are you sure you want to delete this product?')) return;
  try { await fetch(`/api/products/${id}`, { method: 'DELETE' }); } catch(e) {}
}

async function toggleFeatured(id) {
  try { await fetch(`/api/products/${id}/toggle-featured`, { method: 'PATCH' }); } catch(e){}
}
async function toggleStock(id) {
  try { await fetch(`/api/products/${id}/toggle-out-of-stock`, { method: 'PATCH' }); } catch(e){}
}
</script>

<script src="https://js.pusher.com/8.2.0/pusher.min.js"></script>
<script>
const pusher = new Pusher('<%= pusherKey %>', { cluster: '<%= pusherCluster %>' });
const channel = pusher.subscribe('mhq-reseller');

channel.bind('product:new', () => window.location.reload());
channel.bind('product:updated', () => window.location.reload());
channel.bind('product:deleted', () => window.location.reload());
</script>
