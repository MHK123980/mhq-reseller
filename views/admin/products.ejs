<div class="max-w-7xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-white mb-1">Products</h1>
      <p class="text-zinc-400 text-sm" id="products-count">Loading...</p>
    </div>
    <button onclick="openModal('add')" class="px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-xl transition-colors">
      + Add Product
    </button>
  </div>

  <!-- Products grid will be rendered by JS -->
  <div id="admin-products-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <div class="col-span-full flex justify-center py-20">
      <div class="w-10 h-10 border-4 border-amber-500 border-t-transparent rounded-full animate-spin"></div>
    </div>
  </div>
</div>

<!-- Modal -->
<div id="product-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/70" onclick="closeModal()"></div>
  <div class="relative bg-zinc-900 border border-zinc-700 rounded-2xl p-6 w-full max-w-2xl max-h-[90vh] overflow-y-auto">
    <h2 id="modal-title" class="text-xl font-bold text-white mb-6">Add New Product</h2>

    <form id="product-form" onsubmit="saveProduct(event)" class="space-y-4">
      <input type="hidden" id="p-id" />
      
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="text-sm text-zinc-400 mb-1 block">Product Name *</label>
          <input type="text" id="p-name" required class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-amber-500" placeholder="Product name" />
        </div>
        <div>
          <label class="text-sm text-zinc-400 mb-1 block">Price (Rs) *</label>
          <input type="number" id="p-price" required class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-amber-500" placeholder="0" />
        </div>
      </div>

      <div>
        <label class="text-sm text-zinc-400 mb-1 block">Category *</label>
        <select id="p-cat" required class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-amber-500">
          <option value="">Select category</option>
          <% categories.forEach(c => { %>
          <option value="<%= c._id %>"><%= c.name %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="text-sm text-zinc-400 mb-1 block">Description *</label>
        <textarea id="p-desc" required rows="3" class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-amber-500 resize-none" placeholder="Product description"></textarea>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="text-sm text-zinc-400 mb-1 block">Delivery Charges (Rs)</label>
          <input type="number" id="p-delivery" class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-amber-500" value="0" />
        </div>
        <div>
          <label class="text-sm text-zinc-400 mb-1 block">Discounted Price (Rs) <span class="text-zinc-600 text-xs">– if discount enabled</span></label>
          <input type="number" id="p-discounted-price" min="0" class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-amber-500" value="0" placeholder="Enter discounted price" oninput="previewDiscount()" />
          <p class="text-xs text-amber-400 mt-1" id="discount-calc-preview"></p>
        </div>
      </div>

      <!-- Toggles -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        <% const toggles = [['p-has-discount','tgl-bg-discount','tgl-dot-discount','Has Discount'],['p-free-delivery','tgl-bg-free-delivery','tgl-dot-free-delivery','Free Delivery'],['p-featured','tgl-bg-featured','tgl-dot-featured','Featured'],['p-low-stock','tgl-bg-low-stock','tgl-dot-low-stock','Low In Stock'],['p-out-stock','tgl-bg-out-stock','tgl-dot-out-stock','Out of Stock']] %>
        <% toggles.forEach(([inputId, bgId, dotId, label]) => { %>
        <label class="flex items-center gap-2 cursor-pointer">
          <div class="relative w-12 h-6 rounded-full transition-colors bg-zinc-700" id="<%= bgId %>" onclick="toggleSwitch('<%= inputId %>','<%= bgId %>','<%= dotId %>')">
            <div class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-all" id="<%= dotId %>"></div>
            <input type="checkbox" id="<%= inputId %>" class="hidden" />
          </div>
          <span class="text-sm text-zinc-300"><%= label %></span>
        </label>
        <% }) %>
      </div>

      <!-- Variant Builder (Optional) -->
      <div class="border border-zinc-700 rounded-xl p-4">
        <div class="flex items-center justify-between mb-3">
          <p class="text-sm font-semibold text-white">Product Variants <span class="text-zinc-500 text-xs font-normal">(Optional — e.g. Color, Size)</span></p>
          <button type="button" onclick="addVariantGroup()" class="text-xs bg-amber-600/20 hover:bg-amber-600/30 text-amber-400 border border-amber-600/30 px-3 py-1.5 rounded-lg transition-colors font-medium">
            + Add Variant
          </button>
        </div>
        <div id="variants-container" class="space-y-3"></div>
      </div>

      <!-- Image Upload (Supports PDF & ZIP) -->
      <div>
        <label class="text-sm text-zinc-400 mb-2 block">Product Images (Supports Images, .zip, .pdf) *</label>
        <input type="file" id="p-image-input" accept="image/*,.zip,.pdf" multiple onchange="handleFileUpload(event)" class="hidden" />
        <button type="button" onclick="document.getElementById('p-image-input').click()" id="upload-btn" class="w-full border-2 border-dashed border-zinc-600 rounded-xl py-4 text-zinc-400 hover:border-amber-500 hover:text-amber-400 transition-colors text-sm">
          Click to upload files
        </button>
        <div id="image-preview-container" class="flex flex-wrap gap-2 mt-3 empty:hidden"></div>
      </div>

      <div class="flex gap-3 mt-6">
        <button type="button" onclick="closeModal()" class="flex-1 py-3 border border-zinc-700 text-zinc-400 hover:text-white rounded-xl transition-colors">Cancel</button>
        <button type="submit" id="save-btn" class="flex-1 py-3 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-xl transition-colors disabled:opacity-50">Save Product</button>
      </div>
    </form>
  </div>
</div>

<!-- Libraries for ZIP and PDF processing -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';</script>

<script>
const IMGBB_KEY = "d26bb3aafef1e75c324e7ce3072e3b47";
let uploadedImages = [];
let allAdminProducts = [];

// ---- Render grid from JS ----
function renderProductCard(p) {
  const catName = p.category ? p.category.name : 'Uncategorized';
  const imgHtml = p.images && p.images[0]
    ? `<img src="${p.images[0]}" class="w-full h-full object-cover" loading="lazy"/>`
    : `<div class="w-full h-full flex items-center justify-center text-zinc-600">No Image</div>`;
  const badges = [
    p.isFeatured ? `<span class="bg-amber-500 text-black text-[10px] font-extrabold px-2 py-0.5 rounded shadow">★ FEATURED</span>` : '',
    p.isLowInStock ? `<span class="bg-yellow-500 text-black text-[10px] font-extrabold px-2 py-0.5 rounded shadow">⚠ LOW IN STOCK</span>` : '',
    p.isOutOfStock ? `<span class="bg-red-600 text-white text-[10px] font-extrabold px-2 py-0.5 rounded shadow">✖ OUT OF STOCK</span>` : '',
  ].join('');
  const b64 = btoa(unescape(encodeURIComponent(JSON.stringify(p))));
  return `
    <div class="bg-zinc-800/60 border border-zinc-700 rounded-2xl overflow-hidden product-card" id="product-card-${p._id}" data-id="${p._id}">
      <div class="h-44 bg-zinc-900 relative">
        ${imgHtml}
        <div class="absolute top-2 left-2 flex flex-col gap-1 z-10">${badges}</div>
      </div>
      <div class="p-4">
        <h3 class="text-white font-bold text-lg mb-1 truncate">${p.name}</h3>
        <p class="text-zinc-400 text-sm mb-1">${catName}</p>
        <p class="text-amber-400 font-bold">Rs ${p.price ? p.price.toLocaleString() : 0}</p>
        <div class="flex flex-col gap-2 mt-4">
          <div class="flex gap-2">
            <button onclick="toggleFeatured('${p._id}')" class="flex-1 py-2 rounded-lg text-xs font-bold transition-colors ${p.isFeatured ? 'bg-amber-500/20 text-amber-400 hover:bg-amber-500/30 border border-amber-500/40' : 'bg-zinc-700 text-zinc-300 hover:bg-zinc-600'}">
              ${p.isFeatured ? '★ Featured' : '☆ Set Featured'}
            </button>
            <button onclick="toggleStock('${p._id}')" class="flex-1 py-2 rounded-lg text-xs font-bold transition-colors ${p.isOutOfStock ? 'bg-red-500/20 text-red-400 hover:bg-red-500/30 border border-red-500/40' : 'bg-zinc-700 text-zinc-300 hover:bg-zinc-600'}">
              ${p.isOutOfStock ? 'In Stock' : 'Out of Stock'}
            </button>
          </div>
          <div class="flex gap-2">
            <button onclick="openModal('edit','${b64}')" class="flex-1 py-2 bg-blue-600/20 text-blue-400 hover:bg-blue-600/30 rounded-lg text-xs font-bold transition-colors">Edit</button>
            <button onclick="deleteProduct('${p._id}')" class="flex-1 py-2 bg-red-600/20 text-red-400 hover:bg-red-600/30 rounded-lg text-xs font-bold transition-colors">Delete</button>
          </div>
        </div>
      </div>
    </div>`;
}

async function loadProducts() {
  try {
    const res = await fetch('/api/products');
    allAdminProducts = await res.json();
    const grid = document.getElementById('admin-products-grid');
    const countEl = document.getElementById('products-count');
    countEl.textContent = allAdminProducts.length + ' products total';
    if (allAdminProducts.length === 0) {
      grid.innerHTML = '<div class="col-span-full text-center py-20 text-zinc-400">No products yet. Add your first product!</div>';
    } else {
      grid.innerHTML = allAdminProducts.map(renderProductCard).join('');
    }
  } catch(e) { console.error('Failed to load products', e); }
}

// Load on page open
loadProducts();

// ---- Toggle switches ----
function toggleSwitch(inputId, bgId, dotId) {
  const input = document.getElementById(inputId);
  input.checked = !input.checked;
  updateSwitchUI(inputId, bgId, dotId);
}
function updateSwitchUI(inputId, bgId, dotId) {
  const input = document.getElementById(inputId);
  const bg = document.getElementById(bgId);
  const dot = document.getElementById(dotId);
  if (input.checked) {
    bg.classList.remove('bg-zinc-700'); bg.classList.add('bg-amber-500');
    dot.style.left = '1.5rem';
  } else {
    bg.classList.add('bg-zinc-700'); bg.classList.remove('bg-amber-500');
    dot.style.left = '0.125rem';
  }
}
function setSwitch(inputId, bgId, dotId, value) {
  document.getElementById(inputId).checked = value;
  updateSwitchUI(inputId, bgId, dotId);
}

function openModal(mode, b64Data = null) {
  const modal = document.getElementById('product-modal');
  document.getElementById('product-form').reset();
  uploadedImages = [];
  renderPreviews();
  document.getElementById('variants-container').innerHTML = '';
  document.getElementById('discount-calc-preview').textContent = '';
  const switches = [['p-has-discount','tgl-bg-discount','tgl-dot-discount'],['p-free-delivery','tgl-bg-free-delivery','tgl-dot-free-delivery'],['p-featured','tgl-bg-featured','tgl-dot-featured'],['p-low-stock','tgl-bg-low-stock','tgl-dot-low-stock'],['p-out-stock','tgl-bg-out-stock','tgl-dot-out-stock']];
  switches.forEach(([a,b,c]) => setSwitch(a,b,c,false));

  if (mode === 'edit' && b64Data) {
    document.getElementById('modal-title').textContent = 'Edit Product';
    document.getElementById('save-btn').textContent = 'Update Product';
    const p = JSON.parse(decodeURIComponent(escape(atob(b64Data))));
    document.getElementById('p-id').value = p._id;
    document.getElementById('p-name').value = p.name;
    document.getElementById('p-desc').value = p.description;
    document.getElementById('p-price').value = p.price;
    document.getElementById('p-delivery').value = p.deliveryCharges || 0;
    document.getElementById('p-discounted-price').value = p.discountedPrice || 0;
    if (p.discountedPrice && p.price && p.hasDiscount) {
      const pct = Math.round((p.price - p.discountedPrice) / p.price * 100);
      document.getElementById('discount-calc-preview').textContent = pct > 0 ? `= ${pct}% OFF` : '';
    }
    if (p.category) document.getElementById('p-cat').value = p.category._id || p.category;
    setSwitch('p-has-discount','tgl-bg-discount','tgl-dot-discount', p.hasDiscount);
    setSwitch('p-free-delivery','tgl-bg-free-delivery','tgl-dot-free-delivery', p.isFreeDelivery);
    setSwitch('p-featured','tgl-bg-featured','tgl-dot-featured', p.isFeatured);
    setSwitch('p-low-stock','tgl-bg-low-stock','tgl-dot-low-stock', p.isLowInStock);
    setSwitch('p-out-stock','tgl-bg-out-stock','tgl-dot-out-stock', p.isOutOfStock);
    if (p.images) { uploadedImages = [...p.images]; renderPreviews(); }
    // Load existing variants
    if (p.variants && p.variants.length > 0) {
      p.variants.forEach(v => addVariantGroup(v));
    }
  } else {
    document.getElementById('modal-title').textContent = 'Add New Product';
    document.getElementById('save-btn').textContent = 'Add Product';
    document.getElementById('p-id').value = '';
  }
  modal.classList.remove('hidden');
}

function closeModal() {
  document.getElementById('product-modal').classList.add('hidden');
}

// Upload via server proxy to avoid CORS issues on Vercel
async function uploadToImgBB(fileBlob, fileName) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = async function(e) {
      try {
        const base64 = e.target.result; // data:image/jpeg;base64,...
        const res = await fetch('/api/upload', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ imageBase64: base64, fileName: fileName })
        });
        const data = await res.json();
        if (data.success && data.url) resolve(data.url);
        else reject(new Error(data.message || 'Upload failed'));
      } catch(err) { reject(err); }
    };
    reader.onerror = () => reject(new Error('FileReader failed'));
    reader.readAsDataURL(fileBlob);
  });
}

async function handleFileUpload(e) {
  const files = Array.from(e.target.files || []);
  if (!files.length) return;
  const btn = document.getElementById('upload-btn');
  btn.disabled = true;
  try {
    for (const file of files) {
      if (file.type.includes("zip") || file.name.endsWith(".zip")) {
        btn.textContent = "Extracting ZIP...";
        await processZip(file, btn);
      } else if (file.type === "application/pdf" || file.name.endsWith(".pdf")) {
        btn.textContent = "Extracting PDF...";
        await processPdf(file, btn);
      } else if (file.type.startsWith("image/")) {
        btn.textContent = "Uploading image...";
        const url = await uploadToImgBB(file, file.name);
        if(url) uploadedImages.push(url);
      }
    }
    renderPreviews();
  } catch (err) { alert("Error: " + err.message); }
  finally { btn.textContent = "Click to upload files"; btn.disabled = false; e.target.value = ''; }
}

async function processZip(file, btn) {
  const zip = await JSZip.loadAsync(file);
  const imgs = [];
  zip.forEach((path, entry) => { if (!entry.dir && path.match(/\.(jpg|jpeg|png|webp|gif)$/i)) imgs.push(entry); });
  for (let i = 0; i < imgs.length; i++) {
    btn.textContent = `ZIP: Uploading ${i+1}/${imgs.length}...`;
    const blob = await imgs[i].async("blob");
    const url = await uploadToImgBB(blob, imgs[i].name);
    if(url) uploadedImages.push(url);
  }
}

async function processPdf(file, btn) {
  const ab = await file.arrayBuffer();
  const pdf = await pdfjsLib.getDocument({ data: ab }).promise;
  for (let i = 1; i <= pdf.numPages; i++) {
    btn.textContent = `PDF: Page ${i}/${pdf.numPages}...`;
    const page = await pdf.getPage(i);
    const vp = page.getViewport({ scale: 1.5 });
    const canvas = document.createElement("canvas");
    canvas.width = vp.width; canvas.height = vp.height;
    await page.render({ canvasContext: canvas.getContext("2d"), viewport: vp }).promise;
    const blob = await new Promise(r => canvas.toBlob(r, 'image/jpeg', 0.9));
    const url = await uploadToImgBB(blob, `pdf_page_${i}.jpg`);
    if(url) uploadedImages.push(url);
  }
}

function removeImage(index) { uploadedImages.splice(index, 1); renderPreviews(); }

function renderPreviews() {
  const c = document.getElementById('image-preview-container');
  c.innerHTML = uploadedImages.map((url, i) => `
    <div class="relative">
      <img src="${url}" class="w-16 h-16 object-cover rounded-lg border border-zinc-700"/>
      <button type="button" onclick="removeImage(${i})" class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white rounded-full text-xs flex items-center justify-center font-bold">×</button>
    </div>`).join('');
}

// ---- CRUD ----
async function saveProduct(e) {
  e.preventDefault();
  if(!uploadedImages.length) { alert("Please upload at least one image"); return; }
  const btn = document.getElementById('save-btn');
  const orig = btn.textContent;
  btn.textContent = 'Saving...'; btn.disabled = true;
  const id = document.getElementById('p-id').value;
  const url = id ? `/api/products/${id}` : '/api/products';
  const body = {
    name: document.getElementById('p-name').value,
    description: document.getElementById('p-desc').value,
    price: parseFloat(document.getElementById('p-price').value),
    category: document.getElementById('p-cat').value,
    deliveryCharges: parseFloat(document.getElementById('p-delivery').value || 0),
    discountedPrice: parseFloat(document.getElementById('p-discounted-price').value || 0),
    images: uploadedImages,
    hasDiscount: document.getElementById('p-has-discount').checked,
    isFreeDelivery: document.getElementById('p-free-delivery').checked,
    isFeatured: document.getElementById('p-featured').checked,
    isLowInStock: document.getElementById('p-low-stock').checked,
    isOutOfStock: document.getElementById('p-out-stock').checked,
    variants: collectVariants(),
  };
  try {
    const res = await fetch(url, { method: id ? 'PUT' : 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const data = await res.json();
    if (res.ok && data.product) {
      closeModal();
      // Update DOM immediately — don't wait for Pusher
      const p = data.product;
      if (id) {
        // Update existing card
        const el = document.getElementById('product-card-' + id);
        if (el) el.outerHTML = renderProductCard(p);
        else loadProducts();
      } else {
        // Prepend new card
        const grid = document.getElementById('admin-products-grid');
        const emptyMsg = grid.querySelector('.col-span-full');
        if (emptyMsg) emptyMsg.remove();
        grid.insertAdjacentHTML('afterbegin', renderProductCard(p));
        allAdminProducts.unshift(p);
        document.getElementById('products-count').textContent = allAdminProducts.length + ' products total';
      }
    } else { alert(data.message || 'Error saving'); }
  } catch { alert('Network error'); }
  finally { btn.textContent = orig; btn.disabled = false; }
}

async function deleteProduct(id) {
  if (!confirm('Delete this product?')) return;
  const res = await fetch(`/api/products/${id}`, { method: 'DELETE' });
  if (res.ok) {
    // Remove card immediately
    const el = document.getElementById('product-card-' + id);
    if (el) el.remove();
    allAdminProducts = allAdminProducts.filter(p => p._id !== id);
    document.getElementById('products-count').textContent = allAdminProducts.length + ' products total';
    if (allAdminProducts.length === 0) {
      document.getElementById('admin-products-grid').innerHTML = '<div class="col-span-full text-center py-20 text-zinc-400">No products yet. Add your first product!</div>';
    }
  }
}

async function toggleFeatured(id) {
  const res = await fetch(`/api/products/${id}/toggle-featured`, { method: 'PATCH' });
  const data = await res.json();
  if (data.product) {
    const el = document.getElementById('product-card-' + id);
    if (el) el.outerHTML = renderProductCard(data.product);
  }
}
async function toggleStock(id) {
  const res = await fetch(`/api/products/${id}/toggle-out-of-stock`, { method: 'PATCH' });
  const data = await res.json();
  if (data.product) {
    const el = document.getElementById('product-card-' + id);
    if (el) el.outerHTML = renderProductCard(data.product);
  }
}
</script>

<!-- Pusher: update grid WITHOUT any page reload -->
<script src="https://js.pusher.com/8.2.0/pusher.min.js"></script>
<script>
const pusherAdmin = new Pusher('<%= pusherKey %>', { cluster: '<%= pusherCluster %>' });
const adminChannel = pusherAdmin.subscribe('mhq-reseller');

// New product added → re-render full grid (lightweight, no reload)
adminChannel.bind('product:new', () => loadProducts());

// Product updated → update only that one card
adminChannel.bind('product:updated', (data) => {
  if (data && data._id) {
    // Fetch the single updated product and re-render its card
    fetch('/api/products/' + data._id)
      .then(r => r.json())
      .then(p => {
        const el = document.getElementById('product-card-' + p._id);
        if (el) {
          el.outerHTML = renderProductCard(p);
        } else {
          loadProducts(); // card not found, do full reload
        }
      }).catch(() => loadProducts());
  } else {
    loadProducts();
  }
});

// Product deleted → remove card from DOM instantly
adminChannel.bind('product:deleted', (data) => {
  const id = data && data.id ? data.id : null;
  if (id) {
    const el = document.getElementById('product-card-' + id);
    if (el) {
      el.remove();
      const remaining = document.querySelectorAll('.product-card').length;
      document.getElementById('products-count').textContent = remaining + ' products total';
      if (remaining === 0) {
        document.getElementById('admin-products-grid').innerHTML = '<div class="col-span-full text-center py-20 text-zinc-400">No products yet. Add your first product!</div>';
      }
    }
  } else {
    loadProducts();
  }
});
// --- Variant Builder Logic ---
let variantGroupIndex = 0;

function addVariantGroup(data = null) {
  const container = document.getElementById('variants-container');
  const gId = variantGroupIndex++;
  const label = data ? data.label : '';
  
  const html = `
    <div id="v-group-${gId}" class="bg-zinc-800/50 border border-zinc-700 rounded-lg p-3 relative">
      <button type="button" onclick="document.getElementById('v-group-${gId}').remove()" class="absolute top-3 right-3 text-red-400 hover:text-red-300">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <div class="mb-3 pr-8">
        <label class="text-xs text-zinc-400 block mb-1">Variant Name (e.g. Color, Size)</label>
        <input type="text" class="w-full bg-zinc-900 border border-zinc-600 rounded-lg px-3 py-1.5 text-white text-sm focus:border-amber-500 outline-none v-label" value="${label}" placeholder="e.g. Size" required/>
      </div>
      <div id="v-options-${gId}" class="space-y-2 mb-2"></div>
      <button type="button" onclick="addVariantOption(${gId})" class="text-xs text-amber-500 hover:text-amber-400">+ Add Option</button>
    </div>
  `;
  container.insertAdjacentHTML('beforeend', html);
  
  if (data && data.options) {
    data.options.forEach(opt => addVariantOption(gId, opt));
  } else {
    addVariantOption(gId);
  }
}

function addVariantOption(gId, optData = null) {
  const container = document.getElementById(`v-options-${gId}`);
  const optId = Math.random().toString(36).substr(2, 9);
  const name = optData ? optData.name : '';
  const price = optData && optData.extraPrice ? optData.extraPrice : 0;
  
  const html = `
    <div id="v-opt-${optId}" class="flex items-center gap-2">
      <input type="text" class="flex-1 bg-zinc-900 border border-zinc-600 rounded-lg px-3 py-1 text-white text-sm focus:border-amber-500 outline-none v-opt-name" value="${name}" placeholder="Option (e.g. XL, Red)" required/>
      <div class="relative w-28">
        <span class="absolute left-2 top-1.5 text-zinc-500 text-xs">+Rs</span>
        <input type="number" class="w-full bg-zinc-900 border border-zinc-600 rounded-lg pl-8 pr-2 py-1 text-white text-sm focus:border-amber-500 outline-none v-opt-price" value="${price}" placeholder="0"/>
      </div>
      <button type="button" onclick="document.getElementById('v-opt-${optId}').remove()" class="text-red-400 hover:text-red-300 p-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      </button>
    </div>
  `;
  container.insertAdjacentHTML('beforeend', html);
}

function collectVariants() {
  const groups = [];
  document.querySelectorAll('[id^="v-group-"]').forEach(g => {
    const label = g.querySelector('.v-label').value.trim();
    if (!label) return;
    const options = [];
    g.querySelectorAll('[id^="v-opt-"]').forEach(opt => {
      const name = opt.querySelector('.v-opt-name').value.trim();
      const extraPrice = parseFloat(opt.querySelector('.v-opt-price').value) || 0;
      if (name) options.push({ name, extraPrice });
    });
    if (options.length > 0) groups.push({ label, options });
  });
  return groups;
}

function previewDiscount() {
  const p = parseFloat(document.getElementById('p-price').value) || 0;
  const dp = parseFloat(document.getElementById('p-discounted-price').value) || 0;
  const preview = document.getElementById('discount-calc-preview');
  
  if (document.getElementById('p-has-discount').checked && dp > 0 && p > dp) {
    const pct = Math.round((p - dp) / p * 100);
    preview.textContent = `= ${pct}% OFF`;
  } else {
    preview.textContent = '';
  }
}

// Watch base price changes to update discount preview
document.getElementById('p-price').addEventListener('input', previewDiscount);
document.getElementById('p-has-discount').addEventListener('change', previewDiscount);
</script>
