<div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-white mb-1">Orders Management</h1>
      <p class="text-zinc-400 text-sm">View, track, print slips, and manage discounts on customer orders</p>
    </div>
    <div class="flex items-center gap-3 w-full sm:w-auto">
      <button onclick="bulkDeleteOrders()" id="bulk-delete-btn" class="hidden px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl transition-colors text-sm shadow-lg shadow-red-600/20">
        Delete Selected
      </button>
      <button onclick="openAddOrderModal()" class="px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-xl transition-colors flex items-center gap-2 text-sm shadow-lg shadow-amber-600/20">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Add Order
      </button>
    </div>
  </div>

  <div class="flex items-center gap-2 mb-4" id="select-all-container">
    <input type="checkbox" id="select-all-orders" onchange="toggleSelectAllOrders(this.checked)" class="w-4 h-4 rounded border-zinc-700 bg-zinc-800 accent-amber-500 cursor-pointer" />
    <label for="select-all-orders" class="text-sm text-zinc-400 cursor-pointer">Select All Orders</label>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="orders-grid">
    <% orders.forEach(o => { 
      const b64 = Buffer.from(unescape(encodeURIComponent(JSON.stringify(o)))).toString('base64');
      const payMethod = o.paymentMethod || 'COD';
      const isPSA = payMethod === 'Pay Some Advance';
      const isAdv = payMethod === 'Advance Payment';
    %>
    <div class="bg-zinc-900 border border-zinc-700/80 rounded-2xl p-5 flex flex-col justify-between shadow-xl relative" id="order-card-<%= o._id %>">
      
      <!-- Card Header: Cleanly aligned with checkbox and status -->
      <div>
        <div class="flex items-start justify-between gap-3 mb-3 border-b border-zinc-800 pb-3">
          <div class="flex items-start gap-2.5 min-w-0">
            <input type="checkbox" class="order-select-cb w-4 h-4 mt-1 rounded border-zinc-600 bg-zinc-800 accent-amber-500 cursor-pointer flex-shrink-0" value="<%= o._id %>" onchange="updateBulkDeleteOrdersBtn()" />
            <div class="min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-xs font-mono text-amber-400 bg-amber-500/10 border border-amber-500/30 px-2 py-0.5 rounded-md font-bold inline-block">
                  <%= o.orderId || ('#' + o._id.toString().slice(-6)) %>
                </span>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border
                  <%= isAdv ? 'bg-emerald-500/15 border-emerald-500/30 text-emerald-400' : isPSA ? 'bg-amber-500/15 border-amber-500/30 text-amber-400' : 'bg-blue-500/15 border-blue-500/30 text-blue-400' %>">
                  <%= payMethod === 'COD' ? 'COD (6%)' : payMethod === 'Pay Some Advance' ? 'PSA (4%)' : 'Advance (2%)' %>
                </span>
              </div>
              <p class="text-[11px] text-zinc-500 mt-1"><%= new Date(o.createdAt).toLocaleString('en-PK', { timeZone: 'Asia/Karachi', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true }) %></p>
            </div>
          </div>

          <select onchange="updateOrderStatus('<%= o._id %>', this.value)" class="flex-shrink-0 bg-zinc-800 border border-zinc-700 text-white text-xs rounded-xl px-2.5 py-1.5 outline-none focus:border-amber-500 font-semibold
            <%= o.status === 'Pending' || o.status === 'Pending Payment' ? 'text-amber-400' : '' %>
            <%= o.status === 'Delivered' ? 'text-green-400' : '' %>
            <%= o.status === 'Canceled' || o.status === 'Payment Declined' ? 'text-red-400' : '' %>">
            <option value="Pending" <%= o.status==='Pending'?'selected':'' %>>Pending</option>
            <option value="Pending Payment" <%= o.status==='Pending Payment'?'selected':'' %>>Pending Payment</option>
            <option value="Packed" <%= o.status==='Packed'?'selected':'' %>>Packed</option>
            <option value="Ready to Ship" <%= o.status==='Ready to Ship'?'selected':'' %>>Ready to Ship</option>
            <option value="On Route" <%= o.status==='On Route'?'selected':'' %>>On Route</option>
            <option value="Out for Delivery" <%= o.status==='Out for Delivery'?'selected':'' %>>Out for Delivery</option>
            <option value="Delivered" <%= o.status==='Delivered'?'selected':'' %>>Delivered</option>
            <option value="Canceled" <%= o.status==='Canceled'?'selected':'' %>>Canceled</option>
          </select>
        </div>

        <div class="mb-3">
          <p class="text-xs text-zinc-500 mb-0.5">Customer</p>
          <p class="text-sm text-white font-bold"><%= o.customerDetails ? o.customerDetails.fullName : 'Customer' %></p>
          <p class="text-xs text-zinc-400 font-mono"><%= o.customerDetails ? o.customerDetails.phoneNo : '-' %></p>
        </div>

        <div class="mb-4">
          <p class="text-xs text-zinc-500 mb-1.5 font-medium">Items (<%= o.products.length %>)</p>
          <div class="space-y-1.5">
            <% o.products.slice(0,2).forEach(p => { 
              const origP = p.originalBasePrice || p.priceAtPurchase;
              const hasDisc = origP > p.priceAtPurchase;
              const hasCompDisc = (p.companyDiscountedPrice && p.companyDiscountedPrice > 0 && p.companyDiscountedPrice < p.priceAtPurchase);
            %>
            <div class="flex justify-between items-center text-xs bg-zinc-800/40 p-2 rounded-xl border border-zinc-800">
              <span class="text-zinc-300 truncate pr-2">
                <%= p.quantity %>x <%= p.product ? p.product.name : 'Product' %>
                <%= p.selectedVariant ? ` (${p.selectedVariant})` : '' %>
              </span>
              <div class="text-right flex-shrink-0">
                <% if (hasCompDisc) { %>
                  <span class="text-zinc-500 text-[10px] line-through mr-1">Rs <%= p.priceAtPurchase * p.quantity %></span>
                  <span class="text-amber-400 font-bold">Rs <%= p.companyDiscountedPrice * p.quantity %></span>
                <% } else if (hasDisc) { %>
                  <span class="text-zinc-500 text-[10px] line-through mr-1">Rs <%= origP * p.quantity %></span>
                  <span class="text-amber-400 font-bold">Rs <%= p.priceAtPurchase * p.quantity %></span>
                <% } else { %>
                  <span class="text-zinc-300 font-medium">Rs <%= p.priceAtPurchase * p.quantity %></span>
                <% } %>
              </div>
            </div>
            <% }) %>
            <% if(o.products.length > 2) { %>
              <p class="text-xs text-zinc-500 italic">+ <%= o.products.length - 2 %> more items</p>
            <% } %>
          </div>
        </div>
      </div>

      <div class="pt-3 border-t border-zinc-800">
        <div class="flex items-center justify-between mb-3">
          <div>
            <p class="text-xs text-zinc-500">Total Amount</p>
            <div class="flex items-baseline gap-2">
              <p class="text-lg font-bold text-amber-400">Rs <%= Number(o.totalAmount).toLocaleString() %></p>
              <% if (o.companyDiscount > 0) { %>
                <span class="text-[10px] text-emerald-400 font-semibold bg-emerald-500/10 px-1.5 py-0.5 rounded">(-Rs <%= o.companyDiscount %> Disc)</span>
              <% } %>
            </div>
            <% if (isPSA) { %>
              <p class="text-[11px] text-zinc-400">Due on Delivery: <span class="text-white font-bold">Rs <%= (o.totalDueAmount !== undefined ? o.totalDueAmount : (o.totalAmount - (o.advanceAmount || 0))).toLocaleString() %></span></p>
            <% } %>
          </div>
          <div class="flex items-center gap-1.5">
            <button onclick="openDiscountModal('<%= b64 %>')" class="bg-amber-600/20 hover:bg-amber-600/30 text-amber-400 border border-amber-600/30 text-xs px-2.5 py-1.5 rounded-lg transition-colors font-medium flex items-center gap-1" title="Set Order & Product Discounts">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
              Discount
            </button>
            <button onclick="printSlip('<%= b64 %>')" class="bg-zinc-800 hover:bg-zinc-700 text-white text-xs px-2.5 py-1.5 rounded-lg transition-colors font-medium flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
              Slip
            </button>
          </div>
        </div>

        <div class="flex gap-2">
          <button onclick="viewOrderDetails('<%= b64 %>')" class="flex-1 bg-zinc-800 hover:bg-zinc-700 text-white font-medium py-2 rounded-xl text-xs transition-colors border border-zinc-700">
            View Details
          </button>
          <button onclick="deleteOrder('<%= o._id %>')" class="flex-1 bg-red-600/20 hover:bg-red-600/30 text-red-400 font-medium py-2 rounded-xl text-xs transition-colors border border-red-500/20">
            Delete
          </button>
        </div>
      </div>
    </div>
    <% }) %>

    <% if(orders.length === 0) { %>
    <div class="col-span-full text-center py-20 text-zinc-500 bg-zinc-900/40 rounded-3xl border border-zinc-800">No orders found.</div>
    <% } %>
  </div>
</div>

<!-- View Order Modal -->
<div id="view-order-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
  <div class="bg-zinc-900 border border-zinc-700 rounded-2xl p-6 w-full max-w-2xl max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-6 border-b border-zinc-800 pb-3">
      <h2 class="text-xl font-bold text-white">Order Details</h2>
      <button onclick="document.getElementById('view-order-modal').classList.add('hidden')" class="text-zinc-400 hover:text-white"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>
    <div id="view-order-content" class="text-sm text-zinc-300 space-y-6"></div>
  </div>
</div>

<!-- Order Discount Modal -->
<div id="discount-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
  <div class="bg-zinc-900 border border-zinc-700 rounded-3xl p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto shadow-2xl">
    <div class="flex justify-between items-center mb-4 border-b border-zinc-800 pb-3">
      <div>
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
          Set Order & Product Discounts
        </h2>
        <p class="text-xs text-zinc-400" id="discount-modal-order-id">-</p>
      </div>
      <button onclick="closeDiscountModal()" class="text-zinc-400 hover:text-white">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="discount-form" onsubmit="submitDiscount(event)" class="space-y-4">
      <input type="hidden" id="discount-order-id" />
      
      <div>
        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Discount per Product</label>
        <div id="discount-products-list" class="space-y-2.5 max-h-56 overflow-y-auto pr-1">
          <!-- Populated dynamically -->
        </div>
      </div>

      <div class="border-t border-zinc-800 pt-3">
        <label class="block text-xs font-semibold text-zinc-300 mb-1">Overall Order Discount (Rs)</label>
        <p class="text-[11px] text-zinc-500 mb-1.5">Applied in addition to product discounts (e.g. 100 for Rs 100 flat off)</p>
        <input type="number" id="discount-overall-input" min="0" placeholder="0" value="" class="w-full bg-zinc-800 border border-zinc-700 focus:border-amber-500 text-white rounded-xl px-4 py-2.5 text-sm outline-none" oninput="recalcDiscountPreview()" />
      </div>

      <div class="bg-zinc-950 p-3.5 rounded-xl border border-zinc-800 space-y-1.5 text-xs">
        <div class="flex justify-between text-zinc-400">
          <span>Items Total:</span>
          <span id="disc-preview-items">Rs 0</span>
        </div>
        <div class="flex justify-between text-zinc-400">
          <span>Delivery & Tax:</span>
          <span id="disc-preview-extras">Rs 0</span>
        </div>
        <div class="flex justify-between text-amber-400 font-semibold">
          <span>Overall Company Discount:</span>
          <span id="disc-preview-overall">- Rs 0</span>
        </div>
        <div class="flex justify-between text-white font-bold text-sm border-t border-zinc-800 pt-1.5">
          <span>New Total Payable:</span>
          <span id="disc-preview-total" class="text-amber-400 font-black">Rs 0</span>
        </div>
      </div>

      <div class="flex gap-3 pt-2">
        <button type="button" onclick="closeDiscountModal()" class="flex-1 py-2.5 border border-zinc-700 text-zinc-400 hover:text-white rounded-xl text-xs font-medium transition-colors">Cancel</button>
        <button type="submit" id="discount-save-btn" class="flex-1 py-2.5 bg-amber-600 hover:bg-amber-500 text-white rounded-xl text-xs font-bold transition-colors">Apply Discount</button>
      </div>
    </form>
  </div>
</div>

<!-- Add Order Modal (Customer details OPTIONAL, Order status dropdown, No default 0s) -->
<div id="add-order-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-black/85 backdrop-blur-md">
  <div class="bg-zinc-950 border border-zinc-700 rounded-3xl p-5 sm:p-7 w-full max-w-4xl max-h-[92vh] overflow-y-auto shadow-2xl">
    <div class="flex justify-between items-center mb-6 border-b border-zinc-800 pb-3">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-white">Create New Order (Admin)</h2>
        <p class="text-xs text-zinc-400">Customer details are optional for admin orders • No email sent for admin orders</p>
      </div>
      <button onclick="closeAddOrderModal()" class="w-9 h-9 rounded-full bg-zinc-900 hover:bg-zinc-800 flex items-center justify-center text-zinc-400 hover:text-white transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="add-order-form" onsubmit="submitAddOrder(event)">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Customer Details (Optional) -->
        <div>
          <h3 class="text-amber-400 font-bold mb-3 border-b border-zinc-800 pb-2 text-sm uppercase tracking-wider flex items-center justify-between">
            <span>Customer Details</span>
            <span class="text-[11px] text-zinc-500 font-normal lowercase">(optional)</span>
          </h3>
          <div class="space-y-3">
            <div>
              <label class="block text-xs text-zinc-400 mb-1">Full Name (Optional)</label>
              <input type="text" id="ao-name" class="w-full bg-zinc-900 border border-zinc-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:border-amber-500 outline-none" placeholder="Walk-in Customer / Name" />
            </div>
            <div>
              <label class="block text-xs text-zinc-400 mb-1">Phone No (Optional)</label>
              <input type="tel" id="ao-phone" class="w-full bg-zinc-900 border border-zinc-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:border-amber-500 outline-none" placeholder="03XXXXXXXXX" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs text-zinc-400 mb-1">House No (Optional)</label>
                <input type="text" id="ao-house" class="w-full bg-zinc-900 border border-zinc-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:border-amber-500 outline-none" placeholder="House #" />
              </div>
              <div>
                <label class="block text-xs text-zinc-400 mb-1">Street (Optional)</label>
                <input type="text" id="ao-street" class="w-full bg-zinc-900 border border-zinc-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:border-amber-500 outline-none" placeholder="Street" />
              </div>
            </div>
            <div>
              <label class="block text-xs text-zinc-400 mb-1">Area Name (Optional)</label>
              <input type="text" id="ao-area" class="w-full bg-zinc-900 border border-zinc-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:border-amber-500 outline-none" placeholder="Area / Town" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs text-zinc-400 mb-1">City (Optional)</label>
                <input type="text" id="ao-city" class="w-full bg-zinc-900 border border-zinc-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:border-amber-500 outline-none" placeholder="City" />
              </div>
              <div>
                <label class="block text-xs text-zinc-400 mb-1">Province (Optional)</label>
                <select id="ao-province" class="w-full bg-zinc-900 border border-zinc-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:border-amber-500 outline-none">
                  <option value="">Select (Optional)</option>
                  <option>Sindh</option><option>Punjab</option><option>KPK</option>
                  <option>Balochistan</option><option>Islamabad</option>
                  <option>AJK</option><option>Gilgit-Baltistan</option>
                </select>
              </div>
            </div>
            <div>
              <label class="block text-xs text-zinc-400 mb-1">Famous Place / Landmark (Optional)</label>
              <input type="text" id="ao-landmark" class="w-full bg-zinc-900 border border-zinc-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:border-amber-500 outline-none" placeholder="Landmark" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs text-zinc-400 mb-1">Payment Method</label>
                <select id="ao-payment-method" class="w-full bg-zinc-900 border border-zinc-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:border-amber-500 outline-none" onchange="renderOrderProducts()">
                  <option value="COD">Cash on Delivery (6% Tax)</option>
                  <option value="Pay Some Advance">Pay Some Advance (4% Tax)</option>
                  <option value="Advance Payment">Advance Payment (2% Tax)</option>
                </select>
              </div>
              <div>
                <label class="block text-xs text-zinc-400 mb-1">Initial Status (Optional)</label>
                <select id="ao-order-status" class="w-full bg-zinc-900 border border-zinc-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:border-amber-500 outline-none">
                  <option value="Pending">Pending (Default)</option>
                  <option value="Packed">Packed</option>
                  <option value="Ready to Ship">Ready to Ship</option>
                  <option value="On Route">On Route</option>
                  <option value="Out for Delivery">Out for Delivery</option>
                  <option value="Delivered">Delivered</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <!-- Products Selection -->
        <div class="flex flex-col">
          <h3 class="text-amber-400 font-bold mb-3 border-b border-zinc-800 pb-2 text-sm uppercase tracking-wider">Products Selection</h3>
          
          <div class="mb-3 relative">
            <label class="block text-xs text-zinc-400 mb-1">Search & Select Products</label>
            <input type="text" id="ao-product-search" onkeyup="searchProducts(this.value)" class="w-full bg-zinc-900 border border-zinc-700 text-white rounded-xl px-3.5 py-2.5 text-sm focus:border-amber-500 outline-none" placeholder="Type to search products..." autocomplete="off" />
            <div id="ao-search-results" class="absolute left-0 right-0 top-14 bg-zinc-900 border border-zinc-700 rounded-xl shadow-2xl z-50 max-h-56 overflow-y-auto hidden divide-y divide-zinc-800"></div>
          </div>

          <!-- Selected Products Container -->
          <div class="flex-1 bg-zinc-900/40 border border-zinc-800 rounded-2xl p-3 overflow-y-auto max-h-56 mb-3 space-y-2.5" id="ao-selected-products">
            <p class="text-zinc-500 text-xs text-center py-6">No products added yet.</p>
          </div>

          <!-- Overall Order Discount in Add Order (No default 0!) -->
          <div class="p-3 bg-zinc-900/60 border border-zinc-800 rounded-xl mb-3 space-y-2">
            <div class="flex items-center justify-between">
              <label class="text-xs text-zinc-300 font-medium">Overall Order Discount (Rs)</label>
              <input type="number" id="ao-overall-discount" min="0" placeholder="0" value="" class="w-28 bg-zinc-800 border border-zinc-700 text-white text-right rounded-lg px-2.5 py-1 text-xs outline-none focus:border-amber-500 font-bold" oninput="renderOrderProducts()" />
            </div>
          </div>

          <div class="border-t border-zinc-800 pt-3 space-y-1 text-xs mb-4">
            <div class="flex justify-between text-zinc-400"><span>Items Subtotal:</span><span id="ao-subtotal">Rs 0</span></div>
            <div class="flex justify-between text-zinc-400"><span>Estimated Tax:</span><span id="ao-tax">Rs 0</span></div>
            <div class="flex justify-between text-amber-400 font-semibold" id="ao-discount-row"><span>Discount:</span><span id="ao-discount">- Rs 0</span></div>
            <div class="flex justify-between text-white font-bold text-base pt-1 border-t border-zinc-800">
              <span>Total Amount:</span>
              <span class="text-amber-400 font-black" id="ao-total-amount">Rs 0</span>
            </div>
          </div>

          <button type="submit" id="ao-submit-btn" class="w-full py-3.5 bg-amber-600 hover:bg-amber-500 text-white font-bold rounded-full transition-all text-sm shadow-xl shadow-amber-600/30">
            Create Order
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Print iframe (hidden) -->
<iframe id="print-frame" class="hidden"></iframe>

<script>
let allProducts = [];
let selectedOrderProducts = [];
let currentDiscountOrder = null;

async function updateOrderStatus(id, status) {
  try {
    const res = await fetch(`/api/orders/${id}/status`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status })
    });
    if (res.ok) {
      // Instantly refresh admin sidebar badges
      if (typeof refreshAdminBadges === 'function') refreshAdminBadges();
    }
  } catch(e) { alert('Failed to update status'); }
}

function viewOrderDetails(b64Data) {
  const o = JSON.parse(decodeURIComponent(escape(atob(b64Data))));
  let subtotal = 0;
  let totalDC = 0;

  let itemsHtml = o.products.map(p => {
    const unitPrice = (p.companyDiscountedPrice && p.companyDiscountedPrice > 0) ? p.companyDiscountedPrice : p.priceAtPurchase;
    const pSubtotal = p.quantity * unitPrice;
    subtotal += pSubtotal;
    const dc = p.isFreeDelivery ? 0 : (p.deliveryCharges || 0);
    totalDC += dc;

    const prodImg = (p.product && p.product.images && p.product.images.length) ? p.product.images[0] : '';
    const hasCompDisc = (p.companyDiscountedPrice && p.companyDiscountedPrice > 0 && p.companyDiscountedPrice < p.priceAtPurchase);
    const origP = p.originalBasePrice || p.priceAtPurchase;
    const hasBaseDisc = origP > p.priceAtPurchase;

    return `
      <div class="flex flex-col sm:flex-row sm:items-center justify-between bg-zinc-800/80 p-3 rounded-xl gap-4 border border-zinc-700/60">
        <div class="flex items-center gap-3">
          ${prodImg ? `<img src="${prodImg}" class="w-14 h-14 rounded-lg bg-zinc-700 object-cover flex-shrink-0" />` : '<div class="w-14 h-14 rounded-lg bg-zinc-700 flex-shrink-0"></div>'}
          <div class="flex-1 min-w-0">
            <p class="text-sm font-bold text-white truncate">${p.product ? p.product.name : 'Product'}</p>
            ${p.selectedVariant ? `<p class="text-xs text-amber-500 font-medium">${p.selectedVariant}</p>` : ''}
            <div class="mt-1">
              ${hasBaseDisc ? `<div class="text-[11px] text-zinc-500 line-through leading-tight">Rs ${origP}</div>` : ''}
              <div class="text-xs text-amber-400 font-bold leading-tight">Rs ${p.priceAtPurchase} <span class="text-zinc-400 font-normal text-[11px]">× ${p.quantity}</span></div>
            </div>
            ${hasCompDisc ? `<span class="inline-block mt-1 text-[10px] text-amber-400 font-semibold bg-amber-500/10 px-1.5 py-0.5 rounded">Discounted by Company: Rs ${p.companyDiscountedPrice}</span>` : ''}
            ${p.isFreeDelivery ? `<p class="text-[10px] text-emerald-400 font-medium mt-0.5">Free Delivery</p>` : (dc > 0 ? `<p class="text-[10px] text-zinc-500 font-medium mt-0.5">Delivery: Rs ${dc}</p>` : '')}
          </div>
        </div>
        <div class="text-left sm:text-right flex-shrink-0">
          ${hasBaseDisc ? `<p class="text-zinc-500 line-through text-[11px] leading-tight">Rs ${(origP * p.quantity).toLocaleString()}</p>` : ''}
          <p class="font-bold text-amber-400 text-sm leading-tight">Rs ${pSubtotal.toLocaleString()}</p>
        </div>
      </div>
    `;
  }).join('');

  document.getElementById('view-order-content').innerHTML = `
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 border-b border-zinc-800 pb-5">
      <div>
        <h3 class="text-amber-500 font-bold mb-2 text-xs uppercase tracking-wider">Customer Info</h3>
        <p class="text-sm mb-1"><span class="text-zinc-500">Name:</span> <span class="text-white font-medium">${o.customerDetails ? o.customerDetails.fullName : '-'}</span></p>
        <p class="text-sm mb-1"><span class="text-zinc-500">Phone:</span> <span class="text-white font-mono">${o.customerDetails ? o.customerDetails.phoneNo : '-'}</span></p>
        <p class="text-sm mb-1"><span class="text-zinc-500">Email:</span> <span class="text-white">${o.customerDetails ? o.customerDetails.email || '-' : '-'}</span></p>
        <p class="text-sm"><span class="text-zinc-500">Payment:</span> <span class="text-amber-400 font-bold">${o.paymentMethod || 'COD'} (${o.paymentStatus || 'Pending'})</span></p>
      </div>
      <div>
        <h3 class="text-amber-500 font-bold mb-2 text-xs uppercase tracking-wider">Delivery Address</h3>
        <p class="text-sm mb-1 text-white">${o.customerDetails ? `${o.customerDetails.houseNo || ''}, ${o.customerDetails.streetNameNo || ''}` : '-'}</p>
        <p class="text-sm mb-1 text-white">${o.customerDetails ? o.customerDetails.areaName || '' : '-'}</p>
        <p class="text-sm mb-1 text-white">${o.customerDetails ? `${o.customerDetails.city || ''}, ${o.customerDetails.province || ''}` : '-'}</p>
        ${o.customerDetails && o.customerDetails.famousPlace ? `<p class="text-sm text-zinc-400">Landmark: ${o.customerDetails.famousPlace}</p>` : ''}
      </div>
    </div>
    
    <div>
      <h3 class="text-amber-500 font-bold mb-3 text-xs uppercase tracking-wider">Order Items</h3>
      <div class="space-y-2.5">${itemsHtml}</div>
    </div>

    <div class="mt-5 pt-4 border-t border-zinc-800 flex flex-col items-end">
      <div class="w-full sm:w-1/2 space-y-1.5 text-xs">
        <div class="flex justify-between text-zinc-400"><span>Subtotal:</span><span>Rs ${subtotal.toLocaleString()}</span></div>
        <div class="flex justify-between text-zinc-400"><span>Delivery:</span><span>Rs ${totalDC.toLocaleString()}</span></div>
        ${o.salesTax ? `<div class="flex justify-between text-zinc-400"><span>Sales Tax:</span><span>Rs ${o.salesTax.toLocaleString()}</span></div>` : ''}
        ${o.companyDiscount > 0 ? `<div class="flex justify-between text-amber-400 font-semibold"><span>Company Discount:</span><span>- Rs ${o.companyDiscount.toLocaleString()}</span></div>` : ''}
        <div class="flex justify-between text-base text-white font-bold pt-2 border-t border-zinc-800">
          <span>Grand Total:</span>
          <span class="text-amber-400 font-black">Rs ${Number(o.totalAmount).toLocaleString()}</span>
        </div>
        ${o.paymentMethod === 'Pay Some Advance' ? `
          <div class="flex justify-between text-emerald-400 font-semibold pt-1"><span>Advance Paid:</span><span>Rs ${(o.advanceAmount || 0).toLocaleString()}</span></div>
          <div class="flex justify-between text-white font-bold"><span>Balance Due on Delivery:</span><span>Rs ${(o.totalDueAmount !== undefined ? o.totalDueAmount : (o.totalAmount - (o.advanceAmount || 0))).toLocaleString()}</span></div>
        ` : ''}
      </div>
    </div>
  `;
  document.getElementById('view-order-modal').classList.remove('hidden');
}

// ---- Discount Modal Logic ----
function openDiscountModal(b64Data) {
  const o = JSON.parse(decodeURIComponent(escape(atob(b64Data))));
  currentDiscountOrder = o;

  document.getElementById('discount-order-id').value = o._id;
  document.getElementById('discount-modal-order-id').textContent = `Order: ${o.orderId || ('#' + o._id.slice(-6))}`;
  document.getElementById('discount-overall-input').value = o.companyDiscount > 0 ? o.companyDiscount : '';

  const list = document.getElementById('discount-products-list');
  list.innerHTML = (o.products || []).map(p => {
    const prodId = p.product ? (p.product._id || p.product) : p._id;
    const name = p.product ? p.product.name : 'Product';
    const img = (p.product && p.product.images && p.product.images.length) ? p.product.images[0] : '';

    return `
      <div class="flex items-center justify-between gap-3 p-2.5 rounded-xl bg-zinc-950 border border-zinc-800 text-xs">
        <div class="flex items-center gap-2 min-w-0">
          ${img ? `<img src="${img}" class="w-10 h-10 rounded-lg object-cover bg-zinc-800 flex-shrink-0" />` : '<div class="w-10 h-10 rounded-lg bg-zinc-800 flex-shrink-0"></div>'}
          <div class="min-w-0">
            <p class="text-white font-medium truncate">${name}</p>
            <p class="text-zinc-500 text-[11px]">Regular / Cart: Rs ${p.priceAtPurchase} × ${p.quantity}</p>
          </div>
        </div>
        <div class="flex items-center gap-1.5 flex-shrink-0">
          <span class="text-zinc-400 text-[11px]">Set Disc Price:</span>
          <input type="number" min="0" 
            data-product-id="${prodId}" 
            data-item-id="${p._id}" 
            data-qty="${p.quantity}" 
            data-base-price="${p.priceAtPurchase}" 
            value="${p.companyDiscountedPrice || ''}" 
            placeholder="${p.priceAtPurchase}" 
            class="w-20 bg-zinc-900 border border-zinc-700 text-white rounded-lg px-2 py-1 text-xs text-right font-bold focus:border-amber-500 outline-none disc-prod-input"
            oninput="recalcDiscountPreview()" />
        </div>
      </div>
    `;
  }).join('');

  recalcDiscountPreview();
  document.getElementById('discount-modal').classList.remove('hidden');
}

function closeDiscountModal() {
  document.getElementById('discount-modal').classList.add('hidden');
}

function recalcDiscountPreview() {
  if (!currentDiscountOrder) return;
  
  let itemsTotal = 0;
  const prodInputs = document.querySelectorAll('.disc-prod-input');
  prodInputs.forEach(inp => {
    const qty = Number(inp.dataset.qty || 1);
    const basePrice = Number(inp.dataset.basePrice || 0);
    const overridePrice = parseFloat(inp.value);
    const effectivePrice = (!isNaN(overridePrice) && overridePrice > 0) ? overridePrice : basePrice;
    itemsTotal += effectivePrice * qty;
  });

  let extras = (currentDiscountOrder.salesTax || 0);
  (currentDiscountOrder.products || []).forEach(p => {
    if (!p.isFreeDelivery && p.deliveryCharges > 0) extras += p.deliveryCharges;
  });

  const overallDiscount = parseFloat(document.getElementById('discount-overall-input').value) || 0;
  const total = Math.max(0, itemsTotal + extras - overallDiscount);

  document.getElementById('disc-preview-items').textContent = 'Rs ' + itemsTotal.toLocaleString();
  document.getElementById('disc-preview-extras').textContent = 'Rs ' + extras.toLocaleString();
  document.getElementById('disc-preview-overall').textContent = '- Rs ' + overallDiscount.toLocaleString();
  document.getElementById('disc-preview-total').textContent = 'Rs ' + total.toLocaleString();
}

async function submitDiscount(e) {
  e.preventDefault();
  const orderId = document.getElementById('discount-order-id').value;
  const btn = document.getElementById('discount-save-btn');
  btn.textContent = 'Applying...';
  btn.disabled = true;

  const productDiscounts = [];
  document.querySelectorAll('.disc-prod-input').forEach(inp => {
    const val = parseFloat(inp.value);
    if (!isNaN(val) && val > 0) {
      productDiscounts.push({
        productId: inp.dataset.productId,
        productItemId: inp.dataset.itemId,
        companyDiscountedPrice: val
      });
    }
  });

  const overallDiscount = parseFloat(document.getElementById('discount-overall-input').value) || 0;

  try {
    const res = await fetch(`/api/orders/${orderId}/discount`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ orderDiscount: overallDiscount, productDiscounts })
    });
    const data = await res.json();
    if (res.ok && data.order) {
      closeDiscountModal();
      const card = document.getElementById('order-card-' + orderId);
      if (card) {
        card.outerHTML = createOrderCardHtml(data.order);
      }
    } else {
      alert(data.message || 'Failed to apply discount');
    }
  } catch (err) {
    alert('Network error');
  } finally {
    btn.textContent = 'Apply Discount';
    btn.disabled = false;
  }
}

// ---- Add Order Logic ----
async function openAddOrderModal() {
  document.getElementById('add-order-modal').classList.remove('hidden');
  document.getElementById('add-order-form').reset();
  document.getElementById('ao-overall-discount').value = '';
  selectedOrderProducts = [];
  renderOrderProducts();
  
  if(allProducts.length === 0) {
    try {
      const res = await fetch('/api/products');
      allProducts = await res.json();
    } catch(e) { console.error("Failed to load products for search"); }
  }
}

function closeAddOrderModal() {
  document.getElementById('add-order-modal').classList.add('hidden');
}

function searchProducts(query) {
  const resContainer = document.getElementById('ao-search-results');
  if(!query.trim()) { resContainer.classList.add('hidden'); return; }
  
  const q = query.toLowerCase();
  const filtered = allProducts.filter(p => p.name.toLowerCase().includes(q) && !p.isOutOfStock).slice(0, 7);
  
  if(filtered.length === 0) {
    resContainer.innerHTML = '<div class="p-3 text-xs text-zinc-400">No matching in-stock products found</div>';
  } else {
    resContainer.innerHTML = filtered.map(p => {
      const hasDisc = (p.hasDiscount && p.discountedPrice > 0 && p.discountedPrice < p.price);
      const effectivePrice = hasDisc ? p.discountedPrice : p.price;
      const img = (p.images && p.images.length) ? p.images[0] : '';
      const b64 = btoa(unescape(encodeURIComponent(JSON.stringify(p))));

      return `
        <div class="p-2.5 hover:bg-zinc-800 cursor-pointer flex items-center justify-between gap-3 transition-colors" onclick="addProductToOrder('${b64}')">
          <div class="flex items-center gap-2.5 min-w-0">
            ${img ? `<img src="${img}" class="w-10 h-10 rounded-lg object-cover bg-zinc-800 flex-shrink-0" />` : '<div class="w-10 h-10 rounded-lg bg-zinc-800 flex-shrink-0"></div>'}
            <div class="min-w-0">
              <p class="text-sm text-white font-medium truncate">${p.name}</p>
              ${hasDisc ? `<span class="text-[10px] text-amber-500 font-semibold">${p.discountPercent}% OFF</span>` : ''}
            </div>
          </div>
          <div class="text-right flex-shrink-0">
            ${hasDisc ? `
              <p class="text-xs text-zinc-500 line-through">Rs ${p.price}</p>
              <p class="text-xs text-amber-400 font-bold">Rs ${p.discountedPrice}</p>
            ` : `
              <p class="text-xs text-amber-400 font-bold">Rs ${p.price}</p>
            `}
          </div>
        </div>
      `;
    }).join('');
  }
  resContainer.classList.remove('hidden');
}

function addProductToOrder(b64Data) {
  const p = JSON.parse(decodeURIComponent(escape(atob(b64Data))));
  const hasDisc = (p.hasDiscount && p.discountedPrice > 0 && p.discountedPrice < p.price);
  const effectivePrice = hasDisc ? p.discountedPrice : p.price;

  const existing = selectedOrderProducts.find(item => item.product === p._id);
  if(existing) {
    existing.quantity++;
  } else {
    selectedOrderProducts.push({
      product: p._id,
      name: p.name,
      image: (p.images && p.images.length) ? p.images[0] : '',
      originalBasePrice: p.price,
      websiteDiscountedPrice: effectivePrice,
      priceAtPurchase: effectivePrice,
      companyDiscountedPrice: 0,
      deliveryCharges: p.deliveryCharges || 0,
      isFreeDelivery: Boolean(p.isFreeDelivery),
      quantity: 1
    });
  }
  
  document.getElementById('ao-product-search').value = '';
  document.getElementById('ao-search-results').classList.add('hidden');
  renderOrderProducts();
}

function changeOrderQty(prodId, delta) {
  const idx = selectedOrderProducts.findIndex(p => p.product === prodId);
  if(idx === -1) return;
  selectedOrderProducts[idx].quantity += delta;
  if(selectedOrderProducts[idx].quantity <= 0) {
    selectedOrderProducts.splice(idx, 1);
  }
  renderOrderProducts();
}

function updateCompanyProductDiscount(prodId, val) {
  const p = selectedOrderProducts.find(item => item.product === prodId);
  if (!p) return;
  const num = parseFloat(val);
  if (!isNaN(num) && num > 0) {
    p.companyDiscountedPrice = num;
  } else {
    p.companyDiscountedPrice = 0;
  }
  renderOrderProducts();
}

function renderOrderProducts() {
  const container = document.getElementById('ao-selected-products');
  let itemsSubtotal = 0;
  let deliveryTotal = 0;
  
  if(selectedOrderProducts.length === 0) {
    container.innerHTML = '<p class="text-zinc-500 text-xs text-center py-6">No products added yet.</p>';
  } else {
    container.innerHTML = selectedOrderProducts.map(p => {
      const unit = (p.companyDiscountedPrice > 0) ? p.companyDiscountedPrice : p.priceAtPurchase;
      itemsSubtotal += unit * p.quantity;
      if (!p.isFreeDelivery && p.deliveryCharges > 0) deliveryTotal += p.deliveryCharges;

      return `
      <div class="flex flex-col sm:flex-row sm:items-center justify-between bg-zinc-950 p-2.5 rounded-xl border border-zinc-800 gap-2 text-xs">
        <div class="flex items-center gap-2.5 min-w-0">
          ${p.image ? `<img src="${p.image}" class="w-10 h-10 rounded-lg object-cover bg-zinc-800 flex-shrink-0" />` : '<div class="w-10 h-10 rounded-lg bg-zinc-800 flex-shrink-0"></div>'}
          <div class="min-w-0">
            <p class="text-white font-medium truncate">${p.name}</p>
            <div class="flex items-center gap-2 mt-0.5">
              ${p.originalBasePrice > p.priceAtPurchase ? `<span class="text-zinc-500 line-through text-[11px]">Rs ${p.originalBasePrice}</span>` : ''}
              <span class="text-amber-400 font-bold">Rs ${unit}</span>
            </div>
          </div>
        </div>
        <div class="flex items-center justify-between sm:justify-end gap-3">
          <div class="flex items-center gap-1">
            <span class="text-[10px] text-zinc-500">Disc:</span>
            <input type="number" min="0" placeholder="Optional" value="${p.companyDiscountedPrice || ''}"
              onchange="updateCompanyProductDiscount('${p.product}', this.value)"
              class="w-16 bg-zinc-900 border border-zinc-700 text-white rounded px-1.5 py-0.5 text-xs text-right outline-none focus:border-amber-500" />
          </div>
          <div class="flex items-center gap-1.5 bg-zinc-900 rounded-full px-1 py-0.5 border border-zinc-700">
            <button type="button" onclick="changeOrderQty('${p.product}', -1)" class="w-5 h-5 rounded-full bg-zinc-800 text-white flex items-center justify-center font-bold text-xs">-</button>
            <span class="text-white w-4 text-center text-xs font-semibold">${p.quantity}</span>
            <button type="button" onclick="changeOrderQty('${p.product}', 1)" class="w-5 h-5 rounded-full bg-zinc-800 text-white flex items-center justify-center font-bold text-xs">+</button>
          </div>
          <span class="text-amber-400 font-bold w-16 text-right">Rs ${(unit * p.quantity).toLocaleString()}</span>
        </div>
      </div>
    `}).join('');
  }

  const payMethod = document.getElementById('ao-payment-method').value;
  let taxRate = 0.06;
  if (payMethod === 'Pay Some Advance') taxRate = 0.04;
  else if (payMethod === 'Advance Payment') taxRate = 0.02;

  const rawTotal = itemsSubtotal + deliveryTotal;
  const salesTax = Math.round(rawTotal * taxRate);
  const overallDiscount = parseFloat(document.getElementById('ao-overall-discount').value) || 0;
  const grandTotal = Math.max(0, rawTotal + salesTax - overallDiscount);

  document.getElementById('ao-subtotal').textContent = 'Rs ' + itemsSubtotal.toLocaleString();
  document.getElementById('ao-tax').textContent = `Rs ${salesTax.toLocaleString()} (${(taxRate * 100).toFixed(0)}%)`;
  document.getElementById('ao-discount').textContent = `- Rs ${overallDiscount.toLocaleString()}`;
  document.getElementById('ao-total-amount').textContent = 'Rs ' + grandTotal.toLocaleString();
}

async function submitAddOrder(e) {
  e.preventDefault();
  if(selectedOrderProducts.length === 0) return alert("Please select at least one product.");
  
  const btn = document.getElementById('ao-submit-btn');
  btn.textContent = 'Creating Order...';
  btn.disabled = true;

  const overallDiscount = parseFloat(document.getElementById('ao-overall-discount').value) || 0;
  const payMethod = document.getElementById('ao-payment-method').value;
  const chosenStatus = document.getElementById('ao-order-status').value || 'Pending';

  const productsPayload = selectedOrderProducts.map(p => ({
    product: p.product,
    quantity: p.quantity,
    priceAtPurchase: (p.companyDiscountedPrice > 0) ? p.companyDiscountedPrice : p.priceAtPurchase,
    originalBasePrice: p.originalBasePrice,
    websiteDiscountedPrice: p.websiteDiscountedPrice,
    companyDiscountedPrice: p.companyDiscountedPrice || 0,
    deliveryCharges: p.deliveryCharges || 0,
    isFreeDelivery: p.isFreeDelivery
  }));

  const payload = {
    customerDetails: {
      fullName: document.getElementById('ao-name').value.trim() || 'Walk-in Customer',
      phoneNo: document.getElementById('ao-phone').value.trim() || 'N/A',
      houseNo: document.getElementById('ao-house').value.trim() || '',
      streetNameNo: document.getElementById('ao-street').value.trim() || '',
      areaName: document.getElementById('ao-area').value.trim() || '',
      city: document.getElementById('ao-city').value.trim() || '',
      province: document.getElementById('ao-province').value || '',
      famousPlace: document.getElementById('ao-landmark').value.trim() || '',
      email: ""
    },
    products: productsPayload,
    paymentMethod: payMethod,
    companyDiscount: overallDiscount,
    status: chosenStatus,
    isAdminCreated: true // Prevents email notification
  };

  try {
    const res = await fetch('/api/orders', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    });
    if(res.ok) {
      const data = await res.json();
      closeAddOrderModal();
      if (data.order) prependOrderCard(data.order);
      if (typeof refreshAdminBadges === 'function') refreshAdminBadges();
    } else {
      const data = await res.json();
      alert(data.message || 'Error creating order');
    }
  } catch(err) {
    alert('Network error');
  } finally {
    btn.textContent = 'Create Order';
    btn.disabled = false;
  }
}

async function deleteOrder(id) {
  if(!confirm("Are you sure you want to delete this order?")) return;
  try {
    const res = await fetch(`/api/orders/${id}`, { method: 'DELETE' });
    if(res.ok) {
      const card = document.getElementById('order-card-' + id);
      if(card) card.remove();
      if (typeof refreshAdminBadges === 'function') refreshAdminBadges();
    } else {
      alert("Error deleting order");
    }
  } catch(e) {
    alert("Network error");
  }
}

function toggleSelectAllOrders(checked) {
  document.querySelectorAll('.order-select-cb').forEach(cb => cb.checked = checked);
  updateBulkDeleteOrdersBtn();
}

function updateBulkDeleteOrdersBtn() {
  const checked = document.querySelectorAll('.order-select-cb:checked');
  const btn = document.getElementById('bulk-delete-btn');
  if (checked.length > 0) {
    btn.classList.remove('hidden');
    btn.textContent = `Delete Selected (${checked.length})`;
  } else {
    btn.classList.add('hidden');
  }
}

async function bulkDeleteOrders() {
  const checked = document.querySelectorAll('.order-select-cb:checked');
  if (checked.length === 0) return;
  if (!confirm(`Are you sure you want to delete ${checked.length} orders?`)) return;
  
  const ids = Array.from(checked).map(cb => cb.value);
  const btn = document.getElementById('bulk-delete-btn');
  const origText = btn.textContent;
  btn.textContent = 'Deleting...';
  btn.disabled = true;
  
  try {
    const res = await fetch('/api/orders/bulk-delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ids })
    });
    if (res.ok) {
      ids.forEach(id => {
        const card = document.getElementById('order-card-' + id);
        if(card) card.remove();
      });
      document.getElementById('select-all-orders').checked = false;
      updateBulkDeleteOrdersBtn();
      if (typeof refreshAdminBadges === 'function') refreshAdminBadges();
    } else {
      const data = await res.json();
      alert(data.message || 'Error deleting orders');
    }
  } catch(e) { alert('Network error'); }
  finally {
    btn.disabled = false;
    btn.textContent = origText;
  }
}

// Function to render order card from JS object
function createOrderCardHtml(o) {
  const b64 = btoa(unescape(encodeURIComponent(JSON.stringify(o))));
  const payMethod = o.paymentMethod || 'COD';
  const isPSA = payMethod === 'Pay Some Advance';
  const isAdv = payMethod === 'Advance Payment';

  let productsHtml = o.products.slice(0,2).map(p => {
    const origP = p.originalBasePrice || p.priceAtPurchase;
    const hasDisc = origP > p.priceAtPurchase;
    const hasCompDisc = (p.companyDiscountedPrice && p.companyDiscountedPrice > 0 && p.companyDiscountedPrice < p.priceAtPurchase);

    return `
      <div class="flex justify-between items-center text-xs bg-zinc-800/40 p-2 rounded-xl border border-zinc-800">
        <span class="text-zinc-300 truncate pr-2">
          ${p.quantity}x ${p.product ? p.product.name : 'Product'}
          ${p.selectedVariant ? ` (${p.selectedVariant})` : ''}
        </span>
        <div class="text-right flex-shrink-0">
          ${hasCompDisc ? `
            <span class="text-zinc-500 text-[10px] line-through mr-1">Rs ${p.priceAtPurchase * p.quantity}</span>
            <span class="text-amber-400 font-bold">Rs ${p.companyDiscountedPrice * p.quantity}</span>
          ` : hasDisc ? `
            <span class="text-zinc-500 text-[10px] line-through mr-1">Rs ${origP * p.quantity}</span>
            <span class="text-amber-400 font-bold">Rs ${p.priceAtPurchase * p.quantity}</span>
          ` : `
            <span class="text-zinc-300 font-medium">Rs ${p.priceAtPurchase * p.quantity}</span>
          `}
        </div>
      </div>
    `;
  }).join('');
  if (o.products.length > 2) {
    productsHtml += `<p class="text-xs text-zinc-500 italic">+ ${o.products.length - 2} more items</p>`;
  }
  
  let statusColor = '';
  if (o.status === 'Pending' || o.status === 'Pending Payment') statusColor = 'text-amber-400';
  if (o.status === 'Delivered') statusColor = 'text-green-400';
  if (o.status === 'Canceled' || o.status === 'Payment Declined') statusColor = 'text-red-400';
  
  return `
    <div class="bg-zinc-900 border border-zinc-700/80 rounded-2xl p-5 flex flex-col justify-between shadow-xl relative" id="order-card-${o._id}">
      <div>
        <div class="flex items-start justify-between gap-3 mb-3 border-b border-zinc-800 pb-3">
          <div class="flex items-start gap-2.5 min-w-0">
            <input type="checkbox" class="order-select-cb w-4 h-4 mt-1 rounded border-zinc-600 bg-zinc-800 accent-amber-500 cursor-pointer flex-shrink-0" value="${o._id}" onchange="updateBulkDeleteOrdersBtn()" />
            <div class="min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-xs font-mono text-amber-400 bg-amber-500/10 border border-amber-500/30 px-2 py-0.5 rounded-md font-bold inline-block">
                  ${o.orderId || ('#' + o._id.toString().slice(-6))}
                </span>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border
                  ${isAdv ? 'bg-emerald-500/15 border-emerald-500/30 text-emerald-400' : isPSA ? 'bg-amber-500/15 border-amber-500/30 text-amber-400' : 'bg-blue-500/15 border-blue-500/30 text-blue-400'}">
                  ${payMethod === 'COD' ? 'COD (6%)' : payMethod === 'Pay Some Advance' ? 'PSA (4%)' : 'Advance (2%)'}
                </span>
              </div>
              <p class="text-[11px] text-zinc-500 mt-1">${new Date(o.createdAt).toLocaleString('en-PK', { timeZone: 'Asia/Karachi', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true })}</p>
            </div>
          </div>
          <select onchange="updateOrderStatus('${o._id}', this.value)" class="flex-shrink-0 bg-zinc-800 border border-zinc-700 text-white text-xs rounded-xl px-2.5 py-1.5 outline-none focus:border-amber-500 font-semibold ${statusColor}">
            ${['Pending','Pending Payment','Packed','Ready to Ship','On Route','Out for Delivery','Delivered','Canceled'].map(s => 
              `<option value="${s}" ${o.status === s ? 'selected' : ''}>${s}</option>`
            ).join('')}
          </select>
        </div>

        <div class="mb-3">
          <p class="text-xs text-zinc-500 mb-0.5">Customer</p>
          <p class="text-sm text-white font-bold">${o.customerDetails ? o.customerDetails.fullName : 'Customer'}</p>
          <p class="text-xs text-zinc-400 font-mono">${o.customerDetails ? o.customerDetails.phoneNo : '-'}</p>
        </div>

        <div class="mb-4">
          <p class="text-xs text-zinc-500 mb-1.5 font-medium">Items (${o.products.length})</p>
          <div class="space-y-1.5">
            ${productsHtml}
          </div>
        </div>
      </div>

      <div class="pt-3 border-t border-zinc-800">
        <div class="flex items-center justify-between mb-3">
          <div>
            <p class="text-xs text-zinc-500">Total Amount</p>
            <div class="flex items-baseline gap-2">
              <p class="text-lg font-bold text-amber-400">Rs ${Number(o.totalAmount).toLocaleString()}</p>
              ${o.companyDiscount > 0 ? `<span class="text-[10px] text-emerald-400 font-semibold bg-emerald-500/10 px-1.5 py-0.5 rounded">(-Rs ${o.companyDiscount} Disc)</span>` : ''}
            </div>
            ${isPSA ? `<p class="text-[11px] text-zinc-400">Due on Delivery: <span class="text-white font-bold">Rs ${(o.totalDueAmount !== undefined ? o.totalDueAmount : (o.totalAmount - (o.advanceAmount || 0))).toLocaleString()}</span></p>` : ''}
          </div>
          <div class="flex items-center gap-1.5">
            <button onclick="openDiscountModal('${b64}')" class="bg-amber-600/20 hover:bg-amber-600/30 text-amber-400 border border-amber-600/30 text-xs px-2.5 py-1.5 rounded-lg transition-colors font-medium flex items-center gap-1" title="Set Order & Product Discounts">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
              Discount
            </button>
            <button onclick="printSlip('${b64}')" class="bg-zinc-800 hover:bg-zinc-700 text-white text-xs px-2.5 py-1.5 rounded-lg transition-colors font-medium flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
              Slip
            </button>
          </div>
        </div>

        <div class="flex gap-2">
          <button onclick="viewOrderDetails('${b64}')" class="flex-1 bg-zinc-800 hover:bg-zinc-700 text-white font-medium py-2 rounded-xl text-xs transition-colors border border-zinc-700">
            View Details
          </button>
          <button onclick="deleteOrder('${o._id}')" class="flex-1 bg-red-600/20 hover:bg-red-600/30 text-red-400 font-medium py-2 rounded-xl text-xs transition-colors border border-red-500/20">
            Delete
          </button>
        </div>
      </div>
    </div>
  `;
}

function prependOrderCard(o) {
  const grid = document.getElementById('orders-grid');
  const empty = grid.querySelector('.col-span-full');
  if (empty) empty.remove();
  const existing = document.getElementById('order-card-' + o._id);
  if (existing) existing.remove();
  
  grid.insertAdjacentHTML('afterbegin', createOrderCardHtml(o));
}

// ---- Print Logic (Strict 3-Inch POS Thermal Receipt Format) ----
function printSlip(b64Data) {
  const o = JSON.parse(decodeURIComponent(escape(atob(b64Data))));
  const iframe = document.getElementById('print-frame');
  const d = new Date(o.createdAt).toLocaleString('en-PK', { timeZone: 'Asia/Karachi', dateStyle: 'short', timeStyle: 'short', hour12: true });
  const displayOrderId = o.orderId || ('#' + o._id.toString().slice(-6));
  const payMethod = o.paymentMethod || 'COD';
  
  let subtotal = 0;
  let totalDelivery = 0;
  let itemsHtml = '';

  (o.products || []).forEach(p => {
    const name = p.product ? p.product.name : 'Unknown Product';
    const variant = p.selectedVariant ? `<div style="font-size: 8.5px; color: #555;">[${p.selectedVariant}]</div>` : '';
    
    // Product discount logic per requirement:
    // Original price: smaller, lighter, with strikethrough
    // Discounted price: directly underneath
    const origBase = Number(p.originalBasePrice || p.priceAtPurchase);
    const effectivePrice = Number(p.priceAtPurchase);
    const hasProductDisc = (origBase > effectivePrice);
    const lineTotal = effectivePrice * p.quantity;
    subtotal += lineTotal;

    if (!p.isFreeDelivery && p.deliveryCharges > 0) {
      totalDelivery += p.deliveryCharges;
    }

    itemsHtml += `
      <tr>
        <td style="padding: 2.5px 0; border-bottom: 1px dashed #ddd; text-align: left; vertical-align: top;">
          <div style="font-weight: 700; font-size: 10px; line-height: 1.2;">${name}</div>
          ${variant}
          <div style="font-size: 8.5px; color: #555;">Qty: ${p.quantity}</div>
        </td>
        <td style="padding: 2.5px 0; border-bottom: 1px dashed #ddd; text-align: right; vertical-align: top; white-space: nowrap;">
          ${hasProductDisc ? `<div style="font-size: 8px; color: #777; text-decoration: line-through;">Rs ${origBase.toLocaleString()}</div>` : ''}
          <div style="font-size: 9.5px; font-weight: bold;">Rs ${effectivePrice.toLocaleString()}</div>
          <div style="font-size: 9px; font-weight: 900; color: #111;">= Rs ${lineTotal.toLocaleString()}</div>
        </td>
      </tr>
    `;
  });

  // Calculate base total before company discount
  const salesTaxAmt = Number(o.salesTax || 0);
  const companyDiscAmt = Number(o.companyDiscount || 0);
  const totalDueAmount = Number(o.totalAmount || 0);
  const originalOrderTotal = companyDiscAmt > 0 ? (totalDueAmount + companyDiscAmt) : totalDueAmount;

  const html = `
    <!DOCTYPE html>
    <html>
      <head>
        <meta charset="utf-8">
        <title>Receipt - ${displayOrderId}</title>
        <style>
          @page {
            size: 80mm auto; /* 3 inch thermal POS roll */
            margin: 1.5mm 2mm;
          }
          * { box-sizing: border-box; }
          body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Courier New', monospace, sans-serif;
            width: 74mm;
            max-width: 74mm;
            margin: 0 auto;
            padding: 2px;
            color: #000;
            font-size: 10px;
            line-height: 1.3;
            background: #fff;
          }
          .text-center { text-align: center; }
          .text-right { text-align: right; }
          .bold { font-weight: bold; }
          .divider { border-top: 1px dashed #444; margin: 3px 0; }
          table { width: 100%; border-collapse: collapse; }
          .info-row { display: flex; justify-content: space-between; font-size: 9.5px; margin-bottom: 1.5px; }
        </style>
      </head>
      <body>
        <!-- Header -->
        <div class="text-center">
          <div style="font-size: 15px; font-weight: 900; letter-spacing: 0.5px; line-height: 1.1;">MHQ RESELLER</div>
          <div style="font-size: 8.5px; color: #333; text-transform: uppercase;">(Broker) &bull; Nationwide & International Trader</div>
          <div class="divider"></div>
          <div style="display: flex; justify-content: space-between; font-size: 9.5px; font-weight: bold; padding: 1px 0;">
            <span>${displayOrderId}</span>
            <span>${d}</span>
            <span>${payMethod}</span>
          </div>
        </div>

        <div class="divider"></div>

        <!-- Customer Info -->
        <div style="font-size: 9px; line-height: 1.25; margin-bottom: 2px;">
          <div><strong>Customer:</strong> ${o.customerDetails ? o.customerDetails.fullName : 'Walk-in'} &bull; <strong>${o.customerDetails ? o.customerDetails.phoneNo : '-'}</strong></div>
          <div style="color: #222;">${o.customerDetails ? `${o.customerDetails.houseNo ? 'H#' + o.customerDetails.houseNo + ', ' : ''}${o.customerDetails.streetNameNo ? o.customerDetails.streetNameNo + ', ' : ''}${o.customerDetails.areaName ? o.customerDetails.areaName + ', ' : ''}${o.customerDetails.city || ''}` : '-'}</div>
          ${o.courierCompany || o.courierTrackingNo ? `<div style="margin-top: 1px;"><strong>Courier:</strong> ${o.courierCompany || 'Dispatched'} ${o.courierTrackingNo ? '(CN: ' + o.courierTrackingNo + ')' : ''}</div>` : ''}
        </div>

        <div class="divider"></div>

        <!-- Items Table -->
        <table>
          <thead>
            <tr>
              <th style="text-align: left; font-size: 9px; text-transform: uppercase; border-bottom: 1px solid #000; padding-bottom: 2px;">ITEM</th>
              <th style="text-align: right; font-size: 9px; text-transform: uppercase; border-bottom: 1px solid #000; padding-bottom: 2px;">PRICE / TOTAL</th>
            </tr>
          </thead>
          <tbody>
            ${itemsHtml}
          </tbody>
        </table>

        <div class="divider"></div>

        <!-- Totals Sequence per user requirement -->
        <div style="font-size: 9.5px; line-height: 1.35;">
          <div class="info-row">
            <span>Items Subtotal:</span>
            <span>Rs ${subtotal.toLocaleString()}</span>
          </div>

          <div class="info-row">
            <span>Delivery Charges:</span>
            <span>${totalDelivery === 0 ? 'Free' : 'Rs ' + totalDelivery.toLocaleString()}</span>
          </div>

          <div class="info-row">
            <span>Sales Tax:</span>
            <span>Rs ${salesTaxAmt.toLocaleString()}</span>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: baseline; font-size: 11px; font-weight: 900; margin-top: 2px; border-top: 1px solid #000; padding-top: 2px;">
            <span>TOTAL AMOUNT:</span>
            <span>Rs ${originalOrderTotal.toLocaleString()}</span>
          </div>

          ${companyDiscAmt > 0 ? `
            <div style="display: flex; justify-content: space-between; align-items: baseline; font-size: 11.5px; font-weight: 900; margin-top: 1px; color: #000;">
              <span>DISCOUNTED PRICE:</span>
              <span>Rs ${totalDueAmount.toLocaleString()}</span>
            </div>
          ` : ''}

          ${payMethod === 'Pay Some Advance' ? `
            <div class="info-row" style="margin-top: 2px; color: #222;">
              <span>Advance Paid:</span>
              <span>- Rs ${Number(o.advanceAmount || 0).toLocaleString()}</span>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: baseline; font-size: 11.5px; font-weight: 900; color: #000; border-top: 1px dashed #000; padding-top: 2px; margin-top: 1px;">
              <span>BALANCE DUE ON DELIVERY:</span>
              <span>Rs ${Number(o.totalDueAmount !== undefined ? o.totalDueAmount : (totalDueAmount - (o.advanceAmount || 0))).toLocaleString()}</span>
            </div>
          ` : payMethod === 'Advance Payment' ? `
            <div class="info-row" style="margin-top: 2px; font-weight: bold;">
              <span>Full Advance Paid:</span>
              <span>Rs ${totalDueAmount.toLocaleString()}</span>
            </div>
            <div class="info-row" style="font-weight: bold;">
              <span>BALANCE DUE:</span>
              <span>Rs 0</span>
            </div>
          ` : `
            <div style="display: flex; justify-content: space-between; font-size: 11px; font-weight: 900; margin-top: 2px;">
              <span>DUE AT DOORSTEP:</span>
              <span>Rs ${totalDueAmount.toLocaleString()}</span>
            </div>
          `}
        </div>

        <div class="divider"></div>

        <div class="text-center" style="font-size: 8px; margin-top: 3px; line-height: 1.2; color: #333;">
          *** THANK YOU FOR SHOPPING WITH MHQ RESELLER ***<br>
          Courier Policy: No parcel open before payment.<br>
          Order ID: <strong>${displayOrderId}</strong> &bull; Powered By MHT Devs
        </div>
      </body>
    </html>
  `;
  const doc = iframe.contentWindow.document;
  doc.open();
  doc.write(html);
  doc.close();
  setTimeout(() => {
    iframe.contentWindow.focus();
    iframe.contentWindow.print();
  }, 250);
}

// Close dropdown if clicked outside
document.addEventListener('click', function(e) {
  const searchInput = document.getElementById('ao-product-search');
  const resultsDiv = document.getElementById('ao-search-results');
  if (searchInput && !searchInput.contains(e.target) && !resultsDiv.contains(e.target)) {
    resultsDiv.classList.add('hidden');
  }
});
</script>

<script src="https://js.pusher.com/8.2.0/pusher.min.js"></script>
<script>
try {
  const pusher = new Pusher('<%= pusherKey %>', { cluster: '<%= pusherCluster %>' });
  const channel = pusher.subscribe('mhq-reseller');

  channel.bind('order:new', (data) => {
    if (data) prependOrderCard(data);
    if (typeof refreshAdminBadges === 'function') refreshAdminBadges();
  });

  channel.bind('order:updated', (data) => {
    if (data && data._id) {
      const el = document.getElementById('order-card-' + data._id);
      if (el) el.outerHTML = createOrderCardHtml(data);
      if (typeof refreshAdminBadges === 'function') refreshAdminBadges();
    }
  });

  channel.bind('order:deleted', (data) => {
    if (data && data.id) {
      const el = document.getElementById('order-card-' + data.id);
      if (el) el.remove();
      if (typeof refreshAdminBadges === 'function') refreshAdminBadges();
    }
  });
} catch (e) {
  console.warn('Pusher listener error in orders:', e);
}
</script>