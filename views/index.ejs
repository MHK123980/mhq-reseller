<%
// Build category map
const catMap = {};
categories.forEach(c => { catMap[c._id.toString()] = c.name; });

// Helper: discounted price
function discountedPrice(p) {
  if (p.hasDiscount && p.discountPercent > 0) {
    return (p.price - (p.price * p.discountPercent / 100)).toFixed(0);
  }
  return p.price;
}
%>

<!-- HERO SECTION -->
<section class="relative min-h-[90vh] flex flex-col items-center justify-center text-center px-4 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-amber-900/20 via-transparent to-zinc-950 pointer-events-none"></div>
  <div class="relative z-10 max-w-4xl mx-auto">
    <div class="inline-block border border-amber-500/40 bg-amber-500/10 text-amber-400 text-xs font-semibold px-4 py-1.5 rounded-full mb-6 tracking-widest uppercase">
      Premium Quality • Best Prices
    </div>
    <h1 class="text-4xl sm:text-5xl md:text-7xl font-black text-white leading-tight mb-6" style="font-family:'Times New Roman',serif;">
      MHQ <span class="text-amber-400">Reseller</span><br><span class="text-2xl sm:text-3xl md:text-4xl font-semibold text-zinc-300">(Broker)</span>
    </h1>
    <p class="text-zinc-300 text-base md:text-xl max-w-2xl mx-auto mb-8 leading-relaxed">
      Discover our curated collection of premium quality products. Exceptional value, trusted service, delivered to your door.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/products" class="bg-amber-600 hover:bg-amber-500 text-white font-semibold px-8 py-3.5 rounded-full transition-all hover:scale-105 text-sm">
        Shop Now
      </a>
      <a href="/featuredproducts" class="border border-amber-500/50 hover:border-amber-400 text-amber-400 font-semibold px-8 py-3.5 rounded-full transition-all text-sm">
        View Featured
      </a>
    </div>
  </div>
  <!-- Decorative orbs -->
  <div class="absolute top-20 left-10 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-20 right-10 w-96 h-96 bg-amber-700/10 rounded-full blur-3xl pointer-events-none"></div>
</section>

<!-- CATEGORIES SECTION -->
<% if (categories.length > 0) { %>
<section class="py-12 px-4 max-w-7xl mx-auto hidden md:block">
  <h2 class="text-2xl font-bold text-white mb-6">Browse <span class="text-amber-400">Categories</span></h2>
  <div class="flex flex-wrap gap-3" id="categories-list">
    <button onclick="filterByCategory('all')" class="category-btn active-cat px-5 py-2 rounded-full border border-amber-500 bg-amber-500/20 text-amber-400 text-sm font-medium transition-all hover:bg-amber-500/30" data-cat="all">
      All Products
    </button>
    <% categories.forEach(cat => { %>
    <button onclick="filterByCategory('<%= cat._id %>')" class="category-btn px-5 py-2 rounded-full border border-zinc-700 hover:border-amber-500 text-zinc-300 hover:text-amber-400 text-sm font-medium transition-all" data-cat="<%= cat._id %>">
      <%= cat.name %>
    </button>
    <% }) %>
  </div>
</section>
<% } %>

<!-- FEATURED PRODUCTS SECTION -->
<% if (featured.length > 0) { %>
<section class="py-8 px-4 max-w-7xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-bold text-white">⭐ <span class="text-amber-400">Featured</span> Products</h2>
    <a href="/featuredproducts" class="text-amber-400 hover:text-amber-300 text-sm font-medium transition-colors">Show All →</a>
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4" id="featured-grid">
    <% featured.forEach(p => { %>
    <div class="product-card bg-zinc-900 border border-zinc-700 hover:border-amber-500/50 rounded-2xl overflow-hidden transition-all hover:scale-[1.02] hover:shadow-xl hover:shadow-amber-500/10 cursor-pointer group"
         onclick="window.location='/product/<%= p._id %>'"
         data-id="<%= p._id %>"
         data-cat="<%= p.category ? p.category._id : '' %>">
      <div class="relative aspect-square overflow-hidden bg-zinc-800">
        <% if (p.images && p.images.length > 0) { %>
        <img src="<%= p.images[0] %>" alt="<%= p.name %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
        <% } else { %>
        <div class="w-full h-full flex items-center justify-center text-zinc-600">
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
        <% } %>
        <% if (p.isOutOfStock) { %>
        <div class="absolute top-2 left-2 bg-red-600 text-white text-xs px-2 py-0.5 rounded-full font-semibold">Out of Stock</div>
        <% } else if (p.isLowInStock) { %>
        <div class="absolute top-2 left-2 bg-orange-500 text-white text-xs px-2 py-0.5 rounded-full font-semibold">Low Stock</div>
        <% } %>
        <% if (p.hasDiscount && p.discountPercent > 0) { %>
        <div class="absolute top-2 right-2 bg-amber-500 text-black text-xs px-2 py-0.5 rounded-full font-bold"><%= p.discountPercent %>% OFF</div>
        <% } %>
      </div>
      <div class="p-3">
        <p class="text-xs text-amber-500/70 font-medium mb-1"><%= p.category ? p.category.name : 'Uncategorized' %></p>
        <h3 class="text-sm font-semibold text-white line-clamp-2 mb-2 leading-tight"><%= p.name %></h3>
        <div class="flex items-center justify-between">
          <div>
            <% if (p.hasDiscount && p.discountedPrice > 0) { %>
            <p class="text-amber-400 font-bold text-sm">Rs <%= p.discountedPrice %></p>
            <p class="text-zinc-500 text-xs line-through">Rs <%= p.price %></p>
            <% } else { %>
            <p class="text-amber-400 font-bold text-sm">Rs <%= p.price %></p>
            <% } %>
          </div>
          <button onclick="event.stopPropagation(); addToCartFromCard('<%= p._id %>', '<%= p.name.replace(/'/g, "\'") %>', <%= p.hasDiscount && p.discountedPrice > 0 ? p.discountedPrice : p.price %>, '<%= p.images && p.images.length > 0 ? p.images[0] : "" %>', <%= p.deliveryCharges || 0 %>, <%= p.isFreeDelivery ? 'true' : 'false' %>)"
            class="bg-amber-600 hover:bg-amber-500 text-white text-xs px-3 py-1.5 rounded-full transition-all font-medium <%= p.isOutOfStock ? 'opacity-50 cursor-not-allowed' : '' %>"
            <%= p.isOutOfStock ? 'disabled' : '' %>>
            Add
          </button>
        </div>
        <% if (p.isFreeDelivery) { %>
        <p class="text-emerald-400 text-xs mt-1 font-medium">✓ Free Delivery</p>
        <% } else if (p.deliveryCharges > 0) { %>
        <p class="text-zinc-500 text-xs mt-1">Delivery: Rs <%= p.deliveryCharges %></p>
        <% } %>
      </div>
    </div>
    <% }) %>
  </div>
</section>
<% } %>

<!-- ALL PRODUCTS SECTION -->
<section class="py-8 px-4 max-w-7xl mx-auto" id="all-products-section">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-bold text-white">All <span class="text-amber-400">Products</span></h2>
    <a href="/products" class="text-amber-400 hover:text-amber-300 text-sm font-medium transition-colors">Show All →</a>
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4" id="all-products-grid">
    <% products.slice(0, 8).forEach(p => { %>
    <div class="product-card bg-zinc-900 border border-zinc-700 hover:border-amber-500/50 rounded-2xl overflow-hidden transition-all hover:scale-[1.02] hover:shadow-xl hover:shadow-amber-500/10 cursor-pointer group"
         onclick="window.location='/product/<%= p._id %>'"
         data-id="<%= p._id %>"
         data-cat="<%= p.category ? p.category._id : '' %>">
      <div class="relative aspect-square overflow-hidden bg-zinc-800">
        <% if (p.images && p.images.length > 0) { %>
        <img src="<%= p.images[0] %>" alt="<%= p.name %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
        <% } else { %>
        <div class="w-full h-full flex items-center justify-center text-zinc-600">
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
        <% } %>
        <% if (p.isOutOfStock) { %>
        <div class="absolute top-2 left-2 bg-red-600 text-white text-xs px-2 py-0.5 rounded-full font-semibold">Out of Stock</div>
        <% } else if (p.isLowInStock) { %>
        <div class="absolute top-2 left-2 bg-orange-500 text-white text-xs px-2 py-0.5 rounded-full font-semibold">Low Stock</div>
        <% } %>
        <% if (p.hasDiscount && p.discountPercent > 0) { %>
        <div class="absolute top-2 right-2 bg-amber-500 text-black text-xs px-2 py-0.5 rounded-full font-bold"><%= p.discountPercent %>% OFF</div>
        <% } %>
      </div>
      <div class="p-3">
        <p class="text-xs text-amber-500/70 font-medium mb-1"><%= p.category ? p.category.name : 'Uncategorized' %></p>
        <h3 class="text-sm font-semibold text-white line-clamp-2 mb-2 leading-tight"><%= p.name %></h3>
        <div class="flex items-center justify-between">
          <div>
            <% if (p.hasDiscount && p.discountedPrice > 0) { %>
            <p class="text-amber-400 font-bold text-sm">Rs <%= p.discountedPrice %></p>
            <p class="text-zinc-500 text-xs line-through">Rs <%= p.price %></p>
            <% } else { %>
            <p class="text-amber-400 font-bold text-sm">Rs <%= p.price %></p>
            <% } %>
          </div>
          <button onclick="event.stopPropagation(); addToCartFromCard('<%= p._id %>', '<%= p.name.replace(/'/g, "\'") %>', <%= p.hasDiscount && p.discountedPrice > 0 ? p.discountedPrice : p.price %>, '<%= p.images && p.images.length > 0 ? p.images[0] : "" %>', <%= p.deliveryCharges || 0 %>, <%= p.isFreeDelivery ? 'true' : 'false' %>)"
            class="bg-amber-600 hover:bg-amber-500 text-white text-xs px-3 py-1.5 rounded-full transition-all font-medium <%= p.isOutOfStock ? 'opacity-50 cursor-not-allowed' : '' %>"
            <%= p.isOutOfStock ? 'disabled' : '' %>>
            Add
          </button>
        </div>
        <% if (p.isFreeDelivery) { %>
        <p class="text-emerald-400 text-xs mt-1 font-medium">✓ Free Delivery</p>
        <% } else if (p.deliveryCharges > 0) { %>
        <p class="text-zinc-500 text-xs mt-1">Delivery: Rs <%= p.deliveryCharges %></p>
        <% } %>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<!-- Cart Toast -->
<div id="cart-toast" class="fixed bottom-6 right-6 bg-amber-600 text-white px-5 py-3 rounded-xl shadow-2xl font-medium text-sm z-50 translate-y-20 opacity-0 transition-all duration-300">
  ✓ Added to cart!
</div>

<script>
// Category filter
function filterByCategory(catId) {
  document.querySelectorAll('.category-btn').forEach(btn => {
    btn.classList.remove('active-cat','bg-amber-500/20','text-amber-400','border-amber-500');
    btn.classList.add('border-zinc-700','text-zinc-300');
  });
  const activeBtn = document.querySelector(`.category-btn[data-cat="${catId}"]`);
  if (activeBtn) {
    activeBtn.classList.add('active-cat','bg-amber-500/20','text-amber-400','border-amber-500');
    activeBtn.classList.remove('border-zinc-700','text-zinc-300');
  }
  document.querySelectorAll('.product-card').forEach(card => {
    if (catId === 'all' || card.dataset.cat === catId) {
      card.style.display = '';
    } else {
      card.style.display = 'none';
    }
  });
}

function addToCartFromCard(id, name, price, image, deliveryCharges, isFreeDelivery) {
  const cart = JSON.parse(localStorage.getItem('mhq_cart') || '[]');
  const existing = cart.find(i => i.id === id);
  if (existing) {
    existing.quantity += 1;
  } else {
    cart.push({ id, name, price: parseFloat(price), image, quantity: 1, deliveryCharges: deliveryCharges || 0, isFreeDelivery: isFreeDelivery || false });
  }
  localStorage.setItem('mhq_cart', JSON.stringify(cart));
  updateCartCount();
  showCartToast();
}

function showCartToast() {
  const toast = document.getElementById('cart-toast');
  toast.classList.remove('translate-y-20','opacity-0');
  toast.classList.add('translate-y-0','opacity-100');
  setTimeout(() => {
    toast.classList.add('translate-y-20','opacity-0');
    toast.classList.remove('translate-y-0','opacity-100');
  }, 2000);
}
</script>

<!-- Pusher Real-time -->
<script src="https://js.pusher.com/8.2.0/pusher.min.js"></script>
<script>
const pusher = new Pusher('<%= pusherKey %>', { cluster: '<%= pusherCluster %>' });
const channel = pusher.subscribe('mhq-reseller');

function buildProductCard(p) {
  const discountedPrice = p.hasDiscount && p.discountedPrice > 0 ? p.discountedPrice : p.price;
  const catName = p.category ? (p.category.name || '') : 'Uncategorized';
  const catId = p.category ? (p.category._id || p.category) : '';
  const imgHtml = p.images && p.images.length > 0
    ? `<img src="${p.images[0]}" alt="${p.name}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy"/>`
    : `<div class="w-full h-full flex items-center justify-center text-zinc-600"><svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div>`;
  const priceHtml = p.hasDiscount && p.discountedPrice > 0
    ? `<p class="text-amber-400 font-bold text-sm">Rs ${discountedPrice}</p><p class="text-zinc-500 text-xs line-through">Rs ${p.price}</p>`
    : `<p class="text-amber-400 font-bold text-sm">Rs ${p.price}</p>`;
  
  const stockBadge = p.isOutOfStock ? `<div class="absolute top-2 left-2 bg-red-600 text-white text-xs px-2 py-0.5 rounded-full font-semibold">Out of Stock</div>` : p.isLowInStock ? `<div class="absolute top-2 left-2 bg-orange-500 text-white text-xs px-2 py-0.5 rounded-full font-semibold">Low Stock</div>` : '';
  const discBadge = p.hasDiscount && p.discountPercent > 0 ? `<div class="absolute top-2 right-2 bg-amber-500 text-black text-xs px-2 py-0.5 rounded-full font-bold">${p.discountPercent}% OFF</div>` : '';
  const deliveryHtml = p.isFreeDelivery ? `<p class="text-emerald-400 text-xs mt-1 font-medium">✓ Free Delivery</p>` : p.deliveryCharges > 0 ? `<p class="text-zinc-500 text-xs mt-1">Delivery: Rs ${p.deliveryCharges}</p>` : '';

  return `<div class="product-card bg-zinc-900 border border-zinc-700 hover:border-amber-500/50 rounded-2xl overflow-hidden transition-all hover:scale-[1.02] cursor-pointer group"
       onclick="window.location='/product/${p._id}'" data-cat="${catId}" data-id="${p._id}">
    <div class="relative aspect-square overflow-hidden bg-zinc-800">
      ${imgHtml}
      ${stockBadge}
      ${discBadge}
    </div>
    <div class="p-3">
      <p class="text-xs text-amber-500/70 font-medium mb-1">${catName}</p>
      <h3 class="text-sm font-semibold text-white line-clamp-2 mb-2">${p.name}</h3>
      <div class="flex items-center justify-between">
        <div>${priceHtml}</div>
        <button onclick="event.stopPropagation(); addToCartFromCard('${p._id}', '${p.name.replace(/'/g,"\\'").replace(/"/g,'&quot;')}', ${discountedPrice}, '${p.images && p.images.length ? p.images[0] : ''}', ${p.deliveryCharges||0}, ${p.isFreeDelivery})"
          class="bg-amber-600 hover:bg-amber-500 text-white text-xs px-3 py-1.5 rounded-full transition-all font-medium" ${p.isOutOfStock?'disabled':''}>Add</button>
      </div>
      ${deliveryHtml}
    </div>
  </div>`;
}

channel.bind('product:new', (data) => {
  const grids = ['featured-grid', 'all-products-grid'];
  grids.forEach(gid => {
    const grid = document.getElementById(gid);
    if (grid && (gid !== 'featured-grid' || data.isFeatured)) {
      grid.insertAdjacentHTML('afterbegin', buildProductCard(data));
    }
  });
});

channel.bind('product:updated', (data) => {
  if (!data || !data._id) return;
  fetch('/api/products/' + data._id).then(r => r.json()).then(p => {
    document.querySelectorAll(`[data-id="${p._id}"]`).forEach(el => {
      el.outerHTML = buildProductCard(p);
    });
  }).catch(() => {});
});

channel.bind('product:deleted', (data) => {
  document.querySelectorAll(`[data-id="${data.id}"]`).forEach(el => el.remove());
});
</script>
