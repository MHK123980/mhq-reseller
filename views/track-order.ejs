<section class="min-h-screen py-20 px-3 sm:px-6">
  <div class="max-w-2xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-amber-500/10 border border-amber-500/20 mb-4 shadow-lg shadow-amber-500/10">
        <svg class="w-7 h-7 sm:w-8 sm:h-8 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
      </div>
      <h1 class="text-2xl sm:text-4xl font-black text-white mb-2 font-serif">Track Your <span class="text-amber-400">Order</span></h1>
      <p class="text-zinc-400 text-xs sm:text-sm max-w-md mx-auto">Enter your Order ID (e.g. <span class="text-amber-400 font-mono font-semibold">MA101</span>) to see live progress and courier parcel status.</p>
    </div>

    <!-- Search Box -->
    <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 sm:p-6 mb-6 shadow-2xl backdrop-blur-md">
      <label class="block text-[11px] sm:text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-2">Order ID</label>
      <div class="flex flex-col sm:flex-row gap-2.5">
        <input id="order-id-input" type="text" placeholder="e.g. MA101" 
          class="flex-1 bg-zinc-800/90 border border-zinc-700/80 focus:border-amber-500 text-white placeholder-zinc-500 rounded-xl px-4 py-3 text-sm outline-none transition-colors uppercase font-mono tracking-wider"
          onkeydown="if(event.key==='Enter') trackOrder()" />
        <button onclick="trackOrder()" class="btn-gold px-6 py-3 text-sm flex items-center justify-center gap-2 flex-shrink-0 w-full sm:w-auto font-bold shadow-lg shadow-amber-500/20">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <span>Track Order</span>
        </button>
      </div>
      <div class="flex items-center gap-2 mt-3 text-[11px] text-zinc-500">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Real-time tracking enabled — updates live without refreshing</span>
      </div>
    </div>

    <!-- Result -->
    <div id="track-result"></div>
  </div>
</section>

<style>
  .status-step { position: relative; }
  .status-step::before { content: ''; position: absolute; left: 15px; top: 32px; bottom: -8px; width: 2px; background: #27272a; }
  .status-step:last-child::before { display: none; }
  .status-step.done::before { background: linear-gradient(to bottom, #d97706, #27272a); }

  @keyframes radarShimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(260%); }
  }
  .gateway-shimmer-bar {
    position: relative;
    overflow: hidden;
    background: rgba(245, 158, 11, 0.14);
  }
  .gateway-shimmer-bar::after {
    content: '';
    position: absolute;
    inset: 0;
    width: 45%;
    background: linear-gradient(90deg, transparent, #d97706, #fbbf24, transparent);
    animation: radarShimmer 1.35s ease-in-out infinite;
  }
  @keyframes floatParcel {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-3px); }
  }
  .parcel-float {
    animation: floatParcel 2.2s ease-in-out infinite;
  }
</style>

<script src="https://js.pusher.com/8.2.0/pusher.min.js"></script>
<script>
let currentTrackedOrderId = null;
// Simplified 3-step progress bar per user requirement: Pending -> Shipping -> Delivered
const statusOrder = ['Pending', 'Shipping', 'Delivered'];
const statusIcons = {
  'Pending': '🕐',
  'Shipping': '🚚',
  'Delivered': '✅',
  'Canceled': '❌'
};

// Returns tracking portal URL with CN pre-filled or direct tracking input page
function getCourierTrackingUrl(courierCompany, cn) {
  const cleanCN = encodeURIComponent((cn || '').trim());
  switch (courierCompany) {
    case 'TCS':
      return `https://www.tcsexpress.com/track/${cleanCN}`;
    case 'PostEx':
      return `https://postex.pk/tracking?cn=${cleanCN}`;
    case 'Leopard':
      return `https://www.leopardscourier.com/leopards_tracking/?track_numbers=${cleanCN}`;
    case 'Trax':
      return `https://trax.pk/tracking/?tracking_number=${cleanCN}`;
    case 'M&B':
      return `https://www.mnbcourier.pk/track/${cleanCN}`;
    case 'Call Courier':
      return `https://callcourier.com.pk/tracking/?cn=${cleanCN}`;
    default:
      return null;
  }
}

// Maps database status into one of: 'Pending', 'Shipping', 'Delivered', or 'Canceled'
function mapToThreeSteps(rawStatus) {
  if (rawStatus === 'Canceled') return 'Canceled';
  if (rawStatus === 'Delivered') return 'Delivered';
  if (['Packed', 'Ready to Ship', 'On Route', 'Out for Delivery', 'Shipping'].includes(rawStatus)) {
    return 'Shipping';
  }
  return 'Pending';
}

function getGatewayLoaderHtml(compact = false) {
  if (compact) {
    return `
      <div class="mt-3 pt-3 border-t border-zinc-800/80">
        <div class="bg-zinc-950/80 border border-amber-500/20 rounded-xl p-3">
          <div class="flex items-center gap-3">
            <div class="relative flex items-center justify-center w-7 h-7 flex-shrink-0">
              <span class="absolute inline-flex h-full w-full rounded-full bg-amber-400/40 animate-ping"></span>
              <span class="relative inline-flex items-center justify-center w-6 h-6 rounded-full bg-amber-500/20 border border-amber-500/50 text-amber-400 parcel-float">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
              </span>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-[11px] font-mono font-semibold text-amber-300 tracking-wide">Connecting with Courier Gateway...</p>
              <div class="w-full h-1 rounded-full gateway-shimmer-bar mt-1.5"></div>
            </div>
          </div>
        </div>
      </div>
    `;
  }

  return `
    <div class="bg-zinc-900/90 border border-amber-500/25 rounded-2xl p-6 sm:p-8 shadow-2xl backdrop-blur-md text-center">
      <div class="relative inline-flex items-center justify-center w-14 h-14 mb-4">
        <span class="absolute inline-flex h-full w-full rounded-full bg-amber-400/30 animate-ping"></span>
        <span class="absolute inline-flex h-11 w-11 rounded-full bg-amber-500/15 border border-amber-500/30"></span>
        <span class="relative inline-flex items-center justify-center w-9 h-9 rounded-full bg-amber-500/20 border border-amber-400/60 text-amber-400 parcel-float shadow-lg shadow-amber-500/20">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        </span>
      </div>
      <p class="text-xs sm:text-sm font-mono font-bold text-amber-300 tracking-wider">Connecting with Courier Gateway...</p>
      <div class="max-w-xs mx-auto h-1 rounded-full gateway-shimmer-bar mt-3"></div>
    </div>
  `;
}

async function fetchLiveCourierUpdates(orderId) {
  const container = document.getElementById('live-courier-updates');
  if (!container) return;

  try {
    const res = await fetch(`/api/courier/live/${encodeURIComponent(orderId)}`);
    const data = await res.json();

    if (data && data.available && Array.isArray(data.events) && data.events.length > 0) {
      const eventsHtml = data.events.slice(0, 5).map((ev, idx) => `
        <div class="flex items-start gap-2.5 text-xs py-1.5 ${idx > 0 ? 'border-t border-zinc-800/60' : ''}">
          <span class="w-2 h-2 rounded-full mt-1.5 flex-shrink-0 ${idx === 0 ? 'bg-emerald-400 shadow-sm shadow-emerald-400/60 animate-pulse' : 'bg-zinc-600'}"></span>
          <div class="flex-1 min-w-0">
            <p class="${idx === 0 ? 'text-white font-semibold' : 'text-zinc-300'} leading-snug">${ev.status}</p>
            <div class="flex flex-wrap items-center gap-x-2 text-[10px] text-zinc-500 mt-0.5">
              ${ev.location ? `<span>📍 ${ev.location}</span>` : ''}
              ${ev.timestamp ? `<span>🕒 ${ev.timestamp}</span>` : ''}
            </div>
          </div>
        </div>
      `).join('');

      container.innerHTML = `
        <div class="mt-3 pt-3 border-t border-zinc-800/80">
          <div class="bg-zinc-950/80 border border-emerald-500/25 rounded-xl p-3">
            <div class="flex items-center justify-between mb-2">
              <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                Live Courier Transit Updates
              </span>
              ${data.currentStatus ? `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">${data.currentStatus}</span>` : ''}
            </div>
            <div class="space-y-0.5">${eventsHtml}</div>
          </div>
        </div>
      `;

      // If auto-updated to Delivered, refresh order progress cleanly
      if (data.autoUpdatedStatus === 'Delivered') {
        const orderRes = await fetch(`/api/courier/${encodeURIComponent(orderId)}`);
        const orderData = await orderRes.json();
        if (orderData && orderData.success) {
          // Re-render only if status changed, without re-triggering live loop
          renderTrackingDetails(orderData.order, orderData.tracking, true);
          // Re-inject the already fetched live feed
          const newContainer = document.getElementById('live-courier-updates');
          if (newContainer) newContainer.innerHTML = container.innerHTML;
        }
      }
    } else {
      container.innerHTML = `
        <div class="mt-3 pt-2.5 border-t border-zinc-800/60 text-center">
          <p class="text-[11px] text-zinc-500">Live hub scan pending — use the tracking portal button below for direct carrier lookup.</p>
        </div>
      `;
    }
  } catch (err) {
    container.innerHTML = '';
  }
}

async function trackOrder() {
  const orderId = document.getElementById('order-id-input').value.trim().toUpperCase();
  const result = document.getElementById('track-result');
  if (!orderId) {
    result.innerHTML = '<div class="text-center text-zinc-500 py-6 text-sm">Please enter your Order ID</div>';
    return;
  }
  currentTrackedOrderId = orderId;
  result.innerHTML = getGatewayLoaderHtml(false);
  
  try {
    const res = await fetch(`/api/courier/${orderId}`);
    const data = await res.json();
    if (!data.success) {
      result.innerHTML = `<div class="bg-red-900/20 border border-red-500/30 rounded-2xl p-6 text-center">
        <div class="text-3xl mb-2">❌</div>
        <p class="text-red-400 font-semibold text-sm">${data.message || 'Order not found'}</p>
        <p class="text-zinc-500 text-xs mt-1">Please double-check your Order ID and try again</p>
      </div>`;
      return;
    }
    
    renderTrackingDetails(data.order, data.tracking);
  } catch(err) {
    result.innerHTML = '<div class="bg-red-900/20 border border-red-500/30 rounded-2xl p-6 text-center"><p class="text-red-400 text-sm">Something went wrong. Please check your connection and try again.</p></div>';
  }
}

function renderTrackingDetails(order, tracking, skipLiveFetch = false) {
  const result = document.getElementById('track-result');
  const mappedStatus = mapToThreeSteps(order.status);
  const currentStatusIdx = statusOrder.indexOf(mappedStatus);
  const isCanceled = mappedStatus === 'Canceled';
  
  const stepsHtml = isCanceled ? 
    `<div class="bg-red-900/20 border border-red-500/30 rounded-xl p-4 text-center"><p class="text-red-400 font-semibold text-sm">❌ Order Canceled</p></div>` :
    statusOrder.map((s, i) => {
      const done = i < currentStatusIdx;
      const active = i === currentStatusIdx;
      return `<div class="status-step ${done ? 'done' : ''} flex items-center gap-4 pb-4 last:pb-0">
        <div class="w-8 h-8 rounded-full flex-shrink-0 flex items-center justify-center text-xs sm:text-sm ${active ? 'bg-amber-500 text-black shadow-lg shadow-amber-500/50 font-black' : done ? 'bg-amber-900/50 border border-amber-700/50 text-amber-400 font-bold' : 'bg-zinc-800 border border-zinc-700 text-zinc-600'}">
          ${done ? '✓' : active ? (statusIcons[s] || '●') : '○'}
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-xs sm:text-sm font-bold ${active ? 'text-amber-400' : done ? 'text-zinc-300' : 'text-zinc-600'}">${s}</p>
          ${active ? `<p class="text-[10px] text-amber-400/80 mt-0.5">Current Progress (${order.status})</p>` : ''}
        </div>
      </div>`;
    }).join('');

  const courierHtml = tracking ? (() => {
    const companyName = tracking.courierCompany === 'Other' ? (tracking.courierName || 'Other') : tracking.courierCompany;
    const trackUrl = getCourierTrackingUrl(tracking.courierCompany, tracking.trackingNumber);
    return `<div class="bg-zinc-900/80 border border-zinc-800 rounded-2xl p-4 sm:p-5 shadow-xl">
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
        <h3 class="text-xs sm:text-sm font-bold text-white uppercase tracking-wider">Courier Dispatch Details</h3>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        <div class="bg-zinc-800/70 border border-zinc-700/50 rounded-xl p-3">
          <p class="text-[10px] text-zinc-400 uppercase tracking-wider mb-0.5">Courier Partner</p>
          <p class="text-white font-bold text-sm">${companyName}</p>
        </div>
        <div class="bg-zinc-800/70 border border-zinc-700/50 rounded-xl p-3">
          <p class="text-[10px] text-zinc-400 uppercase tracking-wider mb-0.5">Consignment No (CN)</p>
          <p class="text-amber-400 font-bold text-sm font-mono tracking-wider">${tracking.trackingNumber}</p>
        </div>
      </div>
      <div id="live-courier-updates">${!skipLiveFetch ? getGatewayLoaderHtml(true) : ''}</div>
      ${trackUrl ? `<a href="${trackUrl}" target="_blank" rel="noopener noreferrer" class="mt-3 btn-gold flex items-center justify-center gap-2 py-2.5 text-xs sm:text-sm w-full rounded-xl font-bold shadow-lg shadow-amber-500/20">
        <span>Open ${companyName} Tracking Portal</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>` : ''}
    </div>`;
  })() : `<div class="bg-zinc-900/60 border border-zinc-800 rounded-2xl p-4 sm:p-5 text-center">
    <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-amber-500/10 text-amber-400 mb-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
    </div>
    <p class="text-zinc-400 text-xs sm:text-sm">Courier Tracking No: <span class="text-amber-400 font-bold tracking-wide">CN Will Be Provided Soon</span></p>
    <p class="text-zinc-600 text-[11px] mt-1">Once dispatched by our courier team, your tracking number will show here automatically.</p>
  </div>`;

  const paymentStatusHtml = (() => {
    if (order.paymentMethod === 'COD') {
      return `
        <div class="bg-zinc-800/60 border border-zinc-700/60 rounded-xl p-3 flex items-center justify-between text-xs">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-400"></span>
            <span class="text-zinc-300 font-medium">Payment Method:</span>
            <span class="text-white font-bold">Cash on Delivery (COD)</span>
          </div>
          <span class="text-zinc-400">Due at doorstep</span>
        </div>`;
    }

    if (order.paymentStatus === 'Under Review') {
      return `
        <div class="bg-amber-500/10 border border-amber-500/40 rounded-xl p-3.5 text-xs flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <span class="w-3 h-3 rounded-full bg-amber-400 animate-ping flex-shrink-0"></span>
            <div>
              <p class="text-amber-400 font-bold">Payment Status: Under Review</p>
              <p class="text-zinc-400 text-[11px] mt-0.5">Your transfer proof is being verified by our accounts team.</p>
            </div>
          </div>
          <span class="bg-amber-500/20 text-amber-300 font-semibold px-2.5 py-1 rounded-full text-[10px]">Under Review</span>
        </div>`;
    }

    if (order.paymentStatus === 'Approved') {
      return `
        <div class="bg-emerald-500/10 border border-emerald-500/40 rounded-xl p-3.5 text-xs flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 flex-shrink-0"></span>
            <div>
              <p class="text-emerald-400 font-bold">Payment Approved - Order Status: ${order.status}</p>
              <p class="text-zinc-400 text-[11px] mt-0.5">Payment verified. Your order is being processed for dispatch.</p>
            </div>
          </div>
          <span class="bg-emerald-500/20 text-emerald-300 font-semibold px-2.5 py-1 rounded-full text-[10px]">Verified ✓</span>
        </div>`;
    }

    if (order.paymentStatus === 'Declined') {
      return `
        <div class="bg-red-500/10 border border-red-500/40 rounded-xl p-3.5 text-xs flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-red-400 flex-shrink-0"></span>
            <div>
              <p class="text-red-400 font-bold">Payment Declined</p>
              <p class="text-zinc-400 text-[11px] mt-0.5">We could not verify your payment screenshot. Please contact support.</p>
            </div>
          </div>
          <span class="bg-red-500/20 text-red-300 font-semibold px-2.5 py-1 rounded-full text-[10px]">Declined ✖</span>
        </div>`;
    }

    return '';
  })();

  const productsHtml = (order.products && order.products.length) ? order.products.map(p => {
    const prodName = p.product ? p.product.name : 'Product';
    const prodImg = (p.product && p.product.images && p.product.images.length) ? p.product.images[0] : '';
    const origBase = Number(p.originalBasePrice || p.priceAtPurchase);
    const effectivePrice = Number(p.priceAtPurchase);
    const hasProductDisc = (origBase > effectivePrice);
    const hasCompDisc = (p.companyDiscountedPrice && p.companyDiscountedPrice > 0 && p.companyDiscountedPrice < p.priceAtPurchase);
    const dc = p.isFreeDelivery ? 0 : (p.deliveryCharges || 0);

    return `
    <div class="flex items-center gap-3 py-3 border-b border-zinc-800/80 last:border-0">
      ${prodImg ? `<img src="${prodImg}" class="w-12 h-12 rounded-xl object-cover flex-shrink-0 border border-zinc-700 bg-zinc-800" />` : '<div class="w-12 h-12 rounded-xl bg-zinc-800 flex-shrink-0"></div>'}
      <div class="flex-1 min-w-0">
        <p class="text-white text-xs sm:text-sm font-semibold truncate">${prodName}</p>
        ${p.selectedVariant ? `<p class="text-amber-500/90 text-[11px] font-medium mt-0.5 truncate">${p.selectedVariant}</p>` : ''}
        
        <div class="mt-1">
          ${hasProductDisc ? `<div class="text-zinc-500 text-[10px] line-through leading-tight font-normal">Rs ${origBase.toLocaleString()}</div>` : ''}
          <div class="text-amber-400 font-bold text-xs leading-tight">Rs ${effectivePrice.toLocaleString()} <span class="text-zinc-500 font-normal text-[11px]">× ${p.quantity}</span></div>
        </div>

        ${hasCompDisc ? `<div class="mt-1"><span class="bg-amber-500/15 text-amber-300 border border-amber-500/30 text-[10px] font-bold px-2 py-0.5 rounded-full">Discounted by Company: Rs ${p.companyDiscountedPrice.toLocaleString()}</span></div>` : ''}
        
        ${p.isFreeDelivery ? '<p class="text-emerald-400 text-[10px] font-medium mt-0.5">✓ Free Delivery</p>' : (dc > 0 ? `<p class="text-zinc-500 text-[10px] font-medium mt-0.5">Delivery: Rs ${dc}</p>` : '')}
      </div>
      <div class="text-right flex-shrink-0">
        ${hasProductDisc ? `<p class="text-zinc-500 text-[10px] line-through">Rs ${(origBase * p.quantity).toLocaleString()}</p>` : ''}
        <p class="text-amber-400 text-xs sm:text-sm font-bold">Rs ${(effectivePrice * p.quantity).toLocaleString()}</p>
      </div>
    </div>`;
  }).join('') : '';

  result.innerHTML = `
    <div class="space-y-4">
      <!-- Order Header Card -->
      <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 sm:p-5 shadow-xl backdrop-blur-md">
        <div class="flex items-center justify-between mb-3 pb-3 border-b border-zinc-800/80">
          <div>
            <p class="text-[10px] text-zinc-500 uppercase tracking-widest font-semibold mb-0.5">Order Serial ID</p>
            <p class="text-amber-400 font-black text-xl sm:text-2xl font-mono tracking-wider">${order.orderId}</p>
          </div>
          <div class="text-right">
            <span class="inline-block px-3 py-1 rounded-full text-xs font-bold ${isCanceled ? 'bg-red-900/40 text-red-400 border border-red-700/40' : order.status === 'Delivered' ? 'bg-emerald-900/40 text-emerald-400 border border-emerald-700/40' : 'bg-amber-900/40 text-amber-400 border border-amber-700/40'}">
              ${statusIcons[order.status] || ''} ${order.status}
            </span>
          </div>
        </div>
        <div class="flex justify-between items-center text-xs text-zinc-400 mb-3">
          <span>Customer: <strong class="text-white">${order.customerDetails ? order.customerDetails.fullName : (order.customerName || 'Valued Customer')}</strong></span>
          <span>${new Date(order.createdAt).toLocaleDateString('en-PK', { timeZone: 'Asia/Karachi', year:'numeric', month:'short', day:'numeric' })}</span>
        </div>
        ${paymentStatusHtml}
      </div>

      <!-- Order Status Steps -->
      <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 sm:p-5 shadow-xl backdrop-blur-md">
        <h3 class="text-xs sm:text-sm font-bold text-white uppercase tracking-wider mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          Order Progress
        </h3>
        <div class="space-y-1">
          ${stepsHtml}
        </div>
      </div>

      <!-- Courier Info -->
      ${courierHtml}

      <!-- Ordered Items -->
      <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 sm:p-5 shadow-xl backdrop-blur-md">
        <h3 class="text-xs sm:text-sm font-bold text-white uppercase tracking-wider mb-3">Items Ordered</h3>
        <div class="divide-y divide-zinc-800/60">
          ${productsHtml}
        </div>
        <div class="space-y-1.5 pt-3 border-t border-zinc-800 mt-2 text-xs">
          ${(() => {
            const hasCompDisc = Boolean(order.companyDiscount && Number(order.companyDiscount) > 0);
            const originalTotal = hasCompDisc ? (Number(order.totalAmount || 0) + Number(order.companyDiscount)) : Number(order.originalTotalAmount || order.totalAmount || 0);

            if (hasCompDisc) {
              return `
                <div class="flex justify-between items-center text-white font-bold text-sm">
                  <span>Total Amount <span class="text-[11px] text-zinc-400 font-normal">(Including Tax)</span></span>
                  <span class="text-zinc-400 font-bold line-through text-sm sm:text-base">Rs ${originalTotal.toLocaleString()}</span>
                </div>
                <div class="flex justify-between items-center text-amber-400 font-bold text-sm pt-1 border-t border-dashed border-zinc-800">
                  <span>Discounted Price By Company</span>
                  <span class="text-amber-400 font-black text-base sm:text-lg">Rs ${Number(order.totalAmount || 0).toLocaleString()}</span>
                </div>
              `;
            } else {
              return `
                <div class="flex justify-between items-center text-white font-bold text-sm">
                  <span>Total Amount <span class="text-[11px] text-zinc-400 font-normal">(Including Tax)</span></span>
                  <span class="text-amber-400 font-black text-base sm:text-lg">Rs ${Number(order.totalAmount || 0).toLocaleString()}</span>
                </div>
              `;
            }
          })()}
          ${order.paymentMethod === 'Pay Some Advance' ? `
            <div class="flex justify-between text-emerald-400 text-xs font-semibold pt-1">
              <span>Advance Paid</span>
              <span>Rs ${(order.advanceAmount || 0).toLocaleString()}</span>
            </div>
            <div class="flex justify-between text-white font-bold text-xs">
              <span>Remaining Balance on Delivery</span>
              <span class="text-amber-300">Rs ${(order.totalDueAmount !== undefined ? order.totalDueAmount : (order.totalAmount - (order.advanceAmount || 0))).toLocaleString()}</span>
            </div>
          ` : order.paymentMethod === 'Advance Payment' ? `
            <div class="flex justify-between text-emerald-400 text-xs font-semibold pt-1">
              <span>Full Advance Paid</span>
              <span>Rs ${order.totalAmount.toLocaleString()} (Rs 0 due on delivery)</span>
            </div>
          ` : ''}
        </div>
      </div>
    </div>`;

  if (tracking && !skipLiveFetch) {
    fetchLiveCourierUpdates(order.orderId);
  }
}

// Auto track if ?id= parameter is present
window.addEventListener('DOMContentLoaded', () => {
  const urlParams = new URLSearchParams(window.location.search);
  const qId = urlParams.get('id');
  if (qId) {
    document.getElementById('order-id-input').value = qId;
    trackOrder();
  }
});

// Setup Pusher for live real-time tracking updates
try {
  const pusher = new Pusher('<%= pusherKey %>', { cluster: '<%= pusherCluster %>' });
  const channel = pusher.subscribe('mhq-reseller');
  
  // Real-time order status update
  channel.bind('order:updated', (order) => {
    if (currentTrackedOrderId && (order.orderId === currentTrackedOrderId || order._id === currentTrackedOrderId)) {
      trackOrder();
    }
  });

  // Real-time courier CN assignment
  channel.bind('tracking:updated', (data) => {
    if (currentTrackedOrderId && data.orderId === currentTrackedOrderId) {
      trackOrder();
    }
  });
} catch(e) {
  console.warn('Real-time tracking listener failed to initialize', e);
}
</script>