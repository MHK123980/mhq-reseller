<section class="min-h-screen py-24 px-4">
  <div class="max-w-2xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-10">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-amber-500/10 border border-amber-500/20 mb-5">
        <svg class="w-8 h-8 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3 font-serif">Track Your <span class="text-amber-400">Order</span></h1>
      <p class="text-zinc-400 text-sm leading-relaxed">Enter your Order ID to check delivery status and courier tracking information</p>
    </div>

    <!-- Search Box -->
    <div class="bg-zinc-900/60 border border-zinc-800 rounded-2xl p-6 mb-6 backdrop-blur-sm">
      <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-3">Order ID</label>
      <div class="flex gap-3">
        <input id="order-id-input" type="text" placeholder="e.g. EA101" 
          class="flex-1 bg-zinc-800/80 border border-zinc-700 focus:border-amber-500 text-white placeholder-zinc-600 rounded-xl px-4 py-3 text-sm outline-none transition-colors"
          onkeydown="if(event.key==='Enter') trackOrder()" />
        <button onclick="trackOrder()" class="btn-gold px-6 py-3 text-sm flex items-center gap-2 flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          Track
        </button>
      </div>
    </div>

    <!-- Result -->
    <div id="track-result"></div>
  </div>
</section>

<style>
  .status-step { position: relative; }
  .status-step::before { content: ''; position: absolute; left: 15px; top: 32px; bottom: -16px; width: 2px; background: #27272a; }
  .status-step:last-child::before { display: none; }
  .status-step.done::before { background: linear-gradient(to bottom, #d97706, #27272a); }
  .status-step.active-step::before { background: #27272a; }
</style>

<script>
const statusOrder = ['Pending','Packed','Ready to Ship','On Route','Out for Delivery','Delivered'];
const statusIcons = {
  'Pending': '🕐',
  'Packed': '📦',
  'Ready to Ship': '📋',
  'On Route': '🚚',
  'Out for Delivery': '🏃',
  'Delivered': '✅',
  'Canceled': '❌'
};
const courierLinks = {
  'TCS': 'https://www.tcsexpress.com/track/',
  'PostEx': 'https://postex.pk/tracking',
  'Leopard': 'https://www.leopardscourier.com/leopards_tracking/',
  'M&B': 'https://www.mnbcourier.pk/track/',
};

async function trackOrder() {
  const orderId = document.getElementById('order-id-input').value.trim().toUpperCase();
  const result = document.getElementById('track-result');
  if (!orderId) {
    result.innerHTML = '<div class="text-center text-zinc-500 py-6">Please enter your Order ID</div>';
    return;
  }
  result.innerHTML = '<div class="text-center py-10 flex flex-col items-center gap-3"><div class="w-8 h-8 border-2 border-amber-500/30 border-t-amber-500 rounded-full animate-spin"></div><p class="text-zinc-500 text-sm">Fetching order details…</p></div>';
  
  try {
    const res = await fetch(`/api/courier/${orderId}`);
    const data = await res.json();
    if (!data.success) {
      result.innerHTML = `<div class="bg-red-900/20 border border-red-500/30 rounded-2xl p-6 text-center"><div class="text-3xl mb-3">❌</div><p class="text-red-400 font-semibold">${data.message || 'Order not found'}</p><p class="text-zinc-500 text-sm mt-2">Please double-check your Order ID and try again</p></div>`;
      return;
    }
    
    const { order, tracking } = data;
    const currentStatusIdx = statusOrder.indexOf(order.status);
    const isCanceled = order.status === 'Canceled';
    
    const stepsHtml = isCanceled ? 
      `<div class="bg-red-900/20 border border-red-500/30 rounded-xl p-4 text-center"><p class="text-red-400 font-semibold">❌ Order Canceled</p></div>` :
      statusOrder.map((s, i) => {
        const done = i < currentStatusIdx;
        const active = i === currentStatusIdx;
        return `<div class="status-step ${done ? 'done' : ''} ${active ? 'active-step' : ''} flex items-center gap-4 pb-4">
          <div class="w-8 h-8 rounded-full flex-shrink-0 flex items-center justify-center text-sm ${active ? 'bg-amber-500 text-black shadow-lg shadow-amber-500/30' : done ? 'bg-amber-900/50 border border-amber-700/50 text-amber-600' : 'bg-zinc-800 border border-zinc-700 text-zinc-600'} font-bold">
            ${done ? '✓' : active ? statusIcons[s] || '●' : '○'}
          </div>
          <div>
            <p class="text-sm font-semibold ${active ? 'text-amber-400' : done ? 'text-zinc-400' : 'text-zinc-600'}">${s}</p>
            ${active ? '<p class="text-xs text-amber-500/70 mt-0.5">Current Status</p>' : ''}
          </div>
        </div>`;
      }).join('');

    const courierHtml = tracking ? (() => {
      const companyName = tracking.courierCompany === 'Other' ? (tracking.courierName || 'Other') : tracking.courierCompany;
      const trackUrl = courierLinks[tracking.courierCompany];
      return `<div class="bg-zinc-900/60 border border-zinc-700/60 rounded-2xl p-5">
        <div class="flex items-center gap-2 mb-3">
          <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
          <h3 class="text-sm font-semibold text-white">Courier Information</h3>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="bg-zinc-800/60 rounded-xl p-3">
            <p class="text-xs text-zinc-500 mb-1">Courier Company</p>
            <p class="text-white font-semibold text-sm">${companyName}</p>
          </div>
          <div class="bg-zinc-800/60 rounded-xl p-3">
            <p class="text-xs text-zinc-500 mb-1">Tracking Number</p>
            <p class="text-amber-400 font-bold text-sm font-mono">${tracking.trackingNumber}</p>
          </div>
        </div>
        ${trackUrl ? `<a href="${trackUrl}${tracking.trackingNumber}" target="_blank" class="mt-3 btn-gold flex items-center justify-center gap-2 py-2.5 text-sm w-full rounded-xl">Track on ${companyName} Website <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg></a>` : ''}
      </div>`;
    })() : `<div class="bg-zinc-900/40 border border-zinc-800 rounded-2xl p-5 text-center">
      <p class="text-zinc-500 text-sm">📦 Courier Tracking No: <span class="text-amber-400 font-semibold">CN Will Be Provided Soon</span></p>
    </div>`;

    const productsHtml = order.products && order.products.length ? order.products.map(p => `
      <div class="flex items-center gap-3 py-2 border-b border-zinc-800/60 last:border-0">
        ${p.product && p.product.images && p.product.images.length ? `<img src="${p.product.images[0]}" class="w-10 h-10 rounded-lg object-cover flex-shrink-0 border border-zinc-700" />` : '<div class="w-10 h-10 rounded-lg bg-zinc-800 flex-shrink-0"></div>'}
        <div class="flex-1 min-w-0">
          <p class="text-white text-xs font-medium truncate">${p.product ? p.product.name : 'Product'}</p>
          ${p.selectedVariant ? `<p class="text-zinc-500 text-xs">${p.selectedVariant}</p>` : ''}
        </div>
        <div class="text-right flex-shrink-0">
          <p class="text-zinc-400 text-xs">×${p.quantity}</p>
          <p class="text-amber-400 text-xs font-semibold">Rs ${p.priceAtPurchase * p.quantity}</p>
        </div>
      </div>`).join('') : '';

    result.innerHTML = `
      <div class="space-y-4">
        <!-- Order Header -->
        <div class="bg-zinc-900/60 border border-zinc-800 rounded-2xl p-5 backdrop-blur-sm">
          <div class="flex items-center justify-between mb-4">
            <div>
              <p class="text-xs text-zinc-500 uppercase tracking-widest mb-1">Order ID</p>
              <p class="text-amber-400 font-black text-xl font-mono">${order.orderId}</p>
            </div>
            <div class="text-right">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-bold ${isCanceled ? 'bg-red-900/40 text-red-400 border border-red-700/40' : order.status === 'Delivered' ? 'bg-green-900/40 text-green-400 border border-green-700/40' : 'bg-amber-900/40 text-amber-400 border border-amber-700/40'}">${statusIcons[order.status] || ''} ${order.status}</span>
              <p class="text-zinc-600 text-xs mt-1">Rs ${order.totalAmount.toLocaleString()}</p>
            </div>
          </div>
          <div class="text-xs text-zinc-500">Ordered: ${new Date(order.createdAt).toLocaleDateString('en-PK', { year:'numeric', month:'long', day:'numeric' })}</div>
        </div>

        <!-- Order Status Steps -->
        <div class="bg-zinc-900/60 border border-zinc-800 rounded-2xl p-5 backdrop-blur-sm">
          <h3 class="text-sm font-semibold text-white mb-4">Order Progress</h3>
          ${stepsHtml}
        </div>

        <!-- Courier Info -->
        ${courierHtml}

        <!-- Products -->
        <div class="bg-zinc-900/60 border border-zinc-800 rounded-2xl p-5 backdrop-blur-sm">
          <h3 class="text-sm font-semibold text-white mb-3">Items Ordered</h3>
          ${productsHtml}
          <div class="flex justify-between items-center pt-3 border-t border-zinc-800 mt-2">
            <span class="text-zinc-500 text-sm">Total</span>
            <span class="text-amber-400 font-bold">Rs ${order.totalAmount.toLocaleString()}</span>
          </div>
        </div>
      </div>`;
  } catch(err) {
    result.innerHTML = '<div class="bg-red-900/20 border border-red-500/30 rounded-2xl p-6 text-center"><p class="text-red-400">Something went wrong. Please try again.</p></div>';
  }
}

// Auto track if ?id= parameter is present
window.addEventListener('DOMContentLoaded', () => {
  const urlParams = new URLSearchParams(window.location.search);
  const qId = urlParams.get('id');
  if (qId) {
    document.getElementById('order-id-input').value = qId;
    trackOrder();
  }
});
</script>