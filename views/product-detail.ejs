<%
const finalPrice = product.hasDiscount && product.discountPercent > 0
  ? (product.price - (product.price * product.discountPercent / 100)).toFixed(0)
  : product.price;
%>

<section class="py-24 px-4 max-w-6xl mx-auto">
  <a href="/products" class="inline-flex items-center gap-2 text-zinc-400 hover:text-amber-400 transition-colors mb-8 text-sm">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    Back to Products
  </a>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
    <!-- Images -->
    <div class="space-y-3">
      <div class="relative aspect-square bg-zinc-900 rounded-2xl overflow-hidden border border-zinc-700">
        <% if (product.images && product.images.length > 0) { %>
        <img id="main-img" src="<%= product.images[0] %>" alt="<%= product.name %>" class="w-full h-full object-cover"/>
        <% } else { %>
        <div class="w-full h-full flex items-center justify-center text-zinc-600">
          <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
        <% } %>
        <% if (product.hasDiscount && product.discountPercent > 0) { %>
        <div class="absolute top-4 right-4 bg-amber-500 text-black font-bold px-3 py-1 rounded-full text-sm"><%= product.discountPercent %>% OFF</div>
        <% } %>
        <% if (product.isFeatured) { %>
        <div class="absolute top-4 left-4 bg-amber-500 text-black font-bold px-3 py-1 rounded-full text-xs">⭐ Featured</div>
        <% } %>
      </div>
      <!-- Thumbnails -->
      <% if (product.images && product.images.length > 1) { %>
      <div class="flex gap-2 overflow-x-auto pb-1">
        <% product.images.forEach((img, idx) => { %>
        <img src="<%= img %>" alt="Image <%= idx+1 %>" onclick="document.getElementById('main-img').src='<%= img %>'"
          class="w-20 h-20 object-cover rounded-xl border border-zinc-700 hover:border-amber-500 cursor-pointer transition-all flex-shrink-0"/>
        <% }) %>
      </div>
      <% } %>
    </div>

    <!-- Product Info -->
    <div class="flex flex-col">
      <p class="text-amber-500 text-sm font-medium mb-2"><%= product.category ? product.category.name : 'Uncategorized' %></p>
      <h1 class="text-2xl md:text-3xl font-bold text-white mb-4 leading-tight"><%= product.name %></h1>

      <!-- Price -->
      <div class="flex items-end gap-3 mb-4">
        <span class="text-3xl font-black text-amber-400">Rs <%= finalPrice %></span>
        <% if (product.hasDiscount && product.discountPercent > 0) { %>
        <span class="text-zinc-500 line-through text-lg">Rs <%= product.price %></span>
        <span class="text-green-400 text-sm font-semibold">Save Rs <%= (product.price - finalPrice).toFixed(0) %></span>
        <% } %>
      </div>

      <!-- Badges -->
      <div class="flex flex-wrap gap-2 mb-5">
        <% if (product.isOutOfStock) { %>
        <span class="bg-red-900/40 border border-red-500/40 text-red-400 text-xs px-3 py-1 rounded-full font-medium">Out of Stock</span>
        <% } else if (product.isLowInStock) { %>
        <span class="bg-orange-900/40 border border-orange-500/40 text-orange-400 text-xs px-3 py-1 rounded-full font-medium">Low in Stock</span>
        <% } else { %>
        <span class="bg-green-900/40 border border-green-500/40 text-green-400 text-xs px-3 py-1 rounded-full font-medium">In Stock</span>
        <% } %>
        <% if (product.isFreeDelivery) { %>
        <span class="bg-emerald-900/40 border border-emerald-500/40 text-emerald-400 text-xs px-3 py-1 rounded-full font-medium">✓ Free Delivery</span>
        <% } else if (product.deliveryCharges > 0) { %>
        <span class="bg-zinc-800 border border-zinc-700 text-zinc-300 text-xs px-3 py-1 rounded-full font-medium">Delivery: Rs <%= product.deliveryCharges %></span>
        <% } %>
      </div>

      <!-- Description -->
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-4 mb-6">
        <h3 class="text-sm font-semibold text-zinc-400 mb-2">Description</h3>
        <p class="text-zinc-300 text-sm leading-relaxed"><%= product.description %></p>
      </div>

      <!-- Quantity + Add to Cart -->
      <div class="flex items-center gap-4 mb-4">
        <div class="flex items-center gap-2 bg-zinc-900 border border-zinc-700 rounded-full px-2 py-1">
          <button onclick="changeQty(-1)" class="w-8 h-8 rounded-full bg-zinc-800 hover:bg-zinc-700 text-white font-bold transition-colors flex items-center justify-center">-</button>
          <span id="qty-display" class="text-white font-semibold w-8 text-center">1</span>
          <button onclick="changeQty(1)" class="w-8 h-8 rounded-full bg-zinc-800 hover:bg-zinc-700 text-white font-bold transition-colors flex items-center justify-center">+</button>
        </div>
        <button onclick="addToCart()" <%= product.isOutOfStock ? 'disabled' : '' %>
          class="flex-1 bg-amber-600 hover:bg-amber-500 disabled:opacity-50 disabled:cursor-not-allowed text-white font-semibold py-3 rounded-full transition-all text-sm">
          Add to Cart
        </button>
      </div>
      <a href="/cart" class="w-full border border-amber-600 hover:bg-amber-600/20 text-amber-400 font-semibold py-3 rounded-full transition-all text-sm text-center">
        View Cart & Checkout
      </a>
    </div>
  </div>
</section>

<div id="cart-toast" class="fixed bottom-6 right-6 bg-amber-600 text-white px-5 py-3 rounded-xl shadow-2xl font-medium text-sm z-50 translate-y-20 opacity-0 transition-all duration-300">✓ Added to cart!</div>

<script>
let qty = 1;
function changeQty(delta) {
  qty = Math.max(1, qty + delta);
  document.getElementById('qty-display').textContent = qty;
}
function addToCart() {
  const id = '<%= product._id %>';
  const name = '<%= product.name.replace(/'/g, "\\'") %>';
  const price = <%= finalPrice %>;
  const image = '<%= product.images && product.images.length ? product.images[0] : "" %>';
  const deliveryCharges = <%= product.deliveryCharges || 0 %>;
  const isFreeDelivery = <%= product.isFreeDelivery ? 'true' : 'false' %>;
  const cart = JSON.parse(localStorage.getItem('mhq_cart') || '[]');
  const existing = cart.find(i => i.id === id);
  if (existing) existing.quantity += qty;
  else cart.push({ id, name, price, image, quantity: qty, deliveryCharges, isFreeDelivery });
  localStorage.setItem('mhq_cart', JSON.stringify(cart));
  updateCartCount();
  const toast = document.getElementById('cart-toast');
  toast.classList.remove('translate-y-20','opacity-0'); toast.classList.add('translate-y-0','opacity-100');
  setTimeout(() => { toast.classList.add('translate-y-20','opacity-0'); toast.classList.remove('translate-y-0','opacity-100'); }, 2000);
}
</script>
