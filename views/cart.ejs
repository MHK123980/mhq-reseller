<section class="py-24 px-4 max-w-7xl mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <!-- Cart Items -->
    <div class="lg:col-span-2">
      <h1 class="text-2xl md:text-3xl font-bold text-white mb-6">Shopping <span class="text-amber-400">Cart</span></h1>

      <div id="cart-empty" class="hidden text-center py-20 bg-zinc-900/40 rounded-3xl border border-zinc-800">
        <svg class="w-16 h-16 text-zinc-700 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        <p class="text-zinc-400 text-base mb-4 font-medium">Your cart is currently empty</p>
        <a href="/products" class="bg-amber-600 hover:bg-amber-500 text-white px-6 py-3 rounded-full transition-all font-semibold text-xs inline-block shadow-lg shadow-amber-600/30">Browse Products</a>
      </div>

      <div id="cart-items" class="space-y-4"></div>
    </div>

    <!-- Order Summary + Proceed to Checkout -->
    <div id="checkout-panel" class="hidden">
      <div class="bg-zinc-900 border border-zinc-700 rounded-3xl p-6 sticky top-24 shadow-2xl">
        <h2 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          Cart Summary
        </h2>
        <div class="space-y-3 text-sm mb-6">
          <div class="flex justify-between text-zinc-400">
            <span>Items Subtotal</span>
            <span id="summary-subtotal" class="text-white font-semibold">Rs 0</span>
          </div>
          <div class="flex justify-between text-zinc-400">
            <span>Estimated Delivery</span>
            <span id="summary-delivery" class="text-white font-semibold">Rs 0</span>
          </div>
          <div class="border-t border-zinc-800 pt-3 flex justify-between text-white font-bold text-base">
            <span>Subtotal</span>
            <span id="summary-total" class="text-amber-400 font-black text-lg">Rs 0</span>
          </div>
          <p class="text-zinc-500 text-[11px] leading-tight">Sales tax and payment options will be selected on the dedicated checkout page.</p>
        </div>

        <a href="/checkout" class="block w-full text-center bg-amber-600 hover:bg-amber-500 text-white font-bold py-3.5 rounded-full transition-all text-sm shadow-xl shadow-amber-600/30 hover:scale-[1.01] active:scale-[0.99]">
          Proceed to Checkout →
        </a>

        <div class="mt-4 pt-4 border-t border-zinc-800 flex items-center justify-center gap-2 text-zinc-500 text-xs">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          <span>Safe & Secure Checkout</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
function renderCart() {
  const cart = JSON.parse(localStorage.getItem('mhq_cart') || '[]');
  const container = document.getElementById('cart-items');
  const emptyEl = document.getElementById('cart-empty');
  const checkoutPanel = document.getElementById('checkout-panel');
  container.innerHTML = '';

  if (cart.length === 0) {
    emptyEl.classList.remove('hidden');
    checkoutPanel.classList.add('hidden');
    return;
  }
  emptyEl.classList.add('hidden');
  checkoutPanel.classList.remove('hidden');

  let subtotal = 0;
  let totalDelivery = 0;

  cart.forEach((item, idx) => {
    subtotal += item.price * item.quantity;
    if (!item.isFreeDelivery && item.deliveryCharges > 0) {
      totalDelivery += item.deliveryCharges;
    }

    const origP = item.originalPrice || item.price;
    const hasDisc = (origP > item.price);

    container.insertAdjacentHTML('beforeend', `
      <div class="bg-zinc-900 border border-zinc-700/80 rounded-2xl p-4 flex gap-4 items-start shadow-xl">
        ${item.image ? `<img src="${item.image}" alt="${item.name}" class="w-20 h-20 object-cover rounded-xl flex-shrink-0 bg-zinc-800 border border-zinc-700"/>` : `<div class="w-20 h-20 bg-zinc-800 rounded-xl flex-shrink-0"></div>`}
        <div class="flex-1 min-w-0">
          <h3 class="text-white font-semibold text-sm line-clamp-2 mb-1">${item.name}</h3>
          ${item.selectedVariant ? `<p class="text-amber-500 text-xs font-medium mb-1">${item.selectedVariant}</p>` : ''}
          <div class="my-1">
            ${hasDisc ? `<p class="text-zinc-500 text-xs line-through leading-tight">Rs ${Number(origP).toLocaleString()}</p>` : ''}
            <p class="text-amber-400 font-bold text-sm leading-tight">Rs ${Number(item.price).toLocaleString()}</p>
          </div>
          ${item.isFreeDelivery ? '<p class="text-emerald-400 text-xs font-medium mt-0.5">✓ Free Delivery</p>' : item.deliveryCharges > 0 ? `<p class="text-zinc-500 text-xs mt-0.5">Delivery: Rs ${item.deliveryCharges}</p>` : ''}
          ${item.closeCOD ? '<span class="inline-block mt-1 text-[10px] text-amber-400 font-semibold bg-amber-500/10 border border-amber-500/30 px-2 py-0.5 rounded-full">Advance Payment Only</span>' : ''}
          
          <div class="flex items-center gap-2 mt-3">
            <button onclick="changeQty(${idx}, -1)" class="w-7 h-7 bg-zinc-800 hover:bg-zinc-700 rounded-full text-white font-bold transition-colors flex items-center justify-center text-sm">-</button>
            <span class="text-white font-semibold w-6 text-center text-sm">${item.quantity}</span>
            <button onclick="changeQty(${idx}, 1)" class="w-7 h-7 bg-zinc-800 hover:bg-zinc-700 rounded-full text-white font-bold transition-colors flex items-center justify-center text-sm">+</button>
          </div>
        </div>
        <div class="text-right flex-shrink-0">
          ${hasDisc ? `<p class="text-zinc-500 text-xs line-through leading-tight">Rs ${(origP * item.quantity).toLocaleString()}</p>` : ''}
          <p class="text-white font-bold text-sm">Rs ${(item.price * item.quantity).toLocaleString()}</p>
          <button onclick="removeItem(${idx})" class="mt-3 text-red-400 hover:text-red-300 transition-colors text-xs font-medium">Remove</button>
        </div>
      </div>`);
  });

  document.getElementById('summary-subtotal').textContent = 'Rs ' + subtotal.toLocaleString();
  document.getElementById('summary-delivery').textContent = totalDelivery === 0 ? 'Free' : 'Rs ' + totalDelivery.toLocaleString();
  document.getElementById('summary-total').textContent = 'Rs ' + (subtotal + totalDelivery).toLocaleString();
}

function changeQty(idx, delta) {
  const cart = JSON.parse(localStorage.getItem('mhq_cart') || '[]');
  cart[idx].quantity = Math.max(1, cart[idx].quantity + delta);
  localStorage.setItem('mhq_cart', JSON.stringify(cart));
  updateCartCount();
  renderCart();
}

function removeItem(idx) {
  const cart = JSON.parse(localStorage.getItem('mhq_cart') || '[]');
  cart.splice(idx, 1);
  localStorage.setItem('mhq_cart', JSON.stringify(cart));
  updateCartCount();
  renderCart();
}

renderCart();
</script>